{
  "$defs": {
    "GenerationControls": {
      "additionalProperties": false,
      "description": "Freeze every effective model-native generation parameter.",
      "properties": {
        "extra_parameters": {
          "additionalProperties": true,
          "title": "Extra Parameters",
          "type": "object"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "GenerationControls",
      "type": "object"
    },
    "LicenceCategory": {
      "description": "Freeze the model-weight licence category reported in metadata.",
      "enum": [
        "community_licence",
        "apache_2_0",
        "mit",
        "proprietary"
      ],
      "title": "LicenceCategory",
      "type": "string"
    },
    "ModelAccess": {
      "description": "Classify model access without treating it as a causal attribute.",
      "enum": [
        "open_weight",
        "closed"
      ],
      "title": "ModelAccess",
      "type": "string"
    },
    "ProviderSnapshot": {
      "additionalProperties": false,
      "description": "Bind a run to one frozen model, gateway, and routing-policy snapshot.",
      "properties": {
        "active_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Parameters"
        },
        "licence_category": {
          "$ref": "#/$defs/LicenceCategory"
        },
        "metadata_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Snapshot Sha256",
          "type": "string"
        },
        "model_access": {
          "$ref": "#/$defs/ModelAccess"
        },
        "model_slug": {
          "minLength": 3,
          "title": "Model Slug",
          "type": "string"
        },
        "preflight_passed": {
          "default": false,
          "title": "Preflight Passed",
          "type": "boolean"
        },
        "provider_endpoint": {
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "routing_policy": {
          "minLength": 1,
          "title": "Routing Policy",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Parameters"
        }
      },
      "required": [
        "model_slug",
        "model_access",
        "licence_category",
        "provider_name",
        "provider_endpoint",
        "routing_policy",
        "metadata_snapshot_sha256"
      ],
      "title": "ProviderSnapshot",
      "type": "object"
    },
    "ScenarioGenerationEstimate": {
      "additionalProperties": false,
      "description": "Record the conservative token and list-price calculation for generation.",
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimated_at": {
          "format": "date-time",
          "title": "Estimated At",
          "type": "string"
        },
        "estimated_max_cost": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Max Cost"
        },
        "input_price_per_million": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Price Per Million"
        },
        "input_token_estimate": {
          "minimum": 1,
          "title": "Input Token Estimate",
          "type": "integer"
        },
        "model_slug": {
          "title": "Model Slug",
          "type": "string"
        },
        "output_price_per_million": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Price Per Million"
        },
        "output_token_ceiling": {
          "minimum": 1,
          "title": "Output Token Ceiling",
          "type": "integer"
        },
        "output_token_ceiling_per_request": {
          "minimum": 1,
          "title": "Output Token Ceiling Per Request",
          "type": "integer"
        },
        "preflight_cost_allowance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Preflight Cost Allowance"
        },
        "price_source_url": {
          "title": "Price Source Url",
          "type": "string"
        },
        "provider_name": {
          "title": "Provider Name",
          "type": "string"
        },
        "request_batch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Batch Sha256",
          "type": "string"
        },
        "request_count": {
          "minimum": 1,
          "title": "Request Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request_batch_sha256",
        "request_count",
        "model_slug",
        "provider_name",
        "input_token_estimate",
        "output_token_ceiling_per_request",
        "output_token_ceiling",
        "input_price_per_million",
        "output_price_per_million",
        "preflight_cost_allowance",
        "estimated_max_cost",
        "price_source_url",
        "estimated_at"
      ],
      "title": "ScenarioGenerationEstimate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze the approved batch, route, controls, pricing, and run identity.",
  "properties": {
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "candidate_model": {
      "$ref": "#/$defs/ProviderSnapshot"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "estimate": {
      "$ref": "#/$defs/ScenarioGenerationEstimate"
    },
    "generation_controls": {
      "$ref": "#/$defs/GenerationControls"
    },
    "generation_request_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation Request Batch Sha256",
      "type": "string"
    },
    "request_count": {
      "minimum": 1,
      "title": "Request Count",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow": {
      "const": "scenario_fact_generation_v1",
      "default": "scenario_fact_generation_v1",
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "generation_request_batch_sha256",
    "request_count",
    "approval_sha256",
    "candidate_model",
    "generation_controls",
    "estimate",
    "created_at",
    "config_sha256"
  ],
  "title": "ScenarioGenerationConfig",
  "type": "object"
}
