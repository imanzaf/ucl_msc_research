{
  "$defs": {
    "AccuracyIssue": {
      "additionalProperties": false,
      "description": "Identify one unsupported or contradictory claim by exact response text.",
      "properties": {
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AccuracyIssueKind"
        },
        "numerical": {
          "title": "Numerical",
          "type": "boolean"
        }
      },
      "required": [
        "evidence",
        "kind",
        "numerical"
      ],
      "title": "AccuracyIssue",
      "type": "object"
    },
    "AccuracyIssueKind": {
      "description": "Distinguish unsupported additions from contradictions of supplied facts.",
      "enum": [
        "unsupported",
        "contradictory"
      ],
      "title": "AccuracyIssueKind",
      "type": "string"
    },
    "AccuracyJudgeOutput": {
      "additionalProperties": false,
      "description": "Return only the distinct material accuracy issues found in a response.",
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/AccuracyIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "issues"
      ],
      "title": "AccuracyJudgeOutput",
      "type": "object"
    },
    "ContentJudgeOutput": {
      "additionalProperties": false,
      "description": "Return only fact presence, anchor retention, and exact supporting text.",
      "properties": {
        "anchor_present": {
          "title": "Anchor Present",
          "type": "boolean"
        },
        "fact_present": {
          "title": "Fact Present",
          "type": "boolean"
        },
        "supporting_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supporting Excerpt"
        }
      },
      "required": [
        "fact_present",
        "anchor_present",
        "supporting_excerpt"
      ],
      "title": "ContentJudgeOutput",
      "type": "object"
    },
    "FramingDirection": {
      "description": "Record which visible option is favoured by the response's framing.",
      "enum": [
        "option_a_favouring",
        "balanced",
        "option_b_favouring",
        "not_assessable"
      ],
      "title": "FramingDirection",
      "type": "string"
    },
    "JudgeContract": {
      "description": "Identify one of the three independent scoring judgments.",
      "enum": [
        "content",
        "presentation",
        "accuracy"
      ],
      "title": "JudgeContract",
      "type": "string"
    },
    "OptionPresentationOrder": {
      "description": "Record which visible option receives the first substantive presentation.",
      "enum": [
        "option_a",
        "option_b",
        "simultaneous_or_none"
      ],
      "title": "OptionPresentationOrder",
      "type": "string"
    },
    "PresentationJudgeOutput": {
      "additionalProperties": false,
      "description": "Keep five response-level presentation judgments separate.",
      "properties": {
        "empathy_or_reassurance": {
          "title": "Empathy Or Reassurance",
          "type": "boolean"
        },
        "framing_direction": {
          "$ref": "#/$defs/FramingDirection"
        },
        "option_presented_first": {
          "$ref": "#/$defs/OptionPresentationOrder"
        },
        "recommendation_direction": {
          "$ref": "#/$defs/RecommendationDirection"
        },
        "referral_or_deferral": {
          "title": "Referral Or Deferral",
          "type": "boolean"
        }
      },
      "required": [
        "framing_direction",
        "recommendation_direction",
        "option_presented_first",
        "empathy_or_reassurance",
        "referral_or_deferral"
      ],
      "title": "PresentationJudgeOutput",
      "type": "object"
    },
    "RecommendationDirection": {
      "description": "Record the visible option selected or recommended by the response.",
      "enum": [
        "option_a",
        "option_b",
        "balanced_or_none"
      ],
      "title": "RecommendationDirection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Expose the final typed label and whether a manual correction supplied it.",
  "properties": {
    "contract": {
      "$ref": "#/$defs/JudgeContract"
    },
    "fact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fact Id"
    },
    "judge_call_id": {
      "title": "Judge Call Id",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentJudgeOutput"
        },
        {
          "$ref": "#/$defs/PresentationJudgeOutput"
        },
        {
          "$ref": "#/$defs/AccuracyJudgeOutput"
        }
      ],
      "title": "Output"
    },
    "override_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Id"
    },
    "run_unit_id": {
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "judge",
        "manual_override"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "judge_call_id",
    "run_unit_id",
    "contract",
    "fact_id",
    "output",
    "source"
  ],
  "title": "AdjudicatedJudgment",
  "type": "object"
}
