{
  "additionalProperties": false,
  "description": "Freeze one experiment's stratified five-percent judge-development sample.",
  "properties": {
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "response_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Response Ids",
      "type": "array"
    },
    "sample_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_response_count": {
      "minimum": 1,
      "title": "Source Response Count",
      "type": "integer"
    }
  },
  "required": [
    "source_response_count",
    "response_ids",
    "random_seed",
    "sample_sha256"
  ],
  "title": "JudgePilotSample",
  "type": "object"
}
