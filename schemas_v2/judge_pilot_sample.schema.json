{
  "additionalProperties": false,
  "description": "Freeze the stratified five-percent response sample used to develop prompts.",
  "properties": {
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "response_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 191,
      "minItems": 191,
      "title": "Response Ids",
      "type": "array"
    },
    "sample_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_response_count": {
      "const": 3822,
      "default": 3822,
      "title": "Source Response Count",
      "type": "integer"
    }
  },
  "required": [
    "response_ids",
    "random_seed",
    "sample_sha256"
  ],
  "title": "JudgePilotSample",
  "type": "object"
}
