{
  "$defs": {
    "ExactFactBudget": {
      "description": "Represent the exact structured fact-selection budgets.",
      "enum": [
        2,
        4,
        6
      ],
      "title": "ExactFactBudget",
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "Record a usable exact-budget selection without changing raw format adherence.",
  "properties": {
    "expected_fact_count": {
      "$ref": "#/$defs/ExactFactBudget"
    },
    "format_adherent": {
      "title": "Format Adherent",
      "type": "boolean"
    },
    "raw_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Response Sha256",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "run_unit_id": {
      "minLength": 16,
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_fact_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Fact Ids"
    },
    "selection_usable": {
      "title": "Selection Usable",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "strict_json",
        "fenced_json",
        "unusable"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "run_unit_id",
    "expected_fact_count",
    "source",
    "format_adherent",
    "selection_usable",
    "raw_response_sha256"
  ],
  "title": "SelectionRecoveryRecord",
  "type": "object"
}
