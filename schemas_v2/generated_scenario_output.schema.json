{
  "$defs": {
    "GeneratedFact": {
      "additionalProperties": false,
      "description": "Represent one direction-free visible fact returned by the generator.",
      "properties": {
        "anchor": {
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^[A-Z0-9_]+_F[1-6]$",
          "title": "Fact Id",
          "type": "string"
        },
        "option_id": {
          "pattern": "^OPTION_[AB]$",
          "title": "Option Id",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^[A-Z0-9_]+_P[1-3]$",
          "title": "Pair Id",
          "type": "string"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "option_id",
        "text",
        "anchor"
      ],
      "title": "GeneratedFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent the generator's single semantic output for one scenario.",
  "properties": {
    "facts": {
      "items": {
        "$ref": "#/$defs/GeneratedFact"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Facts",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[A-Z]{2,3}[0-9]{3}_R[1-5]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "facts"
  ],
  "title": "GeneratedScenarioOutput",
  "type": "object"
}
