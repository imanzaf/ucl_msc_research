{
  "$defs": {
    "ExperimentKind": {
      "description": "Identify one final-protocol experiment.",
      "enum": [
        "user_state_adaptation_v2",
        "information_budget_v1",
        "word_budget_external_validity_v1",
        "single_fact_priority_v1",
        "ownership_role_control_v1",
        "option_first_v1",
        "commercial_interest_instruction_v1",
        "balanced_prominence_mitigation_v1"
      ],
      "title": "ExperimentKind",
      "type": "string"
    },
    "GenerationControls": {
      "additionalProperties": false,
      "description": "Freeze every effective model-native generation parameter.",
      "properties": {
        "extra_parameters": {
          "additionalProperties": true,
          "title": "Extra Parameters",
          "type": "object"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "GenerationControls",
      "type": "object"
    },
    "LicenceCategory": {
      "description": "Freeze the model-weight licence category reported in metadata.",
      "enum": [
        "community_licence",
        "apache_2_0",
        "mit",
        "proprietary"
      ],
      "title": "LicenceCategory",
      "type": "string"
    },
    "ModelAccess": {
      "description": "Classify model access without treating it as a causal attribute.",
      "enum": [
        "open_weight",
        "closed"
      ],
      "title": "ModelAccess",
      "type": "string"
    },
    "ProviderSnapshot": {
      "additionalProperties": false,
      "description": "Bind a run to one frozen model, gateway, and routing-policy snapshot.",
      "properties": {
        "active_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Parameters"
        },
        "licence_category": {
          "$ref": "#/$defs/LicenceCategory"
        },
        "metadata_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Snapshot Sha256",
          "type": "string"
        },
        "model_access": {
          "$ref": "#/$defs/ModelAccess"
        },
        "model_slug": {
          "minLength": 3,
          "title": "Model Slug",
          "type": "string"
        },
        "preflight_passed": {
          "default": false,
          "title": "Preflight Passed",
          "type": "boolean"
        },
        "provider_endpoint": {
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "routing_policy": {
          "minLength": 1,
          "title": "Routing Policy",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Parameters"
        }
      },
      "required": [
        "model_slug",
        "model_access",
        "licence_category",
        "provider_name",
        "provider_endpoint",
        "routing_policy",
        "metadata_snapshot_sha256"
      ],
      "title": "ProviderSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze the active experiments, models, controls, corpus, and expected count.",
  "properties": {
    "evaluated_models": {
      "items": {
        "$ref": "#/$defs/ProviderSnapshot"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Evaluated Models",
      "type": "array"
    },
    "expected_response_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/ExperimentKind"
      },
      "title": "Expected Response Counts",
      "type": "object"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentKind"
      },
      "title": "Experiments",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "generation_controls": {
      "additionalProperties": {
        "$ref": "#/$defs/GenerationControls"
      },
      "title": "Generation Controls",
      "type": "object"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "protocol_id": {
      "default": "final_protocol",
      "pattern": "^final_protocol$",
      "title": "Protocol Id",
      "type": "string"
    },
    "scenario_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scorer_model": {
      "$ref": "#/$defs/ProviderSnapshot"
    }
  },
  "required": [
    "scenario_manifest_sha256",
    "experiments",
    "expected_response_counts",
    "evaluated_models",
    "scorer_model",
    "generation_controls",
    "frozen_at",
    "manifest_sha256"
  ],
  "title": "ProtocolManifest",
  "type": "object"
}
