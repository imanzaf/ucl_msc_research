{
  "$defs": {
    "GenerationControls": {
      "additionalProperties": false,
      "description": "Freeze every effective model-native generation parameter.",
      "properties": {
        "extra_parameters": {
          "additionalProperties": true,
          "title": "Extra Parameters",
          "type": "object"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "GenerationControls",
      "type": "object"
    },
    "JudgeContract": {
      "description": "Identify one of the three independent scoring judgments.",
      "enum": [
        "content",
        "presentation",
        "accuracy"
      ],
      "title": "JudgeContract",
      "type": "string"
    },
    "LicenceCategory": {
      "description": "Freeze the model-weight licence category reported in metadata.",
      "enum": [
        "community_licence",
        "apache_2_0",
        "mit",
        "proprietary"
      ],
      "title": "LicenceCategory",
      "type": "string"
    },
    "ModelAccess": {
      "description": "Classify model access without treating it as a causal attribute.",
      "enum": [
        "open_weight",
        "closed"
      ],
      "title": "ModelAccess",
      "type": "string"
    },
    "ProviderSnapshot": {
      "additionalProperties": false,
      "description": "Bind a run to one frozen model, gateway, and routing-policy snapshot.",
      "properties": {
        "active_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Parameters"
        },
        "licence_category": {
          "$ref": "#/$defs/LicenceCategory"
        },
        "metadata_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Snapshot Sha256",
          "type": "string"
        },
        "model_access": {
          "$ref": "#/$defs/ModelAccess"
        },
        "model_slug": {
          "minLength": 3,
          "title": "Model Slug",
          "type": "string"
        },
        "preflight_passed": {
          "default": false,
          "title": "Preflight Passed",
          "type": "boolean"
        },
        "provider_endpoint": {
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "routing_policy": {
          "minLength": 1,
          "title": "Routing Policy",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Parameters"
        }
      },
      "required": [
        "model_slug",
        "model_access",
        "licence_category",
        "provider_name",
        "provider_endpoint",
        "routing_policy",
        "metadata_snapshot_sha256"
      ],
      "title": "ProviderSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind all three reviewed prompts, controls, raw pilot calls, and adjudicated labels.",
  "properties": {
    "contract_sha256_by_judge": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/JudgeContract"
      },
      "title": "Contract Sha256 By Judge",
      "type": "object"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "frozen_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Frozen Contract Sha256",
      "type": "string"
    },
    "generation_controls": {
      "additionalProperties": {
        "$ref": "#/$defs/GenerationControls"
      },
      "propertyNames": {
        "$ref": "#/$defs/JudgeContract"
      },
      "title": "Generation Controls",
      "type": "object"
    },
    "judge_model": {
      "$ref": "#/$defs/ProviderSnapshot"
    },
    "pilot_adjudicated_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Adjudicated Sha256",
      "type": "string"
    },
    "pilot_results_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Results Sha256",
      "type": "string"
    },
    "pilot_sample_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Sample Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "const": "frozen",
      "default": "frozen",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "judge_model",
    "generation_controls",
    "contract_sha256_by_judge",
    "pilot_sample_sha256",
    "pilot_results_sha256",
    "pilot_adjudicated_sha256",
    "frozen_at",
    "frozen_contract_sha256"
  ],
  "title": "FrozenJudgeContract",
  "type": "object"
}
