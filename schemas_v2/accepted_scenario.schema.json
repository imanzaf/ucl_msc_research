{
  "$defs": {
    "CustomerValence": {
      "description": "Classify whether a fact is favourable or adverse for the customer.",
      "enum": [
        "customer_favourable",
        "customer_adverse"
      ],
      "title": "CustomerValence",
      "type": "string"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Describe the seed-owned role, task, and authority shown to evaluated models.",
      "properties": {
        "authority_limits": {
          "items": {
            "type": "string"
          },
          "title": "Authority Limits",
          "type": "array"
        },
        "entity_name": {
          "title": "Entity Name",
          "type": "string"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_name",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "FactDirection": {
      "description": "Classify whether a fact supports the owner or is countervailing.",
      "enum": [
        "owner_supporting",
        "countervailing"
      ],
      "title": "FactDirection",
      "type": "string"
    },
    "OwnershipEligibility": {
      "description": "Record whether employer ownership can vary without changing the options.",
      "enum": [
        "eligible",
        "ineligible"
      ],
      "title": "OwnershipEligibility",
      "type": "string"
    },
    "ReviewState": {
      "description": "Track the single researcher accept-or-revise scenario review.",
      "enum": [
        "pending",
        "accepted",
        "revise"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "ScenarioFact": {
      "additionalProperties": false,
      "description": "Store one visible fact and its hidden matched-pair metadata.",
      "properties": {
        "anchor": {
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "customer_valence": {
          "$ref": "#/$defs/CustomerValence"
        },
        "direction": {
          "$ref": "#/$defs/FactDirection"
        },
        "fact_id": {
          "pattern": "^[A-Z0-9_]+_F[1-6]$",
          "title": "Fact Id",
          "type": "string"
        },
        "institutional_benefit": {
          "minLength": 2,
          "title": "Institutional Benefit",
          "type": "string"
        },
        "materiality": {
          "minLength": 2,
          "title": "Materiality",
          "type": "string"
        },
        "option_id": {
          "pattern": "^OPTION_[AB]$",
          "title": "Option Id",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^[A-Z0-9_]+_P[1-3]$",
          "title": "Pair Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 2,
          "title": "Rationale",
          "type": "string"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "option_id",
        "text",
        "anchor",
        "direction",
        "customer_valence",
        "institutional_benefit",
        "materiality",
        "rationale"
      ],
      "title": "ScenarioFact",
      "type": "object"
    },
    "ScenarioOption": {
      "additionalProperties": false,
      "description": "Store a named fictional option visible to evaluated models.",
      "properties": {
        "institution_name": {
          "minLength": 2,
          "title": "Institution Name",
          "type": "string"
        },
        "option_id": {
          "pattern": "^OPTION_[AB]$",
          "title": "Option Id",
          "type": "string"
        },
        "product_name": {
          "minLength": 2,
          "title": "Product Name",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "institution_name",
        "product_name"
      ],
      "title": "ScenarioOption",
      "type": "object"
    },
    "ScenarioReview": {
      "additionalProperties": false,
      "description": "Record the one researcher accept-or-revise disposition.",
      "properties": {
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "researcher_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Researcher Id"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "state": {
          "$ref": "#/$defs/ReviewState",
          "default": "pending"
        }
      },
      "title": "ScenarioReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent one final accepted scenario with exactly three fact pairs.",
  "properties": {
    "decision_context": {
      "minLength": 2,
      "title": "Decision Context",
      "type": "string"
    },
    "deployment_context": {
      "$ref": "#/$defs/DeploymentContext"
    },
    "domain": {
      "minLength": 2,
      "title": "Domain",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ScenarioFact"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Facts",
      "type": "array"
    },
    "generated_output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generated Output Sha256",
      "type": "string"
    },
    "generation_request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation Request Sha256",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/ScenarioOption"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Options",
      "type": "array"
    },
    "owner_supporting_option": {
      "pattern": "^OPTION_[AB]$",
      "title": "Owner Supporting Option",
      "type": "string"
    },
    "ownership_eligibility": {
      "$ref": "#/$defs/OwnershipEligibility"
    },
    "presentation_order": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Presentation Order",
      "type": "array"
    },
    "query_stem": {
      "minLength": 2,
      "title": "Query Stem",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/ScenarioReview"
    },
    "scenario_id": {
      "pattern": "^[A-Z]{2,3}[0-9]{3}_R[1-5]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "10.0.0",
      "pattern": "^10\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "generation_request_sha256",
    "generated_output_sha256",
    "domain",
    "deployment_context",
    "decision_context",
    "query_stem",
    "options",
    "facts",
    "owner_supporting_option",
    "ownership_eligibility",
    "presentation_order"
  ],
  "title": "AcceptedScenario",
  "type": "object"
}
