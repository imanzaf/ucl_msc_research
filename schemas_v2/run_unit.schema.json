{
  "$defs": {
    "Affect": {
      "description": "Represent the allowed customer affect manipulation.",
      "enum": [
        "neutral",
        "anxious",
        "frustrated"
      ],
      "title": "Affect",
      "type": "string"
    },
    "AttemptMetadata": {
      "additionalProperties": false,
      "description": "Record one provider attempt without silently replacing semantic output.",
      "properties": {
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "semantic_response_received": {
          "default": false,
          "title": "Semantic Response Received",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "transport_failure": {
          "default": false,
          "title": "Transport Failure",
          "type": "boolean"
        }
      },
      "required": [
        "attempt_number",
        "started_at"
      ],
      "title": "AttemptMetadata",
      "type": "object"
    },
    "BalancedProminenceCell": {
      "additionalProperties": false,
      "description": "Define the implemented but deferred balanced-prominence task.",
      "properties": {
        "kind": {
          "const": "balanced_prominence_mitigation_v1",
          "default": "balanced_prominence_mitigation_v1",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "BalancedProminenceCell",
      "type": "object"
    },
    "ExactFactBudget": {
      "description": "Represent the exact structured fact-selection budgets.",
      "enum": [
        2,
        4,
        6
      ],
      "title": "ExactFactBudget",
      "type": "integer"
    },
    "ExperimentKind": {
      "description": "Identify one final-protocol experiment.",
      "enum": [
        "user_state_adaptation_v2",
        "information_budget_v1",
        "word_budget_external_validity_v1",
        "single_fact_priority_v1",
        "ownership_role_control_v1",
        "option_first_v1",
        "balanced_prominence_mitigation_v1"
      ],
      "title": "ExperimentKind",
      "type": "string"
    },
    "GenerationControls": {
      "additionalProperties": false,
      "description": "Freeze every effective model-native generation parameter.",
      "properties": {
        "extra_parameters": {
          "additionalProperties": true,
          "title": "Extra Parameters",
          "type": "object"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "GenerationControls",
      "type": "object"
    },
    "InformationBudgetCell": {
      "additionalProperties": false,
      "description": "Define one exact fact-count treatment cell.",
      "properties": {
        "affect": {
          "enum": [
            "neutral",
            "anxious"
          ],
          "title": "Affect",
          "type": "string"
        },
        "exact_fact_budget": {
          "$ref": "#/$defs/ExactFactBudget"
        },
        "kind": {
          "const": "information_budget_v1",
          "default": "information_budget_v1",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "affect",
        "exact_fact_budget"
      ],
      "title": "InformationBudgetCell",
      "type": "object"
    },
    "LicenceCategory": {
      "description": "Freeze the model-weight licence category reported in metadata.",
      "enum": [
        "community_licence",
        "apache_2_0",
        "mit",
        "proprietary"
      ],
      "title": "LicenceCategory",
      "type": "string"
    },
    "ModelAccess": {
      "description": "Classify model access without treating it as a causal attribute.",
      "enum": [
        "open_weight",
        "closed"
      ],
      "title": "ModelAccess",
      "type": "string"
    },
    "NaturalWordBudget": {
      "description": "Represent the natural-language external-validity response caps.",
      "enum": [
        40,
        80,
        160
      ],
      "title": "NaturalWordBudget",
      "type": "integer"
    },
    "OptionFirstCell": {
      "additionalProperties": false,
      "description": "Define the one-response option-choice task.",
      "properties": {
        "kind": {
          "const": "option_first_v1",
          "default": "option_first_v1",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "OptionFirstCell",
      "type": "object"
    },
    "OwnershipCell": {
      "additionalProperties": false,
      "description": "Define one ownership role and jointly counterbalanced rendering.",
      "properties": {
        "kind": {
          "const": "ownership_role_control_v1",
          "default": "ownership_role_control_v1",
          "title": "Kind",
          "type": "string"
        },
        "ownership_role": {
          "$ref": "#/$defs/OwnershipRole"
        },
        "rendering": {
          "enum": [
            1,
            2
          ],
          "title": "Rendering",
          "type": "integer"
        }
      },
      "required": [
        "ownership_role",
        "rendering"
      ],
      "title": "OwnershipCell",
      "type": "object"
    },
    "OwnershipRole": {
      "description": "Define the employer's relationship to the fixed option-A coordinate.",
      "enum": [
        "employer_owns_option_a",
        "employer_owns_option_b",
        "independent_adviser"
      ],
      "title": "OwnershipRole",
      "type": "string"
    },
    "ProviderSnapshot": {
      "additionalProperties": false,
      "description": "Bind a run to one frozen model, gateway, and routing-policy snapshot.",
      "properties": {
        "active_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Parameters"
        },
        "licence_category": {
          "$ref": "#/$defs/LicenceCategory"
        },
        "metadata_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Snapshot Sha256",
          "type": "string"
        },
        "model_access": {
          "$ref": "#/$defs/ModelAccess"
        },
        "model_slug": {
          "minLength": 3,
          "title": "Model Slug",
          "type": "string"
        },
        "preflight_passed": {
          "default": false,
          "title": "Preflight Passed",
          "type": "boolean"
        },
        "provider_endpoint": {
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "routing_policy": {
          "minLength": 1,
          "title": "Routing Policy",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Parameters"
        }
      },
      "required": [
        "model_slug",
        "model_access",
        "licence_category",
        "provider_name",
        "provider_endpoint",
        "routing_policy",
        "metadata_snapshot_sha256"
      ],
      "title": "ProviderSnapshot",
      "type": "object"
    },
    "QueryLength": {
      "description": "Represent semantically equivalent short and long query forms.",
      "enum": [
        "short",
        "long"
      ],
      "title": "QueryLength",
      "type": "string"
    },
    "ResponseMetadata": {
      "additionalProperties": false,
      "description": "Record immutable response text, adherence, token, cost, and truncation metadata.",
      "properties": {
        "adherent": {
          "title": "Adherent",
          "type": "boolean"
        },
        "answer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Text"
        },
        "billed_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billed Cost"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "raw_response": {
          "title": "Raw Response",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "selected_fact_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Fact Ids"
        },
        "structurally_valid": {
          "title": "Structurally Valid",
          "type": "boolean"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "raw_response",
        "structurally_valid",
        "adherent",
        "received_at"
      ],
      "title": "ResponseMetadata",
      "type": "object"
    },
    "SingleFactCell": {
      "additionalProperties": false,
      "description": "Define the natural single-most-important-fact task.",
      "properties": {
        "kind": {
          "const": "single_fact_priority_v1",
          "default": "single_fact_priority_v1",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "SingleFactCell",
      "type": "object"
    },
    "UserStateCell": {
      "additionalProperties": false,
      "description": "Define one affect and naturally authored query-length treatment cell.",
      "properties": {
        "affect": {
          "$ref": "#/$defs/Affect"
        },
        "kind": {
          "const": "user_state_adaptation_v2",
          "default": "user_state_adaptation_v2",
          "title": "Kind",
          "type": "string"
        },
        "query_length": {
          "$ref": "#/$defs/QueryLength"
        }
      },
      "required": [
        "affect",
        "query_length"
      ],
      "title": "UserStateCell",
      "type": "object"
    },
    "WordBudgetCell": {
      "additionalProperties": false,
      "description": "Define one neutral natural-language word-budget cell.",
      "properties": {
        "kind": {
          "const": "word_budget_external_validity_v1",
          "default": "word_budget_external_validity_v1",
          "title": "Kind",
          "type": "string"
        },
        "word_budget": {
          "$ref": "#/$defs/NaturalWordBudget"
        }
      },
      "required": [
        "word_budget"
      ],
      "title": "WordBudgetCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one experiment treatment, prompt, model snapshot, and response record.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptMetadata"
      },
      "title": "Attempts",
      "type": "array"
    },
    "cell": {
      "discriminator": {
        "mapping": {
          "balanced_prominence_mitigation_v1": "#/$defs/BalancedProminenceCell",
          "information_budget_v1": "#/$defs/InformationBudgetCell",
          "option_first_v1": "#/$defs/OptionFirstCell",
          "ownership_role_control_v1": "#/$defs/OwnershipCell",
          "single_fact_priority_v1": "#/$defs/SingleFactCell",
          "user_state_adaptation_v2": "#/$defs/UserStateCell",
          "word_budget_external_validity_v1": "#/$defs/WordBudgetCell"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UserStateCell"
        },
        {
          "$ref": "#/$defs/InformationBudgetCell"
        },
        {
          "$ref": "#/$defs/WordBudgetCell"
        },
        {
          "$ref": "#/$defs/SingleFactCell"
        },
        {
          "$ref": "#/$defs/OwnershipCell"
        },
        {
          "$ref": "#/$defs/OptionFirstCell"
        },
        {
          "$ref": "#/$defs/BalancedProminenceCell"
        }
      ],
      "title": "Cell"
    },
    "experiment": {
      "$ref": "#/$defs/ExperimentKind"
    },
    "generation_controls": {
      "$ref": "#/$defs/GenerationControls"
    },
    "model": {
      "$ref": "#/$defs/ProviderSnapshot"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "query_variant_id": {
      "minLength": 3,
      "title": "Query Variant Id",
      "type": "string"
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "response_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Contract Sha256",
      "type": "string"
    },
    "run_unit_id": {
      "minLength": 16,
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 3,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_unit_id",
    "experiment",
    "cell",
    "scenario_id",
    "query_variant_id",
    "prompt_sha256",
    "response_contract_sha256",
    "model",
    "generation_controls"
  ],
  "title": "RunUnit",
  "type": "object"
}
