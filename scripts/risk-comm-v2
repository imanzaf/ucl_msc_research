#!/usr/bin/env python3
"""Launch the isolated final-protocol CLI from a source checkout or installation."""

from __future__ import annotations

import sys
from pathlib import Path


def add_project_root() -> None:
    """Add the checkout containing the independent final-protocol package."""
    launcher_path = Path(__file__).resolve()
    candidates = [Path.cwd(), *launcher_path.parents[1:3]]
    project_root = next((candidate for candidate in candidates if (candidate / "srcv2" / "cli").is_dir()), None)
    if project_root is not None:
        sys.path.insert(0, str(project_root))


add_project_root()

from srcv2.cli import main  # noqa: E402


if __name__ == "__main__":
    main()
