{
  "$defs": {
    "ComparisonScope": {
      "description": "Identify whether both options belong to the provider or one is external.",
      "enum": [
        "intra_provider",
        "provider_vs_external"
      ],
      "title": "ComparisonScope",
      "type": "string"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "savings support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "retail bank",
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "ScenarioOptionDefinition": {
      "additionalProperties": false,
      "description": "Name one neutral decision option supplied to the fact generator.",
      "properties": {
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name"
      ],
      "title": "ScenarioOptionDefinition",
      "type": "object"
    },
    "ScenarioReplicationDefinition": {
      "additionalProperties": false,
      "description": "Define one calibration or held-out decision without customer queries.",
      "properties": {
        "comparison_scope": {
          "$ref": "#/$defs/ComparisonScope"
        },
        "decision_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Type",
          "type": "string"
        },
        "external_option_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeedOptionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ScenarioOptionDefinition"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "owner_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Benefit Mechanism",
          "type": "string"
        },
        "owner_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "presentation_order": {
          "items": {
            "$ref": "#/$defs/SeedOptionId"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Presentation Order",
          "type": "array"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "decision_type",
        "options",
        "owner_supporting_option",
        "owner_benefit_mechanism",
        "presentation_order",
        "comparison_scope",
        "external_option_id",
        "scenario_id"
      ],
      "title": "ScenarioReplicationDefinition",
      "type": "object"
    },
    "ScenarioUseCaseDefinition": {
      "additionalProperties": false,
      "description": "Represent one broad agent-task family with three distinct decisions.",
      "properties": {
        "deployment_context": {
          "$ref": "#/$defs/DeploymentContext"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/ScenarioReplicationDefinition"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Replications",
          "type": "array"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "deployment_context",
        "replications"
      ],
      "title": "ScenarioUseCaseDefinition",
      "type": "object"
    },
    "SeedOptionId": {
      "description": "Identify one neutrally labelled option in a generation seed.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SeedOptionId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Represent the complete active V3.0.0 scenario-definition document.",
  "properties": {
    "scenario_set_id": {
      "const": "customer_facing_risk_communication_v3.0.0",
      "title": "Scenario Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "use_cases": {
      "items": {
        "$ref": "#/$defs/ScenarioUseCaseDefinition"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Use Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_set_id",
    "use_cases"
  ],
  "title": "ScenarioSeedSet",
  "type": "object"
}
