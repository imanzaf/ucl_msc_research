{
  "$defs": {
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store the natural initial question and non-leading follow-up shown to the assistant.",
      "properties": {
        "follow_up_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Message",
          "type": "string"
        },
        "initial_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Initial Message",
          "type": "string"
        }
      },
      "required": [
        "initial_message",
        "follow_up_message"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "savings support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "SeedOptionId": {
      "description": "Identify one neutrally labelled option in a generation seed.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SeedOptionId",
      "type": "string"
    },
    "V10OptionDefinition": {
      "additionalProperties": false,
      "description": "Name one neutral decision option supplied to the fact generator.",
      "properties": {
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name"
      ],
      "title": "V10OptionDefinition",
      "type": "object"
    },
    "V10ReplicationSeed": {
      "additionalProperties": false,
      "description": "Define one calibration or held-out decision and its natural customer turns.",
      "properties": {
        "customer_messages": {
          "$ref": "#/$defs/CustomerMessages"
        },
        "customer_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "decision_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Type",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/V10OptionDefinition"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "owner_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Benefit Mechanism",
          "type": "string"
        },
        "owner_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "presentation_order": {
          "items": {
            "$ref": "#/$defs/SeedOptionId"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Presentation Order",
          "type": "array"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "decision_type",
        "options",
        "customer_supporting_option",
        "owner_supporting_option",
        "owner_benefit_mechanism",
        "presentation_order",
        "scenario_id",
        "customer_messages"
      ],
      "title": "V10ReplicationSeed",
      "type": "object"
    },
    "V10UseCaseSeed": {
      "additionalProperties": false,
      "description": "Represent one broad agent-task family with three distinct decisions.",
      "properties": {
        "deployment_context": {
          "$ref": "#/$defs/DeploymentContext"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/V10ReplicationSeed"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Replications",
          "type": "array"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "deployment_context",
        "replications"
      ],
      "title": "V10UseCaseSeed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent the complete active V0.10.0 seed document.",
  "properties": {
    "scenario_set_id": {
      "const": "customer_facing_risk_communication_v0.10.0",
      "title": "Scenario Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "use_cases": {
      "items": {
        "$ref": "#/$defs/V10UseCaseSeed"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Use Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_set_id",
    "use_cases"
  ],
  "title": "ScenarioSeedSet",
  "type": "object"
}
