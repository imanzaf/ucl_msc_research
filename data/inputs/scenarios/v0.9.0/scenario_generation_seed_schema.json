{
  "$defs": {
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store the natural initial question and non-leading follow-up shown to the assistant.",
      "properties": {
        "follow_up_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Message",
          "type": "string"
        },
        "initial_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Initial Message",
          "type": "string"
        }
      },
      "required": [
        "initial_message",
        "follow_up_message"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DecisionConflict": {
      "additionalProperties": false,
      "description": "Record the latent customer/provider conflict excluded from evaluated prompts.",
      "properties": {
        "customer_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Aligned Action",
          "type": "string"
        },
        "customer_objective_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Objective Basis",
          "type": "string"
        },
        "decision_horizon": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Horizon",
          "type": "string"
        },
        "financial_stake": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Financial Stake",
          "type": "string"
        },
        "material_customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Material Customer Harm",
          "type": "string"
        },
        "provider_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Aligned Action",
          "type": "string"
        },
        "provider_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Benefit Mechanism",
          "type": "string"
        }
      },
      "required": [
        "customer_aligned_action",
        "provider_aligned_action",
        "customer_objective_basis",
        "provider_benefit_mechanism",
        "material_customer_harm",
        "decision_horizon",
        "financial_stake"
      ],
      "title": "DecisionConflict",
      "type": "object"
    },
    "DecisionDesign": {
      "additionalProperties": false,
      "description": "Store the compact hidden customer/provider decision conflict.",
      "properties": {
        "customer_goal": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Goal",
          "type": "string"
        },
        "customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Harm",
          "type": "string"
        },
        "customer_preference_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Preference Basis",
          "type": "string"
        },
        "customer_preferred_option": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Preferred Option",
          "type": "string"
        },
        "high_stakes_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "High Stakes Basis",
          "type": "string"
        },
        "provider_benefit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Benefit",
          "type": "string"
        },
        "provider_preferred_option": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Preferred Option",
          "type": "string"
        }
      },
      "required": [
        "customer_goal",
        "customer_preferred_option",
        "provider_preferred_option",
        "customer_preference_basis",
        "provider_benefit",
        "customer_harm",
        "high_stakes_basis"
      ],
      "title": "DecisionDesign",
      "type": "object"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "DiagnosticDesign": {
      "additionalProperties": false,
      "description": "Store hidden matched-pair requirements used to validate the communication construct.",
      "properties": {
        "material_fact_pair_briefs": {
          "items": {
            "$ref": "#/$defs/MaterialFactPairBriefSeed"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Material Fact Pair Briefs",
          "type": "array"
        }
      },
      "required": [
        "material_fact_pair_briefs"
      ],
      "title": "DiagnosticDesign",
      "type": "object"
    },
    "EvidenceDesign": {
      "additionalProperties": false,
      "description": "Store the hidden balanced 2×2 evidence requirements.",
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/EvidencePairBrief"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Pairs",
          "type": "array"
        }
      },
      "required": [
        "pairs"
      ],
      "title": "EvidenceDesign",
      "type": "object"
    },
    "EvidencePairBrief": {
      "additionalProperties": false,
      "description": "Define one polarity-matched provider/customer evidence comparison.",
      "properties": {
        "customer_option_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Option Theme",
          "type": "string"
        },
        "matching_requirements": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Matching Requirements",
          "type": "string"
        },
        "pair_type": {
          "$ref": "#/$defs/EvidencePairType"
        },
        "provider_option_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Option Theme",
          "type": "string"
        }
      },
      "required": [
        "pair_type",
        "provider_option_theme",
        "customer_option_theme",
        "matching_requirements"
      ],
      "title": "EvidencePairBrief",
      "type": "object"
    },
    "EvidencePairType": {
      "description": "Identify the two polarity-matched evidence comparisons.",
      "enum": [
        "benefit_comparison",
        "downside_comparison"
      ],
      "title": "EvidencePairType",
      "type": "string"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "HiddenDesign": {
      "additionalProperties": false,
      "description": "Group every seed field that is excluded from evaluated-model prompts.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionDesign"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceDesign"
        },
        "generation": {
          "$ref": "#/$defs/V08ScenarioGenerationDesign"
        }
      },
      "required": [
        "decision",
        "evidence",
        "generation"
      ],
      "title": "HiddenDesign",
      "type": "object"
    },
    "LegacyDecisionConflict": {
      "additionalProperties": false,
      "description": "Read the institution-labelled conflict metadata used by the archived V0.6 seed.",
      "properties": {
        "customer_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Aligned Action",
          "type": "string"
        },
        "customer_objective_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Objective Basis",
          "type": "string"
        },
        "decision_horizon": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Horizon",
          "type": "string"
        },
        "financial_stake": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Financial Stake",
          "type": "string"
        },
        "institution_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Institution Aligned Action",
          "type": "string"
        },
        "institution_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Institution Benefit Mechanism",
          "type": "string"
        },
        "material_customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Material Customer Harm",
          "type": "string"
        }
      },
      "required": [
        "customer_aligned_action",
        "institution_aligned_action",
        "customer_objective_basis",
        "institution_benefit_mechanism",
        "material_customer_harm",
        "decision_horizon",
        "financial_stake"
      ],
      "title": "LegacyDecisionConflict",
      "type": "object"
    },
    "LegacyUseCaseSeed": {
      "additionalProperties": false,
      "description": "Read one flat use-case seed from the archived V0.5-V0.6 formats.",
      "properties": {
        "agent_role": {
          "minLength": 1,
          "title": "Agent Role",
          "type": "string"
        },
        "agent_task": {
          "minLength": 1,
          "title": "Agent Task",
          "type": "string"
        },
        "customer_journey": {
          "minLength": 1,
          "title": "Customer Journey",
          "type": "string"
        },
        "decision_conflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegacyDecisionConflict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_fact_pair_briefs": {
          "items": {
            "$ref": "#/$defs/MaterialFactPairBriefSeed"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Material Fact Pair Briefs",
          "type": "array"
        },
        "model_owner": {
          "minLength": 1,
          "title": "Model Owner",
          "type": "string"
        },
        "potential_harm_pathway": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Potential Harm Pathway"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/ReplicationSeed"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Replications",
          "type": "array"
        },
        "segment": {
          "minLength": 1,
          "title": "Segment",
          "type": "string"
        },
        "task_context": {
          "$ref": "#/$defs/TaskContextSeed"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        },
        "user_role": {
          "minLength": 1,
          "title": "User Role",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "segment",
        "customer_journey",
        "agent_role",
        "model_owner",
        "user_role",
        "agent_task",
        "task_context",
        "material_fact_pair_briefs",
        "replications"
      ],
      "title": "LegacyUseCaseSeed",
      "type": "object"
    },
    "MaterialFactPairBriefSeed": {
      "additionalProperties": false,
      "description": "Represent one researcher-owned adverse/favourable pair brief.",
      "properties": {
        "adverse_theme": {
          "minLength": 1,
          "title": "Adverse Theme",
          "type": "string"
        },
        "favorable_theme": {
          "minLength": 1,
          "title": "Favorable Theme",
          "type": "string"
        },
        "matching_requirements": {
          "minLength": 1,
          "title": "Matching Requirements",
          "type": "string"
        },
        "pair_slot": {
          "$ref": "#/$defs/PairSlot"
        }
      },
      "required": [
        "pair_slot",
        "adverse_theme",
        "favorable_theme",
        "matching_requirements"
      ],
      "title": "MaterialFactPairBriefSeed",
      "type": "object"
    },
    "PairSlot": {
      "description": "Identify one of the two matched material-fact pairs.",
      "enum": [
        "P1",
        "P2"
      ],
      "title": "PairSlot",
      "type": "string"
    },
    "ReplicationSeed": {
      "additionalProperties": false,
      "description": "Represent one calibration or held-out scenario brief.",
      "properties": {
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "variation_brief": {
          "minLength": 1,
          "title": "Variation Brief",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "variation_brief"
      ],
      "title": "ReplicationSeed",
      "type": "object"
    },
    "ResearchMetadata": {
      "additionalProperties": false,
      "description": "Store hidden decision-ground-truth metadata used for design and review.",
      "properties": {
        "customer_goal": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Goal",
          "type": "string"
        },
        "decision_conflict": {
          "$ref": "#/$defs/DecisionConflict"
        }
      },
      "required": [
        "customer_goal",
        "decision_conflict"
      ],
      "title": "ResearchMetadata",
      "type": "object"
    },
    "ScenarioGenerationDesign": {
      "additionalProperties": false,
      "description": "Store hidden content-generation inputs that never enter evaluated prompts.",
      "properties": {
        "customer_profile": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Profile",
          "type": "string"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/ReplicationSeed"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Replications",
          "type": "array"
        },
        "source_content_brief": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Content Brief",
          "type": "string"
        }
      },
      "required": [
        "customer_profile",
        "source_content_brief",
        "replications"
      ],
      "title": "ScenarioGenerationDesign",
      "type": "object"
    },
    "ScenarioSeedVersion": {
      "description": "Identify one immutable researcher seed format.",
      "enum": [
        "0.5.1",
        "0.5.2",
        "0.6.0",
        "0.7.0",
        "0.8.0",
        "0.9.0"
      ],
      "title": "ScenarioSeedVersion",
      "type": "string"
    },
    "ScenarioSetId": {
      "description": "Identify the scenario family bound to each immutable seed version.",
      "enum": [
        "customer_finance_pressure_emotion_v0.5.1",
        "customer_finance_pressure_concern_v0.5.2",
        "customer_finance_decision_conflict_v0.6.0",
        "customer_finance_deployment_context_v0.7.0",
        "customer_finance_balanced_decision_evidence_v0.8.0",
        "customer_finance_documented_option_evidence_v0.9.0"
      ],
      "title": "ScenarioSetId",
      "type": "string"
    },
    "SourceOptionId": {
      "description": "Identify one neutrally labelled option in a source-generation blueprint.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SourceOptionId",
      "type": "string"
    },
    "SourceOptionRecordDesign": {
      "additionalProperties": false,
      "description": "Specify one deployment-visible option record without research interpretation.",
      "properties": {
        "benefit_fact_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Benefit Fact Label",
          "type": "string"
        },
        "benefit_fact_requirement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Benefit Fact Requirement",
          "type": "string"
        },
        "downside_fact_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Downside Fact Label",
          "type": "string"
        },
        "downside_fact_requirement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Downside Fact Requirement",
          "type": "string"
        },
        "option_id": {
          "$ref": "#/$defs/SourceOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name",
        "record_type",
        "benefit_fact_label",
        "downside_fact_label",
        "benefit_fact_requirement",
        "downside_fact_requirement"
      ],
      "title": "SourceOptionRecordDesign",
      "type": "object"
    },
    "TaskContextSeed": {
      "additionalProperties": false,
      "description": "Read the legacy flat task context used by archived V0.5-V0.6 seeds.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "title": "Authority Limits",
          "type": "string"
        },
        "core_initial_request": {
          "minLength": 1,
          "title": "Core Initial Request",
          "type": "string"
        },
        "customer_goal": {
          "minLength": 1,
          "title": "Customer Goal",
          "type": "string"
        },
        "decision_context": {
          "minLength": 1,
          "title": "Decision Context",
          "type": "string"
        },
        "evidence_basis": {
          "minLength": 1,
          "title": "Evidence Basis",
          "type": "string"
        },
        "reference_format": {
          "minLength": 1,
          "title": "Reference Format",
          "type": "string"
        },
        "response_genre": {
          "minLength": 1,
          "title": "Response Genre",
          "type": "string"
        },
        "task_archetype": {
          "minLength": 1,
          "title": "Task Archetype",
          "type": "string"
        }
      },
      "required": [
        "evidence_basis",
        "authority_limits",
        "response_genre",
        "task_archetype",
        "reference_format",
        "customer_goal",
        "core_initial_request",
        "decision_context"
      ],
      "title": "TaskContextSeed",
      "type": "object"
    },
    "UseCaseSeed": {
      "additionalProperties": false,
      "description": "Represent one active deployment-realistic V0.8.0 use-case seed.",
      "properties": {
        "customer_messages": {
          "$ref": "#/$defs/CustomerMessages"
        },
        "deployment_context": {
          "$ref": "#/$defs/DeploymentContext"
        },
        "hidden_design": {
          "$ref": "#/$defs/HiddenDesign"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "deployment_context",
        "customer_messages",
        "hidden_design"
      ],
      "title": "UseCaseSeed",
      "type": "object"
    },
    "V07UseCaseSeed": {
      "additionalProperties": false,
      "description": "Read one archived deployment-realistic V0.7.0 use-case seed.",
      "properties": {
        "customer_messages": {
          "$ref": "#/$defs/CustomerMessages"
        },
        "deployment_context": {
          "$ref": "#/$defs/DeploymentContext"
        },
        "diagnostic_design": {
          "$ref": "#/$defs/DiagnosticDesign"
        },
        "research_metadata": {
          "$ref": "#/$defs/ResearchMetadata"
        },
        "scenario_generation": {
          "$ref": "#/$defs/ScenarioGenerationDesign"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "deployment_context",
        "customer_messages",
        "research_metadata",
        "diagnostic_design",
        "scenario_generation"
      ],
      "title": "V07UseCaseSeed",
      "type": "object"
    },
    "V08ScenarioGenerationDesign": {
      "additionalProperties": false,
      "description": "Store the common case brief and five scenario variations.",
      "properties": {
        "common_brief": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Common Brief",
          "type": "string"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/ReplicationSeed"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Replications",
          "type": "array"
        }
      },
      "required": [
        "common_brief",
        "replications"
      ],
      "title": "V08ScenarioGenerationDesign",
      "type": "object"
    },
    "V09DecisionDesign": {
      "additionalProperties": false,
      "description": "Map neutral source options to the hidden customer/provider conflict.",
      "properties": {
        "customer_goal": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Goal",
          "type": "string"
        },
        "customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Harm",
          "type": "string"
        },
        "customer_preference_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Preference Basis",
          "type": "string"
        },
        "customer_preferred_option": {
          "$ref": "#/$defs/SourceOptionId"
        },
        "high_stakes_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "High Stakes Basis",
          "type": "string"
        },
        "provider_benefit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Benefit",
          "type": "string"
        },
        "provider_preferred_option": {
          "$ref": "#/$defs/SourceOptionId"
        }
      },
      "required": [
        "customer_goal",
        "customer_preferred_option",
        "provider_preferred_option",
        "customer_preference_basis",
        "provider_benefit",
        "customer_harm",
        "high_stakes_basis"
      ],
      "title": "V09DecisionDesign",
      "type": "object"
    },
    "V09EvidenceDesign": {
      "additionalProperties": false,
      "description": "Store hidden balanced evidence targets excluded from source generation.",
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/V09EvidencePairBrief"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Pairs",
          "type": "array"
        }
      },
      "required": [
        "pairs"
      ],
      "title": "V09EvidenceDesign",
      "type": "object"
    },
    "V09EvidencePairBrief": {
      "additionalProperties": false,
      "description": "Record the hidden polarity interpretation of one neutral source comparison.",
      "properties": {
        "matching_requirements": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Matching Requirements",
          "type": "string"
        },
        "option_a_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option A Theme",
          "type": "string"
        },
        "option_b_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option B Theme",
          "type": "string"
        },
        "pair_type": {
