        "deployment_context",
        "customer_messages",
        "hidden_design"
      ],
      "title": "V09UseCaseSeed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.9.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "use_cases": {
            "items": {
              "$ref": "#/$defs/V09UseCaseSeed"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.8.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "use_cases": {
            "items": {
              "$ref": "#/$defs/UseCaseSeed"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.7.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "use_cases": {
            "items": {
              "$ref": "#/$defs/V07UseCaseSeed"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.6.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "use_cases": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/LegacyUseCaseSeed"
                },
                {
                  "not": {
                    "required": [
                      "potential_harm_pathway"
                    ]
                  },
                  "required": [
                    "decision_conflict"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.5.1",
              "0.5.2"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "use_cases": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/LegacyUseCaseSeed"
                },
                {
                  "not": {
                    "required": [
                      "decision_conflict"
                    ]
                  },
                  "required": [
                    "potential_harm_pathway"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "description": "Represent a complete archived or active immutable seed document.",
  "properties": {
    "scenario_set_id": {
      "$ref": "#/$defs/ScenarioSetId"
    },
    "schema_version": {
      "$ref": "#/$defs/ScenarioSeedVersion"
    },
    "use_cases": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/LegacyUseCaseSeed"
          },
          {
            "$ref": "#/$defs/V07UseCaseSeed"
          },
          {
            "$ref": "#/$defs/UseCaseSeed"
          },
          {
            "$ref": "#/$defs/V09UseCaseSeed"
          }
        ]
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Use Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_set_id",
    "use_cases"
  ],
  "title": "ScenarioSeedSet",
  "type": "object"
}
