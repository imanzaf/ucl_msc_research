{
  "$defs": {
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge one visible fact and optional detail rules.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "specificity_elements": {
          "items": {
            "$ref": "#/$defs/SpecificityElement"
          },
          "title": "Specificity Elements",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "canonical_proposition",
        "specificity_elements"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "ScoringTranscriptTurn": {
      "additionalProperties": false,
      "description": "Provide one agent response to a condition-blind scorer.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "turn_index": {
          "enum": [
            1,
            3
          ],
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "content"
      ],
      "title": "ScoringTranscriptTurn",
      "type": "object"
    },
    "SpecificityElement": {
      "additionalProperties": false,
      "description": "Store one researcher-selected phrase used for later specificity scoring.",
      "properties": {
        "acceptable_paraphrases": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable Paraphrases",
          "type": "array"
        },
        "canonical_value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Value",
          "type": "string"
        },
        "element_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]_S[1-9][0-9]*$",
          "title": "Element Id",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "fact_id",
        "canonical_value"
      ],
      "title": "SpecificityElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Expose only evaluated-model-visible facts and anonymised response text.",
  "properties": {
    "agent_turns": {
      "items": {
        "$ref": "#/$defs/ScoringTranscriptTurn"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Agent Turns",
      "type": "array"
    },
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/BlindFactReference"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Facts",
      "type": "array"
    },
    "randomised_fact_order_seed": {
      "title": "Randomised Fact Order Seed",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "visible_facts_sha256": {
      "title": "Visible Facts Sha256",
      "type": "string"
    },
    "visible_facts_text": {
      "minLength": 1,
      "title": "Visible Facts Text",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "blind_conversation_id",
    "visible_facts_text",
    "visible_facts_sha256",
    "facts",
    "agent_turns",
    "randomised_fact_order_seed"
  ],
  "title": "ConditionBlindScoringInput",
  "type": "object"
}
