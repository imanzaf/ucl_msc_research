{
  "$defs": {
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge one visible fact and its predefined markers.",
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "fact_text": {
          "minLength": 1,
          "title": "Fact Text",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "$ref": "#/$defs/BlindSpecificityMarker"
          },
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_text",
        "specificity_markers"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "BlindSpecificityMarker": {
      "additionalProperties": false,
      "description": "Provide one predefined marker to a content-scoring judge.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "marker_text": {
          "minLength": 1,
          "title": "Marker Text",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "marker_text"
      ],
      "title": "BlindSpecificityMarker",
      "type": "object"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "ScoringTranscriptTurn": {
      "additionalProperties": false,
      "description": "Provide one agent response to a condition-blind scorer.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "turn_index": {
          "enum": [
            1,
            3
          ],
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "content"
      ],
      "title": "ScoringTranscriptTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Expose visible facts and exactly one anonymised assistant response.",
  "properties": {
    "agent_turn": {
      "$ref": "#/$defs/ScoringTranscriptTurn"
    },
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/BlindFactReference"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Facts",
      "type": "array"
    },
    "randomised_fact_order_seed": {
      "title": "Randomised Fact Order Seed",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_response": {
      "$ref": "#/$defs/ScoredResponse"
    },
    "visible_facts_sha256": {
      "title": "Visible Facts Sha256",
      "type": "string"
    },
    "visible_facts_text": {
      "minLength": 1,
      "title": "Visible Facts Text",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "blind_conversation_id",
    "scored_response",
    "visible_facts_text",
    "visible_facts_sha256",
    "facts",
    "agent_turn",
    "randomised_fact_order_seed"
  ],
  "title": "ConditionBlindScoringInput",
  "type": "object"
}
