{
  "additionalProperties": false,
  "description": "Authorize paid execution for one exact judge plan and cost ceiling.",
  "properties": {
    "approval_note": {
      "minLength": 2,
      "title": "Approval Note",
      "type": "string"
    },
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "minLength": 2,
      "title": "Approved By",
      "type": "string"
    },
    "approved_max_cost": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Approved Max Cost"
    },
    "estimate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Estimate Sha256",
      "type": "string"
    },
    "judge_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Judge Plan Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "judge_plan_sha256",
    "estimate_sha256",
    "approved_max_cost",
    "approved_by",
    "approved_at",
    "approval_note",
    "approval_sha256"
  ],
  "title": "JudgeExecutionApproval",
  "type": "object"
}
