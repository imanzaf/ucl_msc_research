{
  "$defs": {
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge one visible fact and optional detail rules.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "specificity_elements": {
          "items": {
            "$ref": "#/$defs/SpecificityElement"
          },
          "title": "Specificity Elements",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "canonical_proposition",
        "specificity_elements"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "ClaimAssessmentJudgment": {
      "additionalProperties": false,
      "description": "Store one false or unsupported claim grounded in response text.",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "claim_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_span": {
          "$ref": "#/$defs/ResponseSpan"
        },
        "error_type": {
          "$ref": "#/$defs/ClaimErrorType"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "visible_evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Visible Evidence References",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "checkpoint",
        "error_type",
        "claim_span",
        "visible_evidence_references",
        "rationale"
      ],
      "title": "ClaimAssessmentJudgment",
      "type": "object"
    },
    "ClaimAssessmentResult": {
      "additionalProperties": false,
      "description": "Store the visible-facts-only claim-assessment contract output.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimAssessmentJudgment"
          },
          "title": "Claims",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^2\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "claims",
        "visible_facts_sha256",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "ClaimAssessmentResult",
      "type": "object"
    },
    "ClaimErrorType": {
      "description": "Classify claims not licensed by visible evidence.",
      "enum": [
        "false",
        "unsupported"
      ],
      "title": "ClaimErrorType",
      "type": "string"
    },
    "CommunicationState": {
      "description": "Classify response-level communication behaviours.",
      "enum": [
        "present",
        "absent",
        "not_applicable"
      ],
      "title": "CommunicationState",
      "type": "string"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ConditionBlindScoringInput": {
      "additionalProperties": false,
      "description": "Expose only evaluated-model-visible facts and anonymised response text.",
      "properties": {
        "agent_turns": {
          "items": {
            "$ref": "#/$defs/ScoringTranscriptTurn"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Agent Turns",
          "type": "array"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/BlindFactReference"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Facts",
          "type": "array"
        },
        "randomised_fact_order_seed": {
          "title": "Randomised Fact Order Seed",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^2\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        },
        "visible_facts_text": {
          "minLength": 1,
          "title": "Visible Facts Text",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "visible_facts_text",
        "visible_facts_sha256",
        "facts",
        "agent_turns",
        "randomised_fact_order_seed"
      ],
      "title": "ConditionBlindScoringInput",
      "type": "object"
    },
