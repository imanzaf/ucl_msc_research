{
  "$defs": {
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bind conservative scenario-generation costs to one seed batch and backend.",
  "properties": {
    "backend_specification": {
      "minLength": 1,
      "title": "Backend Specification",
      "type": "string"
    },
    "base_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Base Cost Usd"
    },
    "base_generation_calls": {
      "exclusiveMinimum": 0,
      "title": "Base Generation Calls",
      "type": "integer"
    },
    "base_review_calls": {
      "exclusiveMinimum": 0,
      "title": "Base Review Calls",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generator_model_id": {
      "minLength": 1,
      "title": "Generator Model Id",
      "type": "string"
    },
    "maximum_input_tokens_per_call": {
      "exclusiveMinimum": 0,
      "title": "Maximum Input Tokens Per Call",
      "type": "integer"
    },
    "maximum_output_tokens_per_call": {
      "default": 12000,
      "maximum": 12000,
      "minimum": 12000,
      "title": "Maximum Output Tokens Per Call",
      "type": "integer"
    },
    "pricing_assumptions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Pricing Assumptions",
      "type": "object"
    },
    "report_sha256": {
      "title": "Report Sha256",
      "type": "string"
    },
    "reviewer_model_id": {
      "minLength": 1,
      "title": "Reviewer Model Id",
      "type": "string"
    },
    "scenario_count": {
      "exclusiveMinimum": 0,
      "title": "Scenario Count",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_schema_sha256": {
      "title": "Seed Schema Sha256",
      "type": "string"
    },
    "seed_sha256": {
      "title": "Seed Sha256",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/ScenarioStage"
    },
    "use_case_id": {
      "anyOf": [
        {
          "pattern": "^CF\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Use Case Id"
    },
    "worst_case_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Worst Case Cost Usd"
    },
    "worst_case_generation_calls": {
      "exclusiveMinimum": 0,
      "title": "Worst Case Generation Calls",
      "type": "integer"
    },
    "worst_case_review_calls": {
      "exclusiveMinimum": 0,
      "title": "Worst Case Review Calls",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "stage",
    "backend_specification",
    "seed_sha256",
    "seed_schema_sha256",
    "generator_model_id",
    "reviewer_model_id",
    "scenario_count",
    "base_generation_calls",
    "base_review_calls",
    "worst_case_generation_calls",
    "worst_case_review_calls",
    "maximum_input_tokens_per_call",
    "base_cost_usd",
    "worst_case_cost_usd",
    "pricing_assumptions",
    "generated_at",
    "report_sha256"
  ],
  "title": "ScenarioGenerationCostReport",
  "type": "object"
}
