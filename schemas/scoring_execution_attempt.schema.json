{
  "$defs": {
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "ScoringAttemptStatus": {
      "description": "Identify whether one identical scoring-package attempt succeeded or failed.",
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "ScoringAttemptStatus",
      "type": "string"
    },
    "ScoringContract": {
      "description": "Identify one independent scoring contract.",
      "enum": [
        "content",
        "presentation",
        "accuracy"
      ],
      "title": "ScoringContract",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Record one independently retryable scoring-contract call.",
  "properties": {
    "attempt_id": {
      "pattern": "^SCOREATTEMPT_[A-F0-9]{16}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/ScoringContract"
    },
    "error_message": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_response": {
      "$ref": "#/$defs/ScoredResponse"
    },
    "scoring_output_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Output Sha256"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ScoringAttemptStatus"
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "run_unit_id",
    "blind_conversation_id",
    "scored_response",
    "contract",
    "attempt_number",
    "request_sha256",
    "status",
    "started_at",
    "completed_at"
  ],
  "title": "ScoringExecutionAttempt",
  "type": "object"
}
