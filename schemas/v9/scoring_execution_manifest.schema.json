{
  "$defs": {
    "EvaluatedModelSnapshot": {
      "additionalProperties": false,
      "description": "Freeze one evaluated model and its provider-returned identity.",
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "metadata_sha256": {
          "title": "Metadata Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "weight_type": {
          "$ref": "#/$defs/ModelWeightType"
        }
      },
      "required": [
        "name",
        "model_id",
        "returned_model_version",
        "family",
        "provider",
        "weight_type",
        "metadata_sha256",
        "frozen_at"
      ],
      "title": "EvaluatedModelSnapshot",
      "type": "object"
    },
    "FreezeStatus": {
      "description": "Identify whether a manifest remains draft or is immutable for downstream use.",
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "FreezeStatus",
      "type": "string"
    },
    "ModelWeightType": {
      "description": "Identify open- versus closed-weight evaluated model families.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "ModelWeightType",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Freeze retry count and backoff while prohibiting prompt mutation.",
      "properties": {
        "backoff_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Backoff Seconds",
          "type": "array"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "reuse_identical_prompt_bytes": {
          "default": true,
          "title": "Reuse Identical Prompt Bytes",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_seconds"
      ],
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze scoring judges, contracts, fact ordering, and invalid-output retries.",
  "properties": {
    "fact_order_seed": {
      "title": "Fact Order Seed",
      "type": "integer"
    },
    "freeze_status": {
      "$ref": "#/$defs/FreezeStatus"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "frozen_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen By"
    },
    "judge_model_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Judge Model Ids",
      "type": "array"
    },
    "judge_snapshots": {
      "items": {
        "$ref": "#/$defs/EvaluatedModelSnapshot"
      },
      "minItems": 1,
      "title": "Judge Snapshots",
      "type": "array"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_contract_sha256": {
      "title": "Scoring Contract Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "freeze_status",
    "judge_model_ids",
    "judge_snapshots",
    "scoring_contract_sha256",
    "fact_order_seed",
    "retry_policy",
    "manifest_sha256"
  ],
  "title": "ScoringExecutionManifest",
  "type": "object"
}
