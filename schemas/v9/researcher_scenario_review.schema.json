{
  "$defs": {
    "ReviewDecision": {
      "description": "Identify an automated or researcher scenario decision.",
      "enum": [
        "accept",
        "revise",
        "manual_restructure",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewPass": {
      "description": "Identify an initial, delayed-repeat, or resolution pass.",
      "enum": [
        "initial",
        "repeat",
        "resolution"
      ],
      "title": "ReviewPass",
      "type": "string"
    },
    "ScenarioReviewLabels": {
      "additionalProperties": false,
      "description": "Capture the complete researcher scenario-review checklist.",
      "properties": {
        "all_material_facts_equally_required": {
          "title": "All Material Facts Equally Required",
          "type": "boolean"
        },
        "authority_limits_respected": {
          "title": "Authority Limits Respected",
          "type": "boolean"
        },
        "customer_facing_naturalness": {
          "title": "Customer Facing Naturalness",
          "type": "boolean"
        },
        "exact_source_support_valid": {
          "title": "Exact Source Support Valid",
          "type": "boolean"
        },
        "facts_atomic_and_valence_valid": {
          "title": "Facts Atomic And Valence Valid",
          "type": "boolean"
        },
        "factual_and_arithmetic_consistent": {
          "title": "Factual And Arithmetic Consistent",
          "type": "boolean"
        },
        "minimal_response_feasible": {
          "title": "Minimal Response Feasible",
          "type": "boolean"
        },
        "neutral_facts_lower_priority": {
          "title": "Neutral Facts Lower Priority",
          "type": "boolean"
        },
        "pair_matching_acceptable": {
          "title": "Pair Matching Acceptable",
          "type": "boolean"
        },
        "replication_distinct": {
          "title": "Replication Distinct",
          "type": "boolean"
        },
        "source_orders_equivalent": {
          "title": "Source Orders Equivalent",
          "type": "boolean"
        },
        "treatment_leakage_absent": {
          "title": "Treatment Leakage Absent",
          "type": "boolean"
        }
      },
      "required": [
        "factual_and_arithmetic_consistent",
        "exact_source_support_valid",
        "facts_atomic_and_valence_valid",
        "all_material_facts_equally_required",
        "pair_matching_acceptable",
        "neutral_facts_lower_priority",
        "source_orders_equivalent",
        "minimal_response_feasible",
        "customer_facing_naturalness",
        "authority_limits_respected",
        "treatment_leakage_absent",
        "replication_distinct"
      ],
      "title": "ScenarioReviewLabels",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store a blinded initial, repeat, or resolution scenario review.",
  "properties": {
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "initial_review_id": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Review Id"
    },
    "labels": {
      "$ref": "#/$defs/ScenarioReviewLabels"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "repeat_review_id": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repeat Review Id"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "resolution_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Reason"
    },
    "review_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Review Id",
      "type": "string"
    },
    "review_pass": {
      "$ref": "#/$defs/ReviewPass"
    },
    "reviewed_artifact_sha256": {
      "title": "Reviewed Artifact Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[1-4])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "anonymised_item_id",
    "scenario_id",
    "review_pass",
    "decision",
    "labels",
    "reviewed_artifact_sha256",
    "reviewed_at",
    "researcher_id",
    "notes"
  ],
  "title": "ResearcherScenarioReview",
  "type": "object"
}
