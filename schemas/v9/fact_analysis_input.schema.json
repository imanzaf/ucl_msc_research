{
  "$defs": {
    "EmotionalCueCondition": {
      "description": "Identify the single visible opening-cue condition.",
      "enum": [
        "neutral",
        "worried"
      ],
      "title": "EmotionalCueCondition",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify initial-only versus cumulative communication checkpoints.",
      "enum": [
        "initial",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "FactValence": {
      "description": "Identify material-fact valence without encoding it in visible sources.",
      "enum": [
        "adverse",
        "favourable"
      ],
      "title": "FactValence",
      "type": "string"
    },
    "IntegrityCondition": {
      "description": "Identify whether the targeted mitigation is present.",
      "enum": [
        "absent",
        "targeted"
      ],
      "title": "IntegrityCondition",
      "type": "string"
    },
    "SourceOrderVariant": {
      "description": "Identify deterministic information-equivalent source order.",
      "enum": [
        "A",
        "B"
      ],
      "title": "SourceOrderVariant",
      "type": "string"
    },
    "WordBudgetCondition": {
      "description": "Identify the assigned response-length condition.",
      "enum": [
        "ample",
        "tight"
      ],
      "title": "WordBudgetCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Expose one material-fact disclosure state for ordinal robustness analysis.",
  "properties": {
    "checkpoint": {
      "$ref": "#/$defs/EvaluationCheckpoint"
    },
    "disclosure_ordinal": {
      "maximum": 2,
      "minimum": 0,
      "title": "Disclosure Ordinal",
      "type": "integer"
    },
    "emotional_cue": {
      "$ref": "#/$defs/EmotionalCueCondition"
    },
    "fact_id": {
      "minLength": 1,
      "title": "Fact Id",
      "type": "string"
    },
    "fact_valence": {
      "$ref": "#/$defs/FactValence"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityCondition"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_R[1-4]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_result_sha256": {
      "title": "Scoring Result Sha256",
      "type": "string"
    },
    "source_order": {
      "$ref": "#/$defs/SourceOrderVariant"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    },
    "word_budget": {
      "$ref": "#/$defs/WordBudgetCondition"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "scenario_id",
    "use_case_id",
    "fact_id",
    "fact_valence",
    "checkpoint",
    "disclosure_ordinal",
    "model_id",
    "source_order",
    "word_budget",
    "emotional_cue",
    "integrity",
    "transcript_sha256",
    "scoring_result_sha256"
  ],
  "title": "FactAnalysisInputRow",
  "type": "object"
}
