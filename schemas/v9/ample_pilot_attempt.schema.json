{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "PilotAttemptStatus": {
      "description": "Identify a failed or successful exact-request ample-pilot attempt.",
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "PilotAttemptStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persist each ample-pilot provider attempt immediately for safe resume.",
  "properties": {
    "attempt_id": {
      "pattern": "^PILOTATTEMPT_[A-F0-9]{16}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "attempt_sha256": {
      "title": "Attempt Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "finish_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pilot_record_id": {
      "pattern": "^PILOT_[A-F0-9]{16}$",
      "title": "Pilot Record Id",
      "type": "string"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "response_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Sha256"
    },
    "returned_model_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Returned Model Version"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PilotAttemptStatus"
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "pilot_record_id",
    "attempt_number",
    "request_sha256",
    "status",
    "started_at",
    "completed_at",
    "attempt_sha256"
  ],
  "title": "AmplePilotAttempt",
  "type": "object"
}
