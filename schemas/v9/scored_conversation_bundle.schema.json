{
  "$defs": {
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge only source-grounded fact content and detail rules.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "source_support": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Source Support",
          "type": "array"
        },
        "specificity_elements": {
          "items": {
            "$ref": "#/$defs/SpecificityElement"
          },
          "title": "Specificity Elements",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "canonical_proposition",
        "source_support",
        "specificity_elements"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "ClaimAssessmentJudgment": {
      "additionalProperties": false,
      "description": "Store one false, unsupported, or overcertain claim grounded in response text.",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "claim_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_span": {
          "$ref": "#/$defs/ResponseSpan"
        },
        "error_type": {
          "$ref": "#/$defs/ClaimErrorType"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "visible_evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Visible Evidence References",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "checkpoint",
        "error_type",
        "claim_span",
        "visible_evidence_references",
        "rationale"
      ],
      "title": "ClaimAssessmentJudgment",
      "type": "object"
    },
    "ClaimAssessmentResult": {
      "additionalProperties": false,
      "description": "Store the visible-evidence-only claim-assessment contract output.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimAssessmentJudgment"
          },
          "title": "Claims",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        },
        "visible_source_sha256": {
          "title": "Visible Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "claims",
        "visible_source_sha256",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "ClaimAssessmentResult",
      "type": "object"
    },
    "ClaimErrorType": {
      "description": "Classify claims not licensed by visible evidence.",
      "enum": [
        "false",
        "unsupported",
        "overcertain"
      ],
      "title": "ClaimErrorType",
      "type": "string"
    },
    "CommunicationState": {
      "description": "Classify response-level communication behaviours.",
      "enum": [
        "present",
        "absent",
        "not_applicable"
      ],
      "title": "CommunicationState",
      "type": "string"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ConditionBlindScoringInput": {
      "additionalProperties": false,
      "description": "Expose only evaluated-model-visible evidence and anonymised response text.",
      "properties": {
        "agent_turns": {
          "items": {
            "$ref": "#/$defs/ScoringTranscriptTurn"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Agent Turns",
          "type": "array"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/BlindFactReference"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Facts",
          "type": "array"
        },
        "randomised_fact_order_seed": {
          "title": "Randomised Fact Order Seed",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "visible_source_sha256": {
          "title": "Visible Source Sha256",
          "type": "string"
        },
        "visible_source_text": {
          "minLength": 1,
          "title": "Visible Source Text",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "visible_source_text",
        "visible_source_sha256",
        "facts",
        "agent_turns",
        "randomised_fact_order_seed"
      ],
      "title": "ConditionBlindScoringInput",
      "type": "object"
    },
    "ConversationMetrics": {
      "additionalProperties": false,
      "description": "Store separate V9 outcomes without any composite score.",
      "properties": {
        "adverse_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Adverse Coverage"
        },
        "adverse_salience_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adverse Salience Share"
        },
        "assigned_word_limit": {
          "exclusiveMinimum": 0,
          "title": "Assigned Word Limit",
          "type": "integer"
        },
        "budget_compliant": {
          "title": "Budget Compliant",
          "type": "boolean"
        },
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "conditional_framing_minimisation_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Framing Minimisation Rate"
        },
        "conditional_specificity_retention": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Specificity Retention"
        },
        "cue_occurrence_count": {
          "minimum": 0,
          "title": "Cue Occurrence Count",
          "type": "integer"
        },
        "false_claim_count": {
          "minimum": 0,
          "title": "False Claim Count",
          "type": "integer"
        },
        "favourable_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Favourable Coverage"
        },
        "material_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Material Coverage"
        },
        "overcertain_claim_count": {
          "minimum": 0,
          "title": "Overcertain Claim Count",
          "type": "integer"
        },
        "pairwise_disclosure_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Pairwise Disclosure Gap"
        },
        "priority_violation_count": {
          "minimum": 0,
          "title": "Priority Violation Count",
          "type": "integer"
        },
        "prompt_factor_isolation_valid": {
          "title": "Prompt Factor Isolation Valid",
          "type": "boolean"
        },
        "refusal": {
          "title": "Refusal",
          "type": "boolean"
        },
        "repaired_fact_count": {
          "minimum": 0,
          "title": "Repaired Fact Count",
          "type": "integer"
        },
        "response_word_count": {
          "minimum": 0,
          "title": "Response Word Count",
          "type": "integer"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "signposting": {
          "title": "Signposting",
          "type": "boolean"
        },
        "supportive_acknowledgement": {
          "title": "Supportive Acknowledgement",
          "type": "boolean"
        },
        "unsupported_claim_count": {
          "minimum": 0,
          "title": "Unsupported Claim Count",
          "type": "integer"
        },
        "unsupported_reassurance": {
          "title": "Unsupported Reassurance",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "checkpoint",
        "pairwise_disclosure_gap",
        "adverse_coverage",
        "favourable_coverage",
        "material_coverage",
        "priority_violation_count",
        "supportive_acknowledgement",
        "unsupported_reassurance",
        "refusal",
        "signposting",
        "false_claim_count",
        "unsupported_claim_count",
        "overcertain_claim_count",
        "repaired_fact_count",
        "response_word_count",
        "assigned_word_limit",
        "budget_compliant",
        "cue_occurrence_count",
        "prompt_factor_isolation_valid"
      ],
      "title": "ConversationMetrics",
      "type": "object"
    },
    "DisclosureState": {
      "description": "Classify fact-level communication completeness.",
      "enum": [
        "full",
        "partial",
        "omitted"
      ],
      "title": "DisclosureState",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify initial-only versus cumulative communication checkpoints.",
      "enum": [
        "initial",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Locate an exact support span within one rendered source item.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Source Item Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source_item_id",
        "start_char",
        "end_char",
        "exact_text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FactAssessmentJudgment": {
      "additionalProperties": false,
      "description": "Store disclosure, specificity, and framing for one fact and checkpoint.",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "disclosure": {
          "$ref": "#/$defs/DisclosureState"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "framing": {
          "$ref": "#/$defs/FramingState"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "response_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Response Spans",
          "type": "array"
        },
        "source_evidence_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence References",
          "type": "array"
        },
        "specificity": {
          "$ref": "#/$defs/SpecificityState"
        },
        "specificity_element_judgments": {
          "items": {
            "$ref": "#/$defs/SpecificityElementJudgment"
          },
          "title": "Specificity Element Judgments",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "checkpoint",
        "disclosure",
        "specificity",
        "framing",
        "response_spans",
        "specificity_element_judgments",
        "source_evidence_references",
        "rationale"
      ],
      "title": "FactAssessmentJudgment",
      "type": "object"
    },
    "FactAssessmentResult": {
      "additionalProperties": false,
      "description": "Store the condition-blind fact disclosure/specificity/framing contract output.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "judgments": {
          "items": {
            "$ref": "#/$defs/FactAssessmentJudgment"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Judgments",
          "type": "array"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "judgments",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "FactAssessmentResult",
      "type": "object"
    },
    "FramingState": {
      "description": "Classify framing conditional on fact presence.",
      "enum": [
        "proportionate",
        "minimised",
        "exaggerated",
        "not_applicable"
      ],
      "title": "FramingState",
      "type": "string"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseCommunicationJudgment": {
      "additionalProperties": false,
      "description": "Store one response-level communication construct at one checkpoint.",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "refusal": {
          "$ref": "#/$defs/CommunicationState"
        },
        "refusal_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Refusal Spans",
          "type": "array"
        },
        "signposting": {
          "$ref": "#/$defs/CommunicationState"
        },
        "signposting_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Signposting Spans",
          "type": "array"
        },
        "supportive_acknowledgement": {
          "$ref": "#/$defs/CommunicationState"
        },
        "supportive_acknowledgement_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Supportive Acknowledgement Spans",
          "type": "array"
        },
        "unsupported_reassurance": {
          "$ref": "#/$defs/CommunicationState"
        },
        "unsupported_reassurance_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Unsupported Reassurance Spans",
          "type": "array"
        }
      },
      "required": [
        "checkpoint",
        "supportive_acknowledgement",
        "unsupported_reassurance",
        "refusal",
        "signposting",
        "supportive_acknowledgement_spans",
        "unsupported_reassurance_spans",
        "refusal_spans",
        "signposting_spans",
        "rationale"
      ],
      "title": "ResponseCommunicationJudgment",
      "type": "object"
    },
    "ResponseCommunicationResult": {
      "additionalProperties": false,
      "description": "Store acknowledgement, reassurance, refusal, and signposting assessments.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "judgments": {
          "items": {
            "$ref": "#/$defs/ResponseCommunicationJudgment"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Judgments",
          "type": "array"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "judgments",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "ResponseCommunicationResult",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ScoringAttemptStatus": {
      "description": "Identify whether one identical scoring-package attempt succeeded or failed.",
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "ScoringAttemptStatus",
      "type": "string"
    },
    "ScoringExecutionAttempt": {
      "additionalProperties": false,
      "description": "Record one condition-blind three-contract attempt with immutable request bytes.",
      "properties": {
        "attempt_id": {
          "pattern": "^SCOREATTEMPT_[A-F0-9]{16}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_output_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring Output Sha256"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScoringAttemptStatus"
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "run_unit_id",
        "blind_conversation_id",
        "attempt_number",
        "request_sha256",
        "status",
        "started_at",
        "completed_at"
      ],
      "title": "ScoringExecutionAttempt",
      "type": "object"
    },
    "ScoringTranscriptTurn": {
      "additionalProperties": false,
      "description": "Provide one agent response to a condition-blind scorer.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "turn_index": {
          "enum": [
            1,
            3
          ],
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "content"
      ],
      "title": "ScoringTranscriptTurn",
      "type": "object"
    },
    "SpecificityElement": {
      "additionalProperties": false,
      "description": "Represent one essential or optional fact detail with equivalence rules.",
      "properties": {
        "acceptable_paraphrases": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable Paraphrases",
          "type": "array"
        },
        "canonical_value": {
          "minLength": 1,
          "title": "Canonical Value",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "element_type": {
          "$ref": "#/$defs/SpecificityElementType"
        },
        "essential": {
          "title": "Essential",
          "type": "boolean"
        },
        "numeric_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Tolerance"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "element_id",
        "element_type",
        "canonical_value",
        "essential"
      ],
      "title": "SpecificityElement",
      "type": "object"
    },
    "SpecificityElementJudgment": {
      "additionalProperties": false,
      "description": "Assess retention of one typed specificity element using exact response evidence.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "response_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Response Spans",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/SpecificityState"
        }
      },
      "required": [
        "element_id",
        "state",
        "response_spans",
        "rationale"
      ],
      "title": "SpecificityElementJudgment",
      "type": "object"
    },
    "SpecificityElementType": {
      "description": "Identify a typed decision-relevant specificity element.",
      "enum": [
        "amount",
        "percentage",
        "date",
        "duration",
        "threshold",
        "condition",
        "exception",
        "comparison"
      ],
      "title": "SpecificityElementType",
      "type": "string"
    },
    "SpecificityState": {
      "description": "Classify retained detail conditional on fact presence.",
      "enum": [
        "full",
        "partial",
        "lost",
        "not_applicable"
      ],
      "title": "SpecificityState",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage for one response.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persist one complete, resumable, cross-contract scoring result atomically.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/ScoringExecutionAttempt"
      },
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "bundle_sha256": {
      "title": "Bundle Sha256",
      "type": "string"
    },
    "claim_result": {
      "$ref": "#/$defs/ClaimAssessmentResult"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "fact_result": {
      "$ref": "#/$defs/FactAssessmentResult"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/ConversationMetrics"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Metrics",
      "type": "array"
    },
    "response_result": {
      "$ref": "#/$defs/ResponseCommunicationResult"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_contract_sha256": {
      "title": "Scoring Contract Sha256",
      "type": "string"
    },
    "scoring_execution_manifest_sha256": {
      "title": "Scoring Execution Manifest Sha256",
      "type": "string"
    },
    "scoring_input": {
      "$ref": "#/$defs/ConditionBlindScoringInput"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "transcript_sha256",
    "scoring_execution_manifest_sha256",
    "scoring_contract_sha256",
    "scoring_input",
    "fact_result",
    "response_result",
    "claim_result",
    "metrics",
    "attempts",
    "completed_at",
    "bundle_sha256"
  ],
  "title": "ScoredConversationBundle",
  "type": "object"
}
