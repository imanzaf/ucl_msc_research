{
  "$defs": {
    "FreezeStatus": {
      "description": "Identify whether a manifest remains draft or is immutable for downstream use.",
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "FreezeStatus",
      "type": "string"
    },
    "PowerVarianceComponents": {
      "additionalProperties": false,
      "description": "Freeze calibration-derived variance at every repeated-design level.",
      "properties": {
        "model_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Model Standard Deviation"
        },
        "scenario_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Scenario Standard Deviation"
        },
        "scoring_error_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Scoring Error Standard Deviation"
        },
        "source_order_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Source Order Standard Deviation"
        },
        "use_case_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Use Case Standard Deviation"
        }
      },
      "required": [
        "use_case_standard_deviation",
        "scenario_standard_deviation",
        "model_standard_deviation",
        "source_order_standard_deviation",
        "scoring_error_standard_deviation"
      ],
      "title": "PowerVarianceComponents",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze pre-evaluation variance assumptions for all five power simulations.",
  "properties": {
    "calibration_source_sha256": {
      "title": "Calibration Source Sha256",
      "type": "string"
    },
    "freeze_status": {
      "$ref": "#/$defs/FreezeStatus"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "frozen_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen By"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "smallest_effect_manifest_sha256": {
      "title": "Smallest Effect Manifest Sha256",
      "type": "string"
    },
    "variance_components": {
      "additionalProperties": {
        "$ref": "#/$defs/PowerVarianceComponents"
      },
      "maxProperties": 5,
      "minProperties": 5,
      "title": "Variance Components",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "freeze_status",
    "smallest_effect_manifest_sha256",
    "variance_components",
    "calibration_source_sha256",
    "manifest_sha256"
  ],
  "title": "PowerAssumptionManifest",
  "type": "object"
}
