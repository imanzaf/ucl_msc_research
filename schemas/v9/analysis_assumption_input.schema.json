{
  "$defs": {
    "PowerVarianceComponents": {
      "additionalProperties": false,
      "description": "Freeze calibration-derived variance at every repeated-design level.",
      "properties": {
        "model_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Model Standard Deviation"
        },
        "scenario_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Scenario Standard Deviation"
        },
        "scoring_error_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Scoring Error Standard Deviation"
        },
        "source_order_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Source Order Standard Deviation"
        },
        "use_case_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Use Case Standard Deviation"
        }
      },
      "required": [
        "use_case_standard_deviation",
        "scenario_standard_deviation",
        "model_standard_deviation",
        "source_order_standard_deviation",
        "scoring_error_standard_deviation"
      ],
      "title": "PowerVarianceComponents",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validate researcher-authored effect, rationale, and variance inputs before freezing.",
  "properties": {
    "absolute_bounds": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "maxProperties": 5,
      "minProperties": 5,
      "title": "Absolute Bounds",
      "type": "object"
    },
    "rationales": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 5,
      "minProperties": 5,
      "title": "Rationales",
      "type": "object"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "variance_components": {
      "additionalProperties": {
        "$ref": "#/$defs/PowerVarianceComponents"
      },
      "maxProperties": 5,
      "minProperties": 5,
      "title": "Variance Components",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "absolute_bounds",
    "rationales",
    "variance_components"
  ],
  "title": "AnalysisAssumptionInput",
  "type": "object"
}
