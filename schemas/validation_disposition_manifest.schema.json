{
  "$defs": {
    "FailedConstructAction": {
      "description": "Identify the blinded disposition for a scoring construct that fails validation.",
      "enum": [
        "full_manual_scoring",
        "remove_and_renormalise",
        "withhold_outcome"
      ],
      "title": "FailedConstructAction",
      "type": "string"
    },
    "ScoringConstruct": {
      "description": "Identify one independently validated score component.",
      "enum": [
        "coverage",
        "specificity",
        "framing",
        "ordering",
        "emphasis",
        "accuracy"
      ],
      "title": "ScoringConstruct",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bind blinded failed-construct dispositions to resulting score definitions.",
  "properties": {
    "blinded_diagnostics_sha256": {
      "title": "Blinded Diagnostics Sha256",
      "type": "string"
    },
    "confirmatory_inference_withheld": {
      "title": "Confirmatory Inference Withheld",
      "type": "boolean"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "dispositions": {
      "additionalProperties": {
        "$ref": "#/$defs/FailedConstructAction"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Dispositions",
      "type": "object"
    },
    "effect_estimates_available_when_decided": {
      "default": false,
      "title": "Effect Estimates Available When Decided",
      "type": "boolean"
    },
    "factual_inaccuracy_result_withheld": {
      "title": "Factual Inaccuracy Result Withheld",
      "type": "boolean"
    },
    "failed_constructs": {
      "items": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Failed Constructs",
      "type": "array"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "presentation_result_withheld": {
      "title": "Presentation Result Withheld",
      "type": "boolean"
    },
    "presentation_weights": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Presentation Weights",
      "type": "object"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "selective_weights": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Selective Weights",
      "type": "object"
    },
    "treatment_labels_available_when_decided": {
      "default": false,
      "title": "Treatment Labels Available When Decided",
      "type": "boolean"
    },
    "validation_report_sha256": {
      "title": "Validation Report Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "validation_report_sha256",
    "blinded_diagnostics_sha256",
    "failed_constructs",
    "dispositions",
    "selective_weights",
    "presentation_weights",
    "confirmatory_inference_withheld",
    "presentation_result_withheld",
    "factual_inaccuracy_result_withheld",
    "researcher_id",
    "rationale",
    "decided_at",
    "manifest_sha256"
  ],
  "title": "ValidationDispositionManifest",
  "type": "object"
}
