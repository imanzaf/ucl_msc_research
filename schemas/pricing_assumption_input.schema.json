{
  "$defs": {
    "ModelPricingAssumption": {
      "additionalProperties": false,
      "description": "Store one provider's input and output price assumptions per million tokens.",
      "properties": {
        "input_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Per Million Usd"
        },
        "output_per_million_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Output Per Million Usd"
        }
      },
      "required": [
        "input_per_million_usd",
        "output_per_million_usd"
      ],
      "title": "ModelPricingAssumption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validate model-keyed dry-run pricing assumptions from a researcher-authored file.",
  "properties": {
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelPricingAssumption"
      },
      "minProperties": 1,
      "title": "Models",
      "type": "object"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "models"
  ],
  "title": "PricingAssumptionInput",
  "type": "object"
}
