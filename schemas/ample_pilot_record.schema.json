{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "EmotionalCueCondition": {
      "description": "Identify the single visible opening-cue condition.",
      "enum": [
        "neutral",
        "worried"
      ],
      "title": "EmotionalCueCondition",
      "type": "string"
    },
    "IntegrityCondition": {
      "description": "Identify whether the targeted mitigation is present.",
      "enum": [
        "absent",
        "targeted"
      ],
      "title": "IntegrityCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persist one calibration-only 320-word adequacy-pilot response.",
  "properties": {
    "emotional_cue": {
      "$ref": "#/$defs/EmotionalCueCondition"
    },
    "expected_model_version": {
      "minLength": 1,
      "title": "Expected Model Version",
      "type": "string"
    },
    "finish_reason": {
      "$ref": "#/$defs/CompletionFinishReason"
    },
    "finished_naturally": {
      "title": "Finished Naturally",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityCondition"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_snapshot_sha256": {
      "title": "Model Snapshot Sha256",
      "type": "string"
    },
    "output_sha256": {
      "title": "Output Sha256",
      "type": "string"
    },
    "output_text": {
      "minLength": 1,
      "title": "Output Text",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "output_word_count": {
      "exclusiveMinimum": 0,
      "title": "Output Word Count",
      "type": "integer"
    },
    "pilot_record_id": {
      "pattern": "^PILOT_[A-F0-9]{16}$",
      "title": "Pilot Record Id",
      "type": "string"
    },
    "pilot_word_limit": {
      "default": 320,
      "maximum": 320,
      "minimum": 320,
      "title": "Pilot Word Limit",
      "type": "integer"
    },
    "prompt_review_manifest_sha256": {
      "title": "Prompt Review Manifest Sha256",
      "type": "string"
    },
    "prompt_sha256": {
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provider_request_id": {
      "minLength": 1,
      "title": "Provider Request Id",
      "type": "string"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "record_sha256": {
      "title": "Record Sha256",
      "type": "string"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "returned_model_version": {
      "minLength": 1,
      "title": "Returned Model Version",
      "type": "string"
    },
    "scenario_artifact_sha256": {
      "title": "Scenario Artifact Sha256",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_C1$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "pilot_record_id",
    "scenario_id",
    "use_case_id",
    "model_id",
    "model_snapshot_sha256",
    "prompt_review_manifest_sha256",
    "expected_model_version",
    "returned_model_version",
    "emotional_cue",
    "integrity",
    "output_text",
    "output_word_count",
    "finished_naturally",
    "finish_reason",
    "prompt_sha256",
    "request_sha256",
    "random_seed",
    "provider_request_id",
    "input_tokens",
    "output_tokens",
    "scenario_artifact_sha256",
    "generated_at",
    "output_sha256",
    "record_sha256"
  ],
  "title": "AmplePilotRecord",
  "type": "object"
}
