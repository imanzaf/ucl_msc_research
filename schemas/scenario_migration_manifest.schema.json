{
  "$defs": {
    "ScenarioMigrationEntry": {
      "additionalProperties": false,
      "description": "Bind one migrated candidate to its approved source-run artifact.",
      "properties": {
        "migrated_candidate_sha256": {
          "title": "Migrated Candidate Sha256",
          "type": "string"
        },
        "researcher_review_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Researcher Review Id",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "source_automated_review_sha256": {
          "title": "Source Automated Review Sha256",
          "type": "string"
        },
        "source_candidate_sha256": {
          "title": "Source Candidate Sha256",
          "type": "string"
        },
        "source_round_id": {
          "pattern": "^\\d{8}T\\d{12}Z$",
          "title": "Source Round Id",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "source_run_id",
        "source_round_id",
        "source_candidate_sha256",
        "migrated_candidate_sha256",
        "researcher_review_id",
        "source_automated_review_sha256"
      ],
      "title": "ScenarioMigrationEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record a complete approved calibration-set schema migration.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/ScenarioMigrationEntry"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Entries",
      "type": "array"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "migrated_at": {
      "format": "date-time",
      "title": "Migrated At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_run_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Run Ids",
      "type": "array"
    },
    "target_run_id": {
      "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$",
      "title": "Target Run Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "target_run_id",
    "source_run_ids",
    "entries",
    "migrated_at",
    "manifest_sha256"
  ],
  "title": "ScenarioMigrationManifest",
  "type": "object"
}
