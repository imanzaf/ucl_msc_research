{
  "$defs": {
    "AmplePilotSummary": {
      "additionalProperties": false,
      "description": "Store the post-model-freeze 320-word adequacy pilot gate.",
      "properties": {
        "all_approved_complete_responses_fit": {
          "title": "All Approved Complete Responses Fit",
          "type": "boolean"
        },
        "outputs_within_ample_limit": {
          "maximum": 60,
          "minimum": 0,
          "title": "Outputs Within Ample Limit",
          "type": "integer"
        },
        "pilot_word_limit": {
          "default": 320,
          "title": "Pilot Word Limit",
          "type": "integer"
        },
        "proposed_ample_word_limit": {
          "default": 240,
          "title": "Proposed Ample Word Limit",
          "type": "integer"
        },
        "result_record_sha256": {
          "title": "Result Record Sha256",
          "type": "string"
        },
        "total_outputs": {
          "default": 60,
          "title": "Total Outputs",
          "type": "integer"
        }
      },
      "required": [
        "outputs_within_ample_limit",
        "all_approved_complete_responses_fit",
        "result_record_sha256"
      ],
      "title": "AmplePilotSummary",
      "type": "object"
    },
    "FreezeStatus": {
      "description": "Identify whether a manifest remains draft or is immutable for downstream use.",
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "FreezeStatus",
      "type": "string"
    },
    "UseCaseBudget": {
      "additionalProperties": false,
      "description": "Freeze one use case's calibrated tight-word limit and feasibility evidence.",
      "properties": {
        "calibration_minimal_word_count": {
          "exclusiveMinimum": 0,
          "title": "Calibration Minimal Word Count",
          "type": "integer"
        },
        "calibration_scenario_id": {
          "pattern": "^CF\\d{3}_C1$",
          "title": "Calibration Scenario Id",
          "type": "string"
        },
        "evaluation_minimal_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 4,
          "minProperties": 4,
          "title": "Evaluation Minimal Word Counts",
          "type": "object"
        },
        "minimal_response_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 5,
          "minProperties": 5,
          "title": "Minimal Response Sha256",
          "type": "object"
        },
        "tight_word_limit": {
          "maximum": 115,
          "minimum": 80,
          "multipleOf": 5,
          "title": "Tight Word Limit",
          "type": "integer"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "calibration_scenario_id",
        "calibration_minimal_word_count",
        "tight_word_limit",
        "evaluation_minimal_word_counts",
        "minimal_response_sha256"
      ],
      "title": "UseCaseBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze all ten use-case limits only after feasibility and ample checks pass.",
  "properties": {
    "ample_pilot": {
      "$ref": "#/$defs/AmplePilotSummary"
    },
    "counter_version": {
      "minLength": 1,
      "title": "Counter Version",
      "type": "string"
    },
    "freeze_status": {
      "$ref": "#/$defs/FreezeStatus"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "frozen_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen By"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "tight_limit_manifest_sha256": {
      "title": "Tight Limit Manifest Sha256",
      "type": "string"
    },
    "use_case_budgets": {
      "items": {
        "$ref": "#/$defs/UseCaseBudget"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Use Case Budgets",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "freeze_status",
    "counter_version",
    "tight_limit_manifest_sha256",
    "use_case_budgets",
    "ample_pilot",
    "manifest_sha256"
  ],
  "title": "WordBudgetManifest",
  "type": "object"
}
