{
  "$defs": {
    "PairDiagnostics": {
      "additionalProperties": false,
      "description": "Expose blinded descriptive pair-matching diagnostics without thresholds.",
      "properties": {
        "arithmetic_dependency": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Arithmetic Dependency",
          "type": "object"
        },
        "conditional_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Conditional Burden",
          "type": "object"
        },
        "hedging_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hedging Burden",
          "type": "object"
        },
        "numeric_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Numeric Burden",
          "type": "object"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "proposition_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Proposition Word Counts",
          "type": "object"
        },
        "readability": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Readability",
          "type": "object"
        },
        "shared_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Shared Quantities",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "proposition_word_counts",
        "numeric_burden",
        "conditional_burden",
        "hedging_burden",
        "readability",
        "arithmetic_dependency",
        "shared_quantities"
      ],
      "title": "PairDiagnostics",
      "type": "object"
    },
    "ResearcherFactReview": {
      "additionalProperties": false,
      "description": "Store the editable text, quantitative markers, and notes for one fact.",
      "properties": {
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        },
        "fact_text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Text",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_text",
        "specificity_markers"
      ],
      "title": "ResearcherFactReview",
      "type": "object"
    },
    "ReviewDecision": {
      "description": "Identify an automated or researcher scenario decision.",
      "enum": [
        "accept",
        "revise",
        "manual_restructure",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Store one researcher decision and the complete editable per-fact review.",
  "properties": {
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "fact_reviews": {
      "items": {
        "$ref": "#/$defs/ResearcherFactReview"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Fact Reviews",
      "type": "array"
    },
    "pair_diagnostics": {
      "items": {
        "$ref": "#/$defs/PairDiagnostics"
      },
      "maxItems": 2,
      "title": "Pair Diagnostics",
      "type": "array"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_artifact_sha256": {
      "title": "Reviewed Artifact Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "3.3.0",
        "3.4.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "anonymised_item_id",
    "scenario_id",
    "decision",
    "fact_reviews",
    "reviewed_artifact_sha256",
    "reviewed_at",
    "researcher_id"
  ],
  "title": "ResearcherScenarioReview",
  "type": "object"
}
