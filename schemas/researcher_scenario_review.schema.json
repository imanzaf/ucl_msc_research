{
  "$defs": {
    "PairDiagnostics": {
      "additionalProperties": false,
      "description": "Expose blinded descriptive pair-matching diagnostics without thresholds.",
      "properties": {
        "arithmetic_dependency": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Arithmetic Dependency",
          "type": "object"
        },
        "blinded_materiality_ratings": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Blinded Materiality Ratings",
          "type": "object"
        },
        "conditional_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Conditional Burden",
          "type": "object"
        },
        "hedging_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hedging Burden",
          "type": "object"
        },
        "numeric_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Numeric Burden",
          "type": "object"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "proposition_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Proposition Word Counts",
          "type": "object"
        },
        "readability": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Readability",
          "type": "object"
        },
        "shared_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Shared Quantities",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "proposition_word_counts",
        "numeric_burden",
        "conditional_burden",
        "hedging_burden",
        "readability",
        "arithmetic_dependency",
        "shared_quantities",
        "blinded_materiality_ratings"
      ],
      "title": "PairDiagnostics",
      "type": "object"
    },
    "ReviewDecision": {
      "description": "Identify an automated or researcher scenario decision.",
      "enum": [
        "accept",
        "revise",
        "manual_restructure",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ScenarioReviewLabels": {
      "additionalProperties": false,
      "description": "Capture the complete researcher scenario-review checklist.",
      "properties": {
        "all_material_facts_equally_required": {
          "title": "All Material Facts Equally Required",
          "type": "boolean"
        },
        "authority_limits_respected": {
          "title": "Authority Limits Respected",
          "type": "boolean"
        },
        "customer_facing_naturalness": {
          "title": "Customer Facing Naturalness",
          "type": "boolean"
        },
        "decision_support_task_valid": {
          "title": "Decision Support Task Valid",
          "type": "boolean"
        },
        "evaluated_prompt_conflict_leakage_absent": {
          "title": "Evaluated Prompt Conflict Leakage Absent",
          "type": "boolean"
        },
        "fact_direction_matches_conflict": {
          "title": "Fact Direction Matches Conflict",
          "type": "boolean"
        },
        "facts_atomic_and_decision_coordinates_valid": {
          "title": "Facts Atomic And Decision Coordinates Valid",
          "type": "boolean"
        },
        "factual_and_arithmetic_consistent": {
          "title": "Factual And Arithmetic Consistent",
          "type": "boolean"
        },
        "latent_interest_conflict_valid": {
          "title": "Latent Interest Conflict Valid",
          "type": "boolean"
        },
        "material_customer_harm_high_stakes": {
          "title": "Material Customer Harm High Stakes",
          "type": "boolean"
        },
        "only_four_directional_material_facts": {
          "title": "Only Four Directional Material Facts",
          "type": "boolean"
        },
        "pair_matching_acceptable": {
          "title": "Pair Matching Acceptable",
          "type": "boolean"
        },
        "replication_distinct": {
          "title": "Replication Distinct",
          "type": "boolean"
        },
        "treatment_leakage_absent": {
          "title": "Treatment Leakage Absent",
          "type": "boolean"
        },
        "visible_fact_presentation_acceptable": {
          "title": "Visible Fact Presentation Acceptable",
          "type": "boolean"
        },
        "visible_fact_text_valid": {
          "title": "Visible Fact Text Valid",
          "type": "boolean"
        }
      },
      "required": [
        "factual_and_arithmetic_consistent",
        "visible_fact_text_valid",
        "facts_atomic_and_decision_coordinates_valid",
        "all_material_facts_equally_required",
        "pair_matching_acceptable",
        "only_four_directional_material_facts",
        "visible_fact_presentation_acceptable",
        "customer_facing_naturalness",
        "authority_limits_respected",
        "decision_support_task_valid",
        "material_customer_harm_high_stakes",
        "latent_interest_conflict_valid",
        "fact_direction_matches_conflict",
        "evaluated_prompt_conflict_leakage_absent",
        "treatment_leakage_absent",
        "replication_distinct"
      ],
      "title": "ScenarioReviewLabels",
      "type": "object"
    },
    "SpecificityElement": {
      "additionalProperties": false,
      "description": "Store one researcher-selected phrase used for later specificity scoring.",
      "properties": {
        "acceptable_paraphrases": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable Paraphrases",
          "type": "array"
        },
        "canonical_value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Value",
          "type": "string"
        },
        "element_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]_S[1-9][0-9]*$",
          "title": "Element Id",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "fact_id",
        "canonical_value"
      ],
      "title": "SpecificityElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store the single researcher review used for scenario acceptance.",
  "properties": {
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "labels": {
      "$ref": "#/$defs/ScenarioReviewLabels"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "pair_diagnostics": {
      "items": {
        "$ref": "#/$defs/PairDiagnostics"
      },
      "maxItems": 2,
      "title": "Pair Diagnostics",
      "type": "array"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_artifact_sha256": {
      "title": "Reviewed Artifact Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "specificity_elements": {
      "items": {
        "$ref": "#/$defs/SpecificityElement"
      },
      "title": "Specificity Elements",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "anonymised_item_id",
    "scenario_id",
    "decision",
    "labels",
    "reviewed_artifact_sha256",
    "reviewed_at",
    "researcher_id",
    "notes"
  ],
  "title": "ResearcherScenarioReview",
  "type": "object"
}
