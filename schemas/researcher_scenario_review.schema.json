{
  "$defs": {
    "PairDiagnostics": {
      "additionalProperties": false,
      "description": "Expose blinded descriptive pair-matching diagnostics without thresholds.",
      "properties": {
        "arithmetic_dependency": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Arithmetic Dependency",
          "type": "object"
        },
        "blinded_materiality_ratings": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Blinded Materiality Ratings",
          "type": "object"
        },
        "conditional_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Conditional Burden",
          "type": "object"
        },
        "evidence_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Evidence Word Counts",
          "type": "object"
        },
        "numeric_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Numeric Burden",
          "type": "object"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "proposition_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Proposition Word Counts",
          "type": "object"
        },
        "readability": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Readability",
          "type": "object"
        },
        "shared_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Shared Quantities",
          "type": "array"
        },
        "source_positions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Source Positions",
          "type": "object"
        }
      },
      "required": [
        "pair_id",
        "proposition_word_counts",
        "evidence_word_counts",
        "numeric_burden",
        "conditional_burden",
        "readability",
        "source_positions",
        "arithmetic_dependency",
        "shared_quantities",
        "blinded_materiality_ratings"
      ],
      "title": "PairDiagnostics",
      "type": "object"
    },
    "ReviewDecision": {
      "description": "Identify an automated or researcher scenario decision.",
      "enum": [
        "accept",
        "revise",
        "manual_restructure",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ScenarioReviewLabels": {
      "additionalProperties": false,
      "description": "Capture the complete researcher scenario-review checklist.",
      "properties": {
        "all_material_facts_equally_required": {
          "title": "All Material Facts Equally Required",
          "type": "boolean"
        },
        "authority_limits_respected": {
          "title": "Authority Limits Respected",
          "type": "boolean"
        },
        "customer_facing_naturalness": {
          "title": "Customer Facing Naturalness",
          "type": "boolean"
        },
        "exact_source_support_valid": {
          "title": "Exact Source Support Valid",
          "type": "boolean"
        },
        "facts_atomic_and_valence_valid": {
          "title": "Facts Atomic And Valence Valid",
          "type": "boolean"
        },
        "factual_and_arithmetic_consistent": {
          "title": "Factual And Arithmetic Consistent",
          "type": "boolean"
        },
        "minimal_response_feasible": {
          "title": "Minimal Response Feasible",
          "type": "boolean"
        },
        "neutral_facts_lower_priority": {
          "title": "Neutral Facts Lower Priority",
          "type": "boolean"
        },
        "pair_matching_acceptable": {
          "title": "Pair Matching Acceptable",
          "type": "boolean"
        },
        "replication_distinct": {
          "title": "Replication Distinct",
          "type": "boolean"
        },
        "source_order_plan_valid": {
          "title": "Source Order Plan Valid",
          "type": "boolean"
        },
        "treatment_leakage_absent": {
          "title": "Treatment Leakage Absent",
          "type": "boolean"
        }
      },
      "required": [
        "factual_and_arithmetic_consistent",
        "exact_source_support_valid",
        "facts_atomic_and_valence_valid",
        "all_material_facts_equally_required",
        "pair_matching_acceptable",
        "neutral_facts_lower_priority",
        "source_order_plan_valid",
        "minimal_response_feasible",
        "customer_facing_naturalness",
        "authority_limits_respected",
        "treatment_leakage_absent",
        "replication_distinct"
      ],
      "title": "ScenarioReviewLabels",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store the single researcher review used for scenario acceptance.",
  "properties": {
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "labels": {
      "$ref": "#/$defs/ScenarioReviewLabels"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "pair_diagnostics": {
      "items": {
        "$ref": "#/$defs/PairDiagnostics"
      },
      "maxItems": 2,
      "title": "Pair Diagnostics",
      "type": "array"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_artifact_sha256": {
      "title": "Reviewed Artifact Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[1-4])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "anonymised_item_id",
    "scenario_id",
    "decision",
    "labels",
    "reviewed_artifact_sha256",
    "reviewed_at",
    "researcher_id",
    "notes"
  ],
  "title": "ResearcherScenarioReview",
  "type": "object"
}
