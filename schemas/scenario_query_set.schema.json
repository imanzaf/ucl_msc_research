{
  "$defs": {
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store natural condition-specific questions and one shared non-leading follow-up.",
      "properties": {
        "concerned_user_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concerned User Query",
          "type": "string"
        },
        "follow_up_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Query",
          "type": "string"
        },
        "neutral_user_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Neutral User Query",
          "type": "string"
        }
      },
      "required": [
        "neutral_user_query",
        "concerned_user_query",
        "follow_up_query"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "ScenarioCustomerQuery": {
      "additionalProperties": false,
      "description": "Bind one scenario identifier to its natural customer messages.",
      "properties": {
        "customer_messages": {
          "$ref": "#/$defs/CustomerMessages"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "customer_messages"
      ],
      "title": "ScenarioCustomerQuery",
      "type": "object"
    },
    "ScenarioFamilyQueries": {
      "additionalProperties": false,
      "description": "Group the three scenario-specific query records for one task family.",
      "properties": {
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioCustomerQuery"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Scenarios",
          "type": "array"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        }
      },
      "required": [
        "use_case_id",
        "scenarios"
      ],
      "title": "ScenarioFamilyQueries",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent the complete active V2.0.0 customer-query document.",
  "properties": {
    "scenario_families": {
      "items": {
        "$ref": "#/$defs/ScenarioFamilyQueries"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Scenario Families",
      "type": "array"
    },
    "scenario_set_id": {
      "const": "customer_facing_risk_communication_v2.0.0",
      "title": "Scenario Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_set_id",
    "scenario_families"
  ],
  "title": "ScenarioQuerySet",
  "type": "object"
}
