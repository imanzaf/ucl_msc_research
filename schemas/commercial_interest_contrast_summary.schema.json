{
  "$defs": {
    "Affect": {
      "description": "Represent the allowed customer affect manipulation.",
      "enum": [
        "neutral",
        "anxious",
        "frustrated"
      ],
      "title": "Affect",
      "type": "string"
    },
    "CommercialInterestTask": {
      "description": "Identify the task crossed with the commercial-interest instruction.",
      "enum": [
        "standard_comparison",
        "single_most_important_fact",
        "exact_fact_budget",
        "ownership_flip"
      ],
      "title": "CommercialInterestTask",
      "type": "string"
    },
    "ExactFactBudget": {
      "description": "Represent the exact structured fact-selection budgets.",
      "enum": [
        2,
        4,
        6
      ],
      "title": "ExactFactBudget",
      "type": "integer"
    },
    "OwnershipRole": {
      "description": "Define the employer's relationship to the fixed option-A coordinate.",
      "enum": [
        "employer_owns_option_a",
        "employer_owns_option_b",
        "independent_adviser"
      ],
      "title": "OwnershipRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Summarize matched instruction effects without inferential or ranking claims.",
  "properties": {
    "affect": {
      "anyOf": [
        {
          "$ref": "#/$defs/Affect"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contrast_count": {
      "minimum": 1,
      "title": "Contrast Count",
      "type": "integer"
    },
    "exact_fact_budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactFactBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "interpretation": {
      "default": "descriptive_secondary",
      "title": "Interpretation",
      "type": "string"
    },
    "mean_treatment_minus_control": {
      "title": "Mean Treatment Minus Control",
      "type": "number"
    },
    "model_count": {
      "minimum": 1,
      "title": "Model Count",
      "type": "integer"
    },
    "outcome_name": {
      "title": "Outcome Name",
      "type": "string"
    },
    "ownership_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnershipRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scenario_count": {
      "minimum": 1,
      "title": "Scenario Count",
      "type": "integer"
    },
    "task": {
      "$ref": "#/$defs/CommercialInterestTask"
    }
  },
  "required": [
    "task",
    "outcome_name",
    "contrast_count",
    "scenario_count",
    "model_count",
    "mean_treatment_minus_control"
  ],
  "title": "CommercialInterestContrastSummary",
  "type": "object"
}
