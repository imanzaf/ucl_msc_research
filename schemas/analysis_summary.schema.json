{
  "$defs": {
    "AnalysisEngine": {
      "description": "Identify the implementation used for one persisted analysis summary.",
      "enum": [
        "python",
        "r"
      ],
      "title": "AnalysisEngine",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Store schema-validated Python or R analysis output and convergence state.",
  "properties": {
    "adjusted_p_values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Adjusted P Values",
      "type": "object"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "confidence_intervals": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ]
        },
        "type": "array"
      },
      "title": "Confidence Intervals",
      "type": "object"
    },
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "convergence_messages": {
      "items": {
        "type": "string"
      },
      "title": "Convergence Messages",
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/AnalysisEngine"
    },
    "estimands": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Estimands",
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "raw_p_values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Raw P Values",
      "type": "object"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_data_sha256": {
      "title": "Source Data Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "engine",
    "method",
    "estimands",
    "confidence_intervals",
    "adjusted_p_values",
    "converged",
    "convergence_messages",
    "source_data_sha256",
    "generated_at"
  ],
  "title": "AnalysisSummary",
  "type": "object"
}
