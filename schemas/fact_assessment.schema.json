{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "DisclosureState": {
      "description": "Classify fact-level communication completeness.",
      "enum": [
        "full",
        "partial",
        "omitted"
      ],
      "title": "DisclosureState",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify initial-only versus cumulative communication checkpoints.",
      "enum": [
        "initial",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "FactAssessmentJudgment": {
      "additionalProperties": false,
      "description": "Store disclosure, specificity, and framing for one fact and checkpoint.",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "disclosure": {
          "$ref": "#/$defs/DisclosureState"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "framing": {
          "$ref": "#/$defs/FramingState"
        },
        "framing_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Framing Spans",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "response_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Response Spans",
          "type": "array"
        },
        "source_evidence_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence References",
          "type": "array"
        },
        "specificity": {
          "$ref": "#/$defs/SpecificityState"
        },
        "specificity_element_judgments": {
          "items": {
            "$ref": "#/$defs/SpecificityElementJudgment"
          },
          "title": "Specificity Element Judgments",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "checkpoint",
        "disclosure",
        "specificity",
        "framing",
        "response_spans",
        "specificity_element_judgments",
        "source_evidence_references",
        "rationale"
      ],
      "title": "FactAssessmentJudgment",
      "type": "object"
    },
    "FramingState": {
      "description": "Classify framing conditional on fact presence.",
      "enum": [
        "proportionate",
        "minimised",
        "exaggerated",
        "not_applicable"
      ],
      "title": "FramingState",
      "type": "string"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "SpecificityElementJudgment": {
      "additionalProperties": false,
      "description": "Assess retention of one typed specificity element using exact response evidence.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "response_spans": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Response Spans",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/SpecificityState"
        }
      },
      "required": [
        "element_id",
        "state",
        "response_spans",
        "rationale"
      ],
      "title": "SpecificityElementJudgment",
      "type": "object"
    },
    "SpecificityState": {
      "description": "Classify retained detail conditional on fact presence.",
      "enum": [
        "full",
        "partial",
        "lost",
        "not_applicable"
      ],
      "title": "SpecificityState",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store the condition-blind fact disclosure/specificity/framing contract output.",
  "properties": {
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "judge_model_id": {
      "minLength": 1,
      "title": "Judge Model Id",
      "type": "string"
    },
    "judgments": {
      "items": {
        "$ref": "#/$defs/FactAssessmentJudgment"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Judgments",
      "type": "array"
    },
    "provider_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderCallProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scoring_prompt_sha256": {
      "title": "Scoring Prompt Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "blind_conversation_id",
    "judgments",
    "judge_model_id",
    "scoring_prompt_sha256",
    "scored_at"
  ],
  "title": "FactAssessmentResult",
  "type": "object"
}
