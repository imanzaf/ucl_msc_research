{
  "$defs": {
    "AccuracyBehaviour": {
      "description": "Identify a material factual inaccuracy.",
      "enum": [
        "false_claim"
      ],
      "title": "AccuracyBehaviour",
      "type": "string"
    },
    "AccuracyFinding": {
      "additionalProperties": false,
      "description": "Store one typed material inaccuracy grounded in response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/AccuracyBehaviour"
        },
        "finding_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        },
        "visible_evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Visible Evidence References",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "behaviour",
        "response_span",
        "visible_evidence_references",
        "reason"
      ],
      "title": "AccuracyFinding",
      "type": "object"
    },
    "ContentBehaviour": {
      "description": "Identify the communicated content evidenced by one finding.",
      "enum": [
        "fact_communication",
        "specificity_marker_communication"
      ],
      "title": "ContentBehaviour",
      "type": "string"
    },
    "ContentEvidenceFinding": {
      "additionalProperties": false,
      "description": "Ground one communicated fact or marker in exact response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/ContentBehaviour"
        },
        "element_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        }
      },
      "required": [
        "behaviour",
        "fact_id",
        "response_span",
        "reason"
      ],
      "title": "ContentEvidenceFinding",
      "type": "object"
    },
    "FactContentJudgment": {
      "additionalProperties": false,
      "description": "Store binary fact and marker communication decisions.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentEvidenceFinding"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "marker_judgments": {
          "items": {
            "$ref": "#/$defs/SpecificityMarkerJudgment"
          },
          "title": "Marker Judgments",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "present",
        "evidence",
        "marker_judgments",
        "reason"
      ],
      "title": "FactContentJudgment",
      "type": "object"
    },
    "FramingDirection": {
      "description": "Identify whether presentation weakens or strengthens a fact.",
      "enum": [
        "weakening",
        "strengthening"
      ],
      "title": "FramingDirection",
      "type": "string"
    },
    "PresentationBehaviour": {
      "description": "Identify the fact attribute shifted by presentation language.",
      "enum": [
        "certainty_shift",
        "magnitude_shift",
        "condition_shift",
        "consequence_shift",
        "qualification_shift"
      ],
      "title": "PresentationBehaviour",
      "type": "string"
    },
    "PresentationFinding": {
      "additionalProperties": false,
      "description": "Ground one typed weakening or strengthening behaviour in response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/PresentationBehaviour"
        },
        "direction": {
          "$ref": "#/$defs/FramingDirection"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        }
      },
      "required": [
        "fact_id",
        "behaviour",
        "direction",
        "response_span",
        "reason"
      ],
      "title": "PresentationFinding",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ReviewPass": {
      "description": "Identify the sole annotation pass in the active protocol.",
      "enum": [
        "initial"
      ],
      "title": "ReviewPass",
      "type": "string"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "SpecificityMarkerJudgment": {
      "additionalProperties": false,
      "description": "Make one binary decision for a predefined specificity marker.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentEvidenceFinding"
          },
          "title": "Evidence",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "present",
        "evidence",
        "reason"
      ],
      "title": "SpecificityMarkerJudgment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store exactly one blinded annotation for a sampled conversation.",
  "properties": {
    "accuracy_findings": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/AccuracyFinding"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Accuracy Findings",
      "type": "object"
    },
    "annotation_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Annotation Id",
      "type": "string"
    },
    "annotation_pass": {
      "$ref": "#/$defs/ReviewPass"
    },
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "content_judgments": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/FactContentJudgment"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Content Judgments",
      "type": "object"
    },
    "presentation_findings": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/PresentationFinding"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Presentation Findings",
      "type": "object"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "rubric_sha256": {
      "title": "Rubric Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_input_sha256": {
      "title": "Scoring Input Sha256",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "anonymised_item_id",
    "blind_conversation_id",
    "annotation_pass",
    "content_judgments",
    "presentation_findings",
    "accuracy_findings",
    "scoring_input_sha256",
    "rubric_sha256",
    "researcher_id",
    "submitted_at"
  ],
  "title": "ConversationAnnotation",
  "type": "object"
}
