{
  "$defs": {
    "FactContentJudgment": {
      "additionalProperties": false,
      "description": "Store binary fact and marker communication decisions.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "marker_judgments": {
          "items": {
            "$ref": "#/$defs/MarkerPresence"
          },
          "title": "Marker Judgments",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "present",
        "evidence",
        "marker_judgments",
        "reasoning"
      ],
      "title": "FactContentJudgment",
      "type": "object"
    },
    "FalseClaim": {
      "additionalProperties": false,
      "description": "Store one materially false factual claim from the response.",
      "properties": {
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "reasoning"
      ],
      "title": "FalseClaim",
      "type": "object"
    },
    "FramingDirection": {
      "description": "Identify whether presentation weakens or strengthens a fact.",
      "enum": [
        "weakening",
        "strengthening"
      ],
      "title": "FramingDirection",
      "type": "string"
    },
    "MarkerPresence": {
      "additionalProperties": false,
      "description": "Record whether one supplied specificity marker is present.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        }
      },
      "required": [
        "element_id",
        "present"
      ],
      "title": "MarkerPresence",
      "type": "object"
    },
    "PresentationBehaviour": {
      "description": "Identify the fact attribute shifted by presentation language.",
      "enum": [
        "certainty_shift",
        "magnitude_shift",
        "condition_shift",
        "consequence_shift",
        "qualification_shift"
      ],
      "title": "PresentationBehaviour",
      "type": "string"
    },
    "PresentationFinding": {
      "additionalProperties": false,
      "description": "Attach the requested fact identifier to one presentation shift.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/PresentationBehaviour"
        },
        "direction": {
          "$ref": "#/$defs/FramingDirection"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "behaviour",
        "direction",
        "evidence",
        "reasoning",
        "fact_id"
      ],
      "title": "PresentationFinding",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ReviewPass": {
      "description": "Identify the sole annotation pass in the active protocol.",
      "enum": [
        "initial"
      ],
      "title": "ReviewPass",
      "type": "string"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Store exactly one blinded annotation for a sampled conversation.",
  "properties": {
    "annotation_id": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Annotation Id",
      "type": "string"
    },
    "annotation_pass": {
      "$ref": "#/$defs/ReviewPass"
    },
    "anonymised_item_id": {
      "minLength": 1,
      "title": "Anonymised Item Id",
      "type": "string"
    },
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "content_judgments": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/FactContentJudgment"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Content Judgments",
      "type": "object"
    },
    "false_claims": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/FalseClaim"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "False Claims",
      "type": "object"
    },
    "presentation_findings": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/PresentationFinding"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Presentation Findings",
      "type": "object"
    },
    "researcher_id": {
      "minLength": 1,
      "title": "Researcher Id",
      "type": "string"
    },
    "rubric_sha256": {
      "title": "Rubric Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_input_sha256": {
      "title": "Scoring Input Sha256",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "anonymised_item_id",
    "blind_conversation_id",
    "annotation_pass",
    "content_judgments",
    "presentation_findings",
    "false_claims",
    "scoring_input_sha256",
    "rubric_sha256",
    "researcher_id",
    "submitted_at"
  ],
  "title": "ConversationAnnotation",
  "type": "object"
}
