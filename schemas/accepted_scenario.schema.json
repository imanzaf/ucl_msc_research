{
  "$defs": {
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store the natural initial question and non-leading follow-up shown to the assistant.",
      "properties": {
        "follow_up_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Message",
          "type": "string"
        },
        "initial_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Initial Message",
          "type": "string"
        }
      },
      "required": [
        "initial_message",
        "follow_up_message"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DecisionOption": {
      "description": "Identify which hidden decision option a material fact describes.",
      "enum": [
        "owner_option",
        "customer_option"
      ],
      "title": "DecisionOption",
      "type": "string"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "FactPair": {
      "additionalProperties": false,
      "description": "Represent one polarity-matched provider/customer option comparison.",
      "properties": {
        "customer_option_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Customer Option Fact Id",
          "type": "string"
        },
        "matching_rationale": {
          "minLength": 1,
          "title": "Matching Rationale",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "pair_type": {
          "$ref": "#/$defs/FactPairType"
        },
        "provider_option_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Provider Option Fact Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "pair_type",
        "provider_option_fact_id",
        "customer_option_fact_id",
        "matching_rationale"
      ],
      "title": "FactPair",
      "type": "object"
    },
    "FactPairType": {
      "description": "Identify the two polarity-matched fact comparisons.",
      "enum": [
        "benefit_comparison",
        "downside_comparison"
      ],
      "title": "FactPairType",
      "type": "string"
    },
    "FactPolarity": {
      "description": "Identify whether a material fact is a benefit or downside of its option.",
      "enum": [
        "benefit",
        "downside"
      ],
      "title": "FactPolarity",
      "type": "string"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "savings support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "MaterialFact": {
      "additionalProperties": false,
      "description": "Represent one equally required decision-material fact.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        },
        "materiality_rating": {
          "maximum": 4,
          "minimum": 1,
          "title": "Materiality Rating",
          "type": "integer"
        },
        "materiality_rationale": {
          "minLength": 1,
          "title": "Materiality Rationale",
          "type": "string"
        },
        "option": {
          "$ref": "#/$defs/DecisionOption"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/FactPolarity"
        },
        "required_in_complete_response": {
          "title": "Required In Complete Response",
          "type": "boolean"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "option",
        "polarity",
        "canonical_proposition",
        "materiality_rationale",
        "required_in_complete_response",
        "materiality_rating"
      ],
      "title": "MaterialFact",
      "type": "object"
    },
    "OptionDescription": {
      "additionalProperties": false,
      "description": "Store one neutral generated description for a seed-owned option.",
      "properties": {
        "description": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        }
      },
      "required": [
        "option_id",
        "description"
      ],
      "title": "OptionDescription",
      "type": "object"
    },
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    },
    "SeedOptionId": {
      "description": "Identify one neutrally labelled option in a generation seed.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SeedOptionId",
      "type": "string"
    },
    "SpecificityElement": {
      "additionalProperties": false,
      "description": "Store one researcher-selected phrase used for later specificity scoring.",
      "properties": {
        "acceptable_paraphrases": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable Paraphrases",
          "type": "array"
        },
        "canonical_value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Value",
          "type": "string"
        },
        "element_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]_S[1-9][0-9]*$",
          "title": "Element Id",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "fact_id",
        "canonical_value"
      ],
      "title": "SpecificityElement",
      "type": "object"
    },
    "V11HiddenDesign": {
      "additionalProperties": false,
      "description": "Store one decision's research-only ownership mapping and display order.",
      "properties": {
        "customer_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "decision_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Type",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/V11OptionDefinition"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "owner_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Benefit Mechanism",
          "type": "string"
        },
        "owner_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "presentation_order": {
          "items": {
            "$ref": "#/$defs/SeedOptionId"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Presentation Order",
          "type": "array"
        }
      },
      "required": [
        "decision_type",
        "options",
        "customer_supporting_option",
        "owner_supporting_option",
        "owner_benefit_mechanism",
        "presentation_order"
      ],
      "title": "V11HiddenDesign",
      "type": "object"
    },
    "V11OptionDefinition": {
      "additionalProperties": false,
      "description": "Name one neutral decision option supplied to the fact generator.",
      "properties": {
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name"
      ],
      "title": "V11OptionDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent the only scenario artifact accepted by evaluation loaders.",
  "properties": {
    "acceptance_record_sha256": {
      "title": "Acceptance Record Sha256",
      "type": "string"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "accepted_by": {
      "minLength": 1,
      "title": "Accepted By",
      "type": "string"
    },
    "artifact_sha256": {
      "title": "Artifact Sha256",
      "type": "string"
    },
    "artifact_version": {
      "pattern": "^v[1-9][0-9]*$",
      "title": "Artifact Version",
      "type": "string"
    },
    "customer_messages": {
      "$ref": "#/$defs/CustomerMessages"
    },
    "deployment_context": {
      "$ref": "#/$defs/DeploymentContext"
    },
    "fact_pairs": {
      "items": {
        "$ref": "#/$defs/FactPair"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Fact Pairs",
      "type": "array"
    },
    "hidden_design": {
      "$ref": "#/$defs/V11HiddenDesign"
    },
    "material_facts": {
      "items": {
        "$ref": "#/$defs/MaterialFact"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Material Facts",
      "type": "array"
    },
    "option_descriptions": {
      "items": {
        "$ref": "#/$defs/OptionDescription"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Option Descriptions",
      "type": "array"
    },
    "review_history_sha256": {
      "title": "Review History Sha256",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "4.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "specificity_elements": {
      "items": {
        "$ref": "#/$defs/SpecificityElement"
      },
      "title": "Specificity Elements",
      "type": "array"
    },
    "study_stage": {
      "$ref": "#/$defs/ScenarioStage"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_version",
    "scenario_id",
    "use_case_id",
    "study_stage",
    "deployment_context",
    "customer_messages",
    "hidden_design",
    "option_descriptions",
    "material_facts",
    "fact_pairs",
    "review_history_sha256",
    "acceptance_record_sha256",
    "accepted_at",
    "accepted_by",
    "artifact_sha256"
  ],
  "title": "AcceptedScenario",
  "type": "object"
}
