{
  "$defs": {
    "ComputedNumericValue": {
      "additionalProperties": false,
      "description": "Store a deterministic result and its dependency identifiers.",
      "properties": {
        "calculation": {
          "$ref": "#/$defs/NumericCalculation"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "value_id": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Value Id",
          "type": "string"
        }
      },
      "required": [
        "value_id",
        "value",
        "unit",
        "calculation"
      ],
      "title": "ComputedNumericValue",
      "type": "object"
    },
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store the natural initial question and non-leading follow-up shown to the assistant.",
      "properties": {
        "follow_up_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Message",
          "type": "string"
        },
        "initial_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Initial Message",
          "type": "string"
        }
      },
      "required": [
        "initial_message",
        "follow_up_message"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DecisionConflict": {
      "additionalProperties": false,
      "description": "Record the latent customer/provider conflict excluded from evaluated prompts.",
      "properties": {
        "customer_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Aligned Action",
          "type": "string"
        },
        "customer_objective_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Objective Basis",
          "type": "string"
        },
        "decision_horizon": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Horizon",
          "type": "string"
        },
        "financial_stake": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Financial Stake",
          "type": "string"
        },
        "material_customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Material Customer Harm",
          "type": "string"
        },
        "provider_aligned_action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Aligned Action",
          "type": "string"
        },
        "provider_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Benefit Mechanism",
          "type": "string"
        }
      },
      "required": [
        "customer_aligned_action",
        "provider_aligned_action",
        "customer_objective_basis",
        "provider_benefit_mechanism",
        "material_customer_harm",
        "decision_horizon",
        "financial_stake"
      ],
      "title": "DecisionConflict",
      "type": "object"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "DiagnosticDesign": {
      "additionalProperties": false,
      "description": "Store hidden matched-pair requirements used to validate the communication construct.",
      "properties": {
        "material_fact_pair_briefs": {
          "items": {
            "$ref": "#/$defs/MaterialFactPairBriefSeed"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Material Fact Pair Briefs",
          "type": "array"
        }
      },
      "required": [
        "material_fact_pair_briefs"
      ],
      "title": "DiagnosticDesign",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Locate an exact support span within one rendered source item.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Source Item Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source_item_id",
        "start_char",
        "end_char",
        "exact_text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FactPair": {
      "additionalProperties": false,
      "description": "Represent one matched adverse/favourable comparison pair.",
      "properties": {
        "adverse_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Adverse Fact Id",
          "type": "string"
        },
        "favourable_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Favourable Fact Id",
          "type": "string"
        },
        "matching_rationale": {
          "minLength": 1,
          "title": "Matching Rationale",
          "type": "string"
        },
        "pair_balance_score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Pair Balance Score"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "adverse_fact_id",
        "favourable_fact_id",
        "matching_rationale",
        "pair_balance_score"
      ],
      "title": "FactPair",
      "type": "object"
    },
    "FactValence": {
      "description": "Identify material-fact valence without encoding it in visible sources.",
      "enum": [
        "adverse",
        "favourable"
      ],
      "title": "FactValence",
      "type": "string"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "MaterialFact": {
      "additionalProperties": false,
      "description": "Represent one equally required decision-material fact.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        },
        "materiality_rating": {
          "maximum": 4,
          "minimum": 1,
          "title": "Materiality Rating",
          "type": "integer"
        },
        "materiality_rationale": {
          "minLength": 1,
          "title": "Materiality Rationale",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "required_in_complete_response": {
          "title": "Required In Complete Response",
          "type": "boolean"
        },
        "source_support": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Source Support",
          "type": "array"
        },
        "specificity_elements": {
          "items": {
            "$ref": "#/$defs/SpecificityElement"
          },
          "title": "Specificity Elements",
          "type": "array"
        },
        "valence": {
          "$ref": "#/$defs/FactValence"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "valence",
        "canonical_proposition",
        "materiality_rationale",
        "required_in_complete_response",
        "materiality_rating",
        "source_support",
        "specificity_elements"
      ],
      "title": "MaterialFact",
      "type": "object"
    },
    "MaterialFactPairBriefSeed": {
      "additionalProperties": false,
      "description": "Represent one researcher-owned adverse/favourable pair brief.",
      "properties": {
        "adverse_theme": {
          "minLength": 1,
          "title": "Adverse Theme",
          "type": "string"
        },
        "favorable_theme": {
          "minLength": 1,
          "title": "Favorable Theme",
          "type": "string"
        },
        "matching_requirements": {
          "minLength": 1,
          "title": "Matching Requirements",
          "type": "string"
        },
        "pair_slot": {
          "$ref": "#/$defs/PairSlot"
        }
      },
      "required": [
        "pair_slot",
        "adverse_theme",
        "favorable_theme",
        "matching_requirements"
      ],
      "title": "MaterialFactPairBriefSeed",
      "type": "object"
    },
    "MinimalCompleteResponse": {
      "additionalProperties": false,
      "description": "Store the approved facts-only feasibility response and frozen word count.",
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "covered_fact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Covered Fact Ids",
          "type": "array"
        },
        "covered_specificity_element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Covered Specificity Element Ids",
          "type": "array"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^2\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "word_count": {
          "exclusiveMinimum": 0,
          "title": "Word Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "text",
        "word_count",
        "covered_fact_ids",
        "covered_specificity_element_ids",
        "approved",
        "text_sha256"
      ],
      "title": "MinimalCompleteResponse",
      "type": "object"
    },
    "NeutralFact": {
      "additionalProperties": false,
      "description": "Represent one lower-priority source-supported neutral fact.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_N[1-2]$",
          "title": "Fact Id",
          "type": "string"
        },
        "neutral_status_rationale": {
          "minLength": 1,
          "title": "Neutral Status Rationale",
          "type": "string"
        },
        "source_support": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Source Support",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "canonical_proposition",
        "neutral_status_rationale",
        "source_support"
      ],
      "title": "NeutralFact",
      "type": "object"
    },
    "NumericCalculation": {
      "additionalProperties": false,
      "description": "Define one deterministic calculation over registered values.",
      "properties": {
        "decimal_places": {
          "default": 2,
          "maximum": 8,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "expected_unit": {
          "minLength": 1,
          "title": "Expected Unit",
          "type": "string"
        },
        "operand_value_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Operand Value Ids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/NumericOperation"
        },
        "output_value_id": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Output Value Id",
          "type": "string"
        }
      },
      "required": [
        "output_value_id",
        "operation",
        "operand_value_ids",
        "expected_unit"
      ],
      "title": "NumericCalculation",
      "type": "object"
    },
    "NumericInput": {
      "additionalProperties": false,
      "description": "Represent one typed input to deterministic arithmetic.",
      "properties": {
        "source_note": {
          "minLength": 1,
          "title": "Source Note",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "value_id": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Value Id",
          "type": "string"
        }
      },
      "required": [
        "value_id",
        "value",
        "unit",
        "source_note"
      ],
      "title": "NumericInput",
      "type": "object"
    },
    "NumericOperation": {
      "description": "Identify deterministic arithmetic supported by the numeric engine.",
      "enum": [
        "add",
        "subtract",
        "multiply",
        "divide",
        "percentage_change",
        "annualised_total"
      ],
      "title": "NumericOperation",
      "type": "string"
    },
    "NumericRegistry": {
      "additionalProperties": false,
      "description": "Collect raw and computed numeric values for one scenario.",
      "properties": {
        "calculations": {
          "items": {
            "$ref": "#/$defs/NumericCalculation"
          },
          "title": "Calculations",
          "type": "array"
        },
        "computed_values": {
          "items": {
            "$ref": "#/$defs/ComputedNumericValue"
          },
          "title": "Computed Values",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/NumericInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "schema_version": {
          "pattern": "^2\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "inputs",
        "calculations",
        "computed_values"
      ],
      "title": "NumericRegistry",
      "type": "object"
    },
    "PairSlot": {
      "description": "Identify one of the two matched material-fact pairs.",
      "enum": [
        "P1",
        "P2"
      ],
      "title": "PairSlot",
      "type": "string"
    },
    "ResearchMetadata": {
      "additionalProperties": false,
      "description": "Store hidden decision-ground-truth metadata used for design and review.",
      "properties": {
        "customer_goal": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Goal",
          "type": "string"
        },
        "decision_conflict": {
          "$ref": "#/$defs/DecisionConflict"
        }
      },
      "required": [
        "customer_goal",
        "decision_conflict"
      ],
      "title": "ResearchMetadata",
      "type": "object"
    },
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    },
    "SourceFormat": {
      "description": "Identify one active deterministic V0.7.0 source presentation.",
      "enum": [
        "overdraft_decision_statement",
        "lifetime_mortgage_illustration",
        "transfer_offer_comparison",
        "consolidation_decision_illustration",
        "mortgage_retention_comparison",
        "difficulty_support_comparison",
        "fund_switch_comparison",
        "retirement_income_comparison",
        "claim_settlement_comparison",
        "international_payment_comparison"
      ],
      "title": "SourceFormat",
      "type": "string"
    },
    "SourceItem": {
      "additionalProperties": false,
      "description": "Represent one stable item in the evaluated model's visible packet.",
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "header": {
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "numeric_value_ids": {
          "items": {
            "type": "string"
          },
          "title": "Numeric Value Ids",
          "type": "array"
        },
        "source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "source_item_id",
        "header",
        "body"
      ],
      "title": "SourceItem",
      "type": "object"
    },
    "SourceItemPair": {
      "additionalProperties": false,
      "description": "Identify one adverse/favourable source-item pair for a later order study.",
      "properties": {
        "adverse_source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Adverse Source Item Id",
          "type": "string"
        },
        "favourable_source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Favourable Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "adverse_source_item_id",
        "favourable_source_item_id"
      ],
      "title": "SourceItemPair",
      "type": "object"
    },
    "SourceOrderPlan": {
      "additionalProperties": false,
      "description": "Store hidden material/neutral item grouping for canonical-rendering validation.",
      "properties": {
        "material_item_pairs": {
          "items": {
            "$ref": "#/$defs/SourceItemPair"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Material Item Pairs",
          "type": "array"
        },
        "neutral_source_item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Neutral Source Item Ids",
          "type": "array"
        },
        "schema_version": {
          "pattern": "^2\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "material_item_pairs",
        "neutral_source_item_ids"
      ],
      "title": "SourceOrderPlan",
      "type": "object"
    },
    "SourceOrderVariant": {
      "description": "Identify the frozen canonical source order.",
      "enum": [
        "A",
        "B"
      ],
      "title": "SourceOrderVariant",
      "type": "string"
    },
    "SourcePacket": {
      "additionalProperties": false,
      "description": "Represent one deterministic source-order rendering.",
      "properties": {
        "fixed_title": {
          "minLength": 1,
          "title": "Fixed Title",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SourceItem"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Items",
          "type": "array"
        },
        "rendered_sha256": {
          "title": "Rendered Sha256",
          "type": "string"
        },
        "rendered_text": {
          "minLength": 1,
          "title": "Rendered Text",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[12]\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormat"
        },
        "source_order": {
          "$ref": "#/$defs/SourceOrderVariant"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "source_order",
        "fixed_title",
        "source_format",
        "items",
        "rendered_text",
        "rendered_sha256"
      ],
      "title": "SourcePacket",
      "type": "object"
    },
    "SpecificityElement": {
      "additionalProperties": false,
      "description": "Represent one essential or optional fact detail with equivalence rules.",
      "properties": {
        "acceptable_paraphrases": {
          "items": {
            "type": "string"
          },
          "title": "Acceptable Paraphrases",
          "type": "array"
        },
        "canonical_value": {
          "minLength": 1,
          "title": "Canonical Value",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "element_type": {
          "$ref": "#/$defs/SpecificityElementType"
        },
        "essential": {
          "title": "Essential",
          "type": "boolean"
        },
        "numeric_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Tolerance"
        },
        "unit": {
