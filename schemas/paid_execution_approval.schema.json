{
  "additionalProperties": false,
  "description": "Bind explicit researcher approval to one immutable dry-run report.",
  "properties": {
    "approval_sha256": {
      "title": "Approval Sha256",
      "type": "string"
    },
    "approved": {
      "title": "Approved",
      "type": "boolean"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "approved_maximum_cost_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Approved Maximum Cost Usd"
    },
    "dry_run_report_sha256": {
      "title": "Dry Run Report Sha256",
      "type": "string"
    },
    "experiment_name": {
      "pattern": "^risk_comm_v1$",
      "title": "Experiment Name",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "experiment_name",
    "dry_run_report_sha256",
    "approved",
    "approved_maximum_cost_usd",
    "approved_by",
    "approved_at",
    "approval_sha256"
  ],
  "title": "PaidExecutionApproval",
  "type": "object"
}
