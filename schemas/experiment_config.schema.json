{
  "$defs": {
    "ExperimentName": {
      "description": "Identify one independently manifested conversation experiment.",
      "enum": [
        "risk_comm_v1",
        "material_priority_v1",
        "brevity_locus_v1"
      ],
      "title": "ExperimentName",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Freeze retry count and backoff while prohibiting prompt mutation.",
      "properties": {
        "backoff_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Backoff Seconds",
          "type": "array"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "reuse_identical_prompt_bytes": {
          "default": true,
          "title": "Reuse Identical Prompt Bytes",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_seconds"
      ],
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Snapshot the risk_comm_v1 execution contract before a run starts.",
  "properties": {
    "cell_count": {
      "default": 4,
      "title": "Cell Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluated_model_count": {
      "default": 3,
      "title": "Evaluated Model Count",
      "type": "integer"
    },
    "expected_agent_response_count": {
      "default": 480,
      "title": "Expected Agent Response Count",
      "type": "integer"
    },
    "expected_conversation_count": {
      "default": 240,
      "title": "Expected Conversation Count",
      "type": "integer"
    },
    "experiment_manifest_sha256": {
      "title": "Experiment Manifest Sha256",
      "type": "string"
    },
    "experiment_name": {
      "$ref": "#/$defs/ExperimentName"
    },
    "randomisation_seed": {
      "title": "Randomisation Seed",
      "type": "integer"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "scenario_count": {
      "default": 20,
      "title": "Scenario Count",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "temperature": {
      "default": 0.0,
      "maximum": 0.0,
      "minimum": 0.0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "experiment_name",
    "experiment_manifest_sha256",
    "randomisation_seed",
    "retry_policy",
    "created_at"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
