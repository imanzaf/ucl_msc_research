{
  "$defs": {
    "AcceptedScenarioEntry": {
      "additionalProperties": false,
      "description": "Record one immutable accepted scenario in a scenario-set manifest.",
      "properties": {
        "acceptance_record_sha256": {
          "title": "Acceptance Record Sha256",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "review_history_sha256": {
          "title": "Review History Sha256",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "study_stage": {
          "$ref": "#/$defs/ScenarioStage"
        }
      },
      "required": [
        "scenario_id",
        "study_stage",
        "artifact_path",
        "artifact_sha256",
        "review_history_sha256",
        "acceptance_record_sha256"
      ],
      "title": "AcceptedScenarioEntry",
      "type": "object"
    },
    "AcceptedScenarioSetId": {
      "description": "Identify the active accepted scenario family.",
      "enum": [
        "customer_facing_risk_communication_v1.0.0"
      ],
      "title": "AcceptedScenarioSetId",
      "type": "string"
    },
    "ScenarioManifestScope": {
      "description": "Identify a calibration-only checkpoint versus the final complete scenario set.",
      "enum": [
        "calibration",
        "complete"
      ],
      "title": "ScenarioManifestScope",
      "type": "string"
    },
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Publish the accepted-only scenario set with seed provenance.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/AcceptedScenarioEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "manifest_scope": {
      "$ref": "#/$defs/ScenarioManifestScope"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "published_by": {
      "minLength": 1,
      "title": "Published By",
      "type": "string"
    },
    "scenario_set_id": {
      "$ref": "#/$defs/AcceptedScenarioSetId"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_schema_sha256": {
      "title": "Seed Schema Sha256",
      "type": "string"
    },
    "seed_sha256": {
      "title": "Seed Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_set_id",
    "manifest_scope",
    "seed_sha256",
    "seed_schema_sha256",
    "entries",
    "published_at",
    "published_by",
    "manifest_sha256"
  ],
  "title": "AcceptedScenarioManifest",
  "type": "object"
}
