{
  "additionalProperties": false,
  "description": "Record the acyclic researcher acceptance decision before publishing an accepted artifact.",
  "properties": {
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "accepted_by": {
      "minLength": 1,
      "title": "Accepted By",
      "type": "string"
    },
    "artifact_version": {
      "pattern": "^v[1-9][0-9]*$",
      "title": "Artifact Version",
      "type": "string"
    },
    "candidate_sha256": {
      "title": "Candidate Sha256",
      "type": "string"
    },
    "record_sha256": {
      "title": "Record Sha256",
      "type": "string"
    },
    "review_history_sha256": {
      "title": "Review History Sha256",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[1-4])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "artifact_version",
    "candidate_sha256",
    "review_history_sha256",
    "accepted_at",
    "accepted_by",
    "record_sha256"
  ],
  "title": "ScenarioAcceptanceRecord",
  "type": "object"
}
