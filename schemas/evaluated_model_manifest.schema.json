{
  "$defs": {
    "EvaluatedModelSnapshot": {
      "additionalProperties": false,
      "description": "Freeze one evaluated model and its provider-returned identity.",
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "metadata_sha256": {
          "title": "Metadata Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "weight_type": {
          "$ref": "#/$defs/ModelWeightType"
        }
      },
      "required": [
        "name",
        "model_id",
        "returned_model_version",
        "family",
        "provider",
        "weight_type",
        "metadata_sha256",
        "frozen_at"
      ],
      "title": "EvaluatedModelSnapshot",
      "type": "object"
    },
    "FreezeStatus": {
      "description": "Identify whether a manifest remains draft or is immutable for downstream use.",
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "FreezeStatus",
      "type": "string"
    },
    "ModelWeightType": {
      "description": "Identify open- versus closed-weight evaluated model families.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "ModelWeightType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Freeze exactly three evaluated snapshots before model-generated calibration.",
  "properties": {
    "evaluated_models": {
      "items": {
        "$ref": "#/$defs/EvaluatedModelSnapshot"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Evaluated Models",
      "type": "array"
    },
    "freeze_status": {
      "$ref": "#/$defs/FreezeStatus"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "frozen_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen By"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_judge_model_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scoring Judge Model Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "freeze_status",
    "evaluated_models",
    "scoring_judge_model_ids",
    "manifest_sha256"
  ],
  "title": "EvaluatedModelManifest",
  "type": "object"
}
