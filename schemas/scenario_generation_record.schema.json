{
  "$defs": {
    "GeneratedFact": {
      "additionalProperties": false,
      "description": "Represent one direction-free visible fact returned by the generator.",
      "properties": {
        "anchor": {
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^[A-Z0-9_]+_F[1-6]$",
          "title": "Fact Id",
          "type": "string"
        },
        "option_id": {
          "pattern": "^OPTION_[AB]$",
          "title": "Option Id",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^[A-Z0-9_]+_P[1-3]$",
          "title": "Pair Id",
          "type": "string"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "option_id",
        "text",
        "anchor"
      ],
      "title": "GeneratedFact",
      "type": "object"
    },
    "GeneratedScenarioOutput": {
      "additionalProperties": false,
      "description": "Represent the generator's single semantic output for one scenario.",
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/GeneratedFact"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Facts",
          "type": "array"
        },
        "scenario_id": {
          "pattern": "^[A-Z]{2,3}[0-9]{3}_R[1-5]$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "facts"
      ],
      "title": "GeneratedScenarioOutput",
      "type": "object"
    },
    "GenerationControls": {
      "additionalProperties": false,
      "description": "Freeze every effective model-native generation parameter.",
      "properties": {
        "extra_parameters": {
          "additionalProperties": true,
          "title": "Extra Parameters",
          "type": "object"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "GenerationControls",
      "type": "object"
    },
    "LicenceCategory": {
      "description": "Freeze the model-weight licence category reported in metadata.",
      "enum": [
        "community_licence",
        "apache_2_0",
        "mit",
        "proprietary"
      ],
      "title": "LicenceCategory",
      "type": "string"
    },
    "ModelAccess": {
      "description": "Classify model access without treating it as a causal attribute.",
      "enum": [
        "open_weight",
        "closed"
      ],
      "title": "ModelAccess",
      "type": "string"
    },
    "ProviderSnapshot": {
      "additionalProperties": false,
      "description": "Bind a run to one frozen model, gateway, and routing-policy snapshot.",
      "properties": {
        "active_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Parameters"
        },
        "licence_category": {
          "$ref": "#/$defs/LicenceCategory"
        },
        "metadata_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Snapshot Sha256",
          "type": "string"
        },
        "model_access": {
          "$ref": "#/$defs/ModelAccess"
        },
        "model_slug": {
          "minLength": 3,
          "title": "Model Slug",
          "type": "string"
        },
        "preflight_passed": {
          "default": false,
          "title": "Preflight Passed",
          "type": "boolean"
        },
        "provider_endpoint": {
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "routing_policy": {
          "minLength": 1,
          "title": "Routing Policy",
          "type": "string"
        },
        "schema_version": {
          "default": "4.0.0",
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_parameters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Parameters"
        }
      },
      "required": [
        "model_slug",
        "model_access",
        "licence_category",
        "provider_name",
        "provider_endpoint",
        "routing_policy",
        "metadata_snapshot_sha256"
      ],
      "title": "ProviderSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Retain one semantic generator response whether or not it validates.",
  "properties": {
    "attempts": {
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "billed_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Billed Cost"
    },
    "calculated_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Calculated Cost"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "generated_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratedScenarioOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation_controls": {
      "$ref": "#/$defs/GenerationControls"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model": {
      "$ref": "#/$defs/ProviderSnapshot"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider_request_id": {
      "title": "Provider Request Id",
      "type": "string"
    },
    "raw_response": {
      "title": "Raw Response",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "returned_model_version": {
      "title": "Returned Model Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "structurally_valid": {
      "title": "Structurally Valid",
      "type": "boolean"
    },
    "validation_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Error"
    }
  },
  "required": [
    "request_id",
    "request_sha256",
    "scenario_id",
    "model",
    "generation_controls",
    "provider_request_id",
    "returned_model_version",
    "raw_response",
    "structurally_valid",
    "input_tokens",
    "output_tokens",
    "calculated_cost",
    "received_at",
    "attempts"
  ],
  "title": "ScenarioGenerationRecord",
  "type": "object"
}
