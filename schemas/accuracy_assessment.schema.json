{
  "$defs": {
    "AccuracyBehaviour": {
      "description": "Identify one type of material factual inaccuracy.",
      "enum": [
        "false_claim",
        "unsupported_claim"
      ],
      "title": "AccuracyBehaviour",
      "type": "string"
    },
    "AccuracyFinding": {
      "additionalProperties": false,
      "description": "Store one typed material inaccuracy grounded in response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/AccuracyBehaviour"
        },
        "finding_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        },
        "visible_evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Visible Evidence References",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "behaviour",
        "response_span",
        "visible_evidence_references",
        "reason"
      ],
      "title": "AccuracyFinding",
      "type": "object"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store one response's visible-facts-only factual findings.",
  "properties": {
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AccuracyFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "judge_model_id": {
      "minLength": 1,
      "title": "Judge Model Id",
      "type": "string"
    },
    "provider_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderCallProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scored_response": {
      "$ref": "#/$defs/ScoredResponse"
    },
    "scoring_prompt_sha256": {
      "title": "Scoring Prompt Sha256",
      "type": "string"
    },
    "visible_facts_sha256": {
      "title": "Visible Facts Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "blind_conversation_id",
    "scored_response",
    "findings",
    "visible_facts_sha256",
    "judge_model_id",
    "scoring_prompt_sha256",
    "scored_at"
  ],
  "title": "AccuracyAssessmentResult",
  "type": "object"
}
