{
  "$defs": {
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Freeze a blinded calibration or evaluation annotation sample.",
  "properties": {
    "conversation_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Conversation Ids",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "repeat_conversation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Repeat Conversation Ids",
      "type": "array"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "sample_stage": {
      "$ref": "#/$defs/ScenarioStage"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_execution_manifest_sha256": {
      "title": "Scoring Execution Manifest Sha256",
      "type": "string"
    },
    "selection_probabilities": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Selection Probabilities",
      "type": "object"
    },
    "source_transcripts_sha256": {
      "title": "Source Transcripts Sha256",
      "type": "string"
    },
    "strata_summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Strata Summary",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "sample_stage",
    "random_seed",
    "conversation_ids",
    "repeat_conversation_ids",
    "strata_summary",
    "selection_probabilities",
    "scoring_execution_manifest_sha256",
    "source_transcripts_sha256",
    "frozen_at",
    "manifest_sha256"
  ],
  "title": "AnnotationSampleManifest",
  "type": "object"
}
