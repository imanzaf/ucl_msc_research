{
  "$defs": {
    "JudgeContract": {
      "description": "Identify one of the three independent scoring judgments.",
      "enum": [
        "content",
        "presentation",
        "accuracy"
      ],
      "title": "JudgeContract",
      "type": "string"
    },
    "JudgeStage": {
      "description": "Distinguish prompt-development calls from the frozen full run.",
      "enum": [
        "pilot",
        "full"
      ],
      "title": "JudgeStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bind one minimal judge request to a frozen evaluated response.",
  "properties": {
    "contract": {
      "$ref": "#/$defs/JudgeContract"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "fact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fact Id"
    },
    "judge_call_id": {
      "minLength": 16,
      "title": "Judge Call Id",
      "type": "string"
    },
    "messages": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Messages",
      "type": "array"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "run_unit_id": {
      "minLength": 16,
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/JudgeStage"
    }
  },
  "required": [
    "judge_call_id",
    "run_unit_id",
    "stage",
    "contract",
    "messages",
    "prompt_sha256",
    "contract_sha256"
  ],
  "title": "JudgeTask",
  "type": "object"
}
