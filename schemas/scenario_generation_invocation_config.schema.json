{
  "$defs": {
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Record one resumable command invocation within a logical generation run.",
  "properties": {
    "backend": {
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Backend",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "invocation_id": {
      "pattern": "^\\d{8}T\\d{12}Z$",
      "title": "Invocation Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Scenario Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/ScenarioStage"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "invocation_id",
    "stage",
    "scenario_ids",
    "backend",
    "created_at"
  ],
  "title": "ScenarioGenerationInvocationConfig",
  "type": "object"
}
