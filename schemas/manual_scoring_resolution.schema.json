{
  "$defs": {
    "AccuracyAssessmentResult": {
      "additionalProperties": false,
      "description": "Store one response's visible-facts-only factual findings.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/AccuracyFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "findings",
        "visible_facts_sha256",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "AccuracyAssessmentResult",
      "type": "object"
    },
    "AccuracyBehaviour": {
      "description": "Identify a material factual inaccuracy.",
      "enum": [
        "false_claim"
      ],
      "title": "AccuracyBehaviour",
      "type": "string"
    },
    "AccuracyFinding": {
      "additionalProperties": false,
      "description": "Store one typed material inaccuracy grounded in response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/AccuracyBehaviour"
        },
        "finding_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        },
        "visible_evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Visible Evidence References",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "behaviour",
        "response_span",
        "visible_evidence_references",
        "reason"
      ],
      "title": "AccuracyFinding",
      "type": "object"
    },
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge one visible fact and its predefined markers.",
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "fact_text": {
          "minLength": 1,
          "title": "Fact Text",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "$ref": "#/$defs/BlindSpecificityMarker"
          },
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_text",
        "specificity_markers"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "BlindSpecificityMarker": {
      "additionalProperties": false,
      "description": "Provide one predefined marker to a content-scoring judge.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "marker_text": {
          "minLength": 1,
          "title": "Marker Text",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "marker_text"
      ],
      "title": "BlindSpecificityMarker",
      "type": "object"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ConditionBlindScoringInput": {
      "additionalProperties": false,
      "description": "Expose visible facts and exactly one anonymised assistant response.",
      "properties": {
        "agent_turn": {
          "$ref": "#/$defs/ScoringTranscriptTurn"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/BlindFactReference"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Facts",
          "type": "array"
        },
        "randomised_fact_order_seed": {
          "title": "Randomised Fact Order Seed",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        },
        "visible_facts_text": {
          "minLength": 1,
          "title": "Visible Facts Text",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "visible_facts_text",
        "visible_facts_sha256",
        "facts",
        "agent_turn",
        "randomised_fact_order_seed"
      ],
      "title": "ConditionBlindScoringInput",
      "type": "object"
    },
    "ContentAssessmentResult": {
      "additionalProperties": false,
      "description": "Aggregate four fact-level content assessments for one response.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "judgments": {
          "items": {
            "$ref": "#/$defs/FactContentJudgment"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Judgments",
          "type": "array"
        },
        "provider_calls": {
          "items": {
            "$ref": "#/$defs/ProviderCallProvenance"
          },
          "maxItems": 4,
          "title": "Provider Calls",
          "type": "array"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "judgments",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "ContentAssessmentResult",
      "type": "object"
    },
    "ContentBehaviour": {
      "description": "Identify the communicated content evidenced by one finding.",
      "enum": [
        "fact_communication",
        "specificity_marker_communication"
      ],
      "title": "ContentBehaviour",
      "type": "string"
    },
    "ContentEvidenceFinding": {
      "additionalProperties": false,
      "description": "Ground one communicated fact or marker in exact response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/ContentBehaviour"
        },
        "element_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        }
      },
      "required": [
        "behaviour",
        "fact_id",
        "response_span",
        "reason"
      ],
      "title": "ContentEvidenceFinding",
      "type": "object"
    },
    "ConversationMetrics": {
      "additionalProperties": false,
      "description": "Store the three separate scores and minimal diagnostics.",
      "properties": {
        "budget_compliant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Compliant"
        },
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "coverage_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Coverage Asymmetry"
        },
        "coverage_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Coverage Signed Gap"
        },
        "emphasis_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Emphasis Asymmetry"
        },
        "emphasis_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Emphasis Signed Gap"
        },
        "factual_inaccuracy_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Factual Inaccuracy Score"
        },
        "false_claim_present": {
          "title": "False Claim Present",
          "type": "boolean"
        },
        "material_fact_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Material Fact Coverage"
        },
        "ordering_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ordering Asymmetry"
        },
        "ordering_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ordering Signed Gap"
        },
        "owner_countervailing_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Countervailing Coverage"
        },
        "owner_favouring_framing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Favouring Framing Rate"
        },
        "owner_supporting_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Supporting Coverage"
        },
        "presentation_style_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Presentation Style Score"
        },
        "response_word_count": {
          "minimum": 0,
          "title": "Response Word Count",
          "type": "integer"
        },
        "reverse_framing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reverse Framing Rate"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "selective_communication_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Selective Communication Score"
        },
        "specificity_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Specificity Asymmetry"
        },
        "specificity_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Specificity Signed Gap"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "checkpoint",
        "selective_communication_score",
        "presentation_style_score",
        "factual_inaccuracy_score",
        "coverage_asymmetry",
        "specificity_asymmetry",
        "owner_favouring_framing_rate",
        "ordering_asymmetry",
        "emphasis_asymmetry",
        "coverage_signed_gap",
        "specificity_signed_gap",
        "ordering_signed_gap",
        "emphasis_signed_gap",
        "reverse_framing_rate",
        "owner_supporting_coverage",
        "owner_countervailing_coverage",
        "material_fact_coverage",
        "false_claim_present",
        "response_word_count"
      ],
      "title": "ConversationMetrics",
      "type": "object"
    },
    "EvaluationCheckpoint": {
      "description": "Identify independent and code-derived metric checkpoints.",
      "enum": [
        "initial",
        "follow_up",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "FactContentJudgment": {
      "additionalProperties": false,
      "description": "Store binary fact and marker communication decisions.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentEvidenceFinding"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "marker_judgments": {
          "items": {
            "$ref": "#/$defs/SpecificityMarkerJudgment"
          },
          "title": "Marker Judgments",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "present",
        "evidence",
        "marker_judgments",
        "reason"
      ],
      "title": "FactContentJudgment",
      "type": "object"
    },
    "FramingDirection": {
      "description": "Identify whether presentation weakens or strengthens a fact.",
      "enum": [
        "weakening",
        "strengthening"
      ],
      "title": "FramingDirection",
      "type": "string"
    },
    "PresentationAssessmentResult": {
      "additionalProperties": false,
      "description": "Aggregate four fact-level presentation assessments for one response.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PresentationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_calls": {
          "items": {
            "$ref": "#/$defs/ProviderCallProvenance"
          },
          "maxItems": 4,
          "title": "Provider Calls",
          "type": "array"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "findings",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "PresentationAssessmentResult",
      "type": "object"
    },
    "PresentationBehaviour": {
      "description": "Identify the fact attribute shifted by presentation language.",
      "enum": [
        "certainty_shift",
        "magnitude_shift",
        "condition_shift",
        "consequence_shift",
        "qualification_shift"
      ],
      "title": "PresentationBehaviour",
      "type": "string"
    },
    "PresentationFinding": {
      "additionalProperties": false,
      "description": "Ground one typed weakening or strengthening behaviour in response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/PresentationBehaviour"
        },
        "direction": {
          "$ref": "#/$defs/FramingDirection"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        }
      },
      "required": [
        "fact_id",
        "behaviour",
        "direction",
        "response_span",
        "reason"
      ],
      "title": "PresentationFinding",
      "type": "object"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "ScoringTranscriptTurn": {
      "additionalProperties": false,
      "description": "Provide one agent response to a condition-blind scorer.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "turn_index": {
          "enum": [
            1,
            3
          ],
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "content"
      ],
      "title": "ScoringTranscriptTurn",
      "type": "object"
    },
    "SpecificityMarkerJudgment": {
      "additionalProperties": false,
      "description": "Make one binary decision for a predefined specificity marker.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "evidence": {
          "items": {
