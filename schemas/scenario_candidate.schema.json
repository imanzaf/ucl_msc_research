{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Record who or what created a structured artifact and from which inputs.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "generator_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model Id"
        },
        "generator_prompt_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Prompt Sha256"
        },
        "parent_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Sha256"
        },
        "provider_calls": {
          "items": {
            "$ref": "#/$defs/ProviderCallProvenance"
          },
          "title": "Provider Calls",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "created_by"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ComparisonScope": {
      "description": "Identify whether both options belong to the provider or one is external.",
      "enum": [
        "intra_provider",
        "provider_vs_external"
      ],
      "title": "ComparisonScope",
      "type": "string"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store natural condition-specific questions and one shared non-leading follow-up.",
      "properties": {
        "concerned_user_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concerned User Query",
          "type": "string"
        },
        "follow_up_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Query",
          "type": "string"
        },
        "neutral_user_query": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Neutral User Query",
          "type": "string"
        }
      },
      "required": [
        "neutral_user_query",
        "concerned_user_query",
        "follow_up_query"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "savings support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "retail bank",
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ScenarioFactInformation": {
      "additionalProperties": false,
      "description": "Store one customer-facing directional fact and its quantitative phrases.",
      "properties": {
        "fact_text": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Text",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_text",
        "specificity_markers"
      ],
      "title": "ScenarioFactInformation",
      "type": "object"
    },
    "ScenarioHiddenDesign": {
      "additionalProperties": false,
      "description": "Store one decision's research-only ownership mapping and display order.",
      "properties": {
        "comparison_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Type",
          "type": "string"
        },
        "external_option_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeedOptionId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ScenarioOptionDefinition"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "owner_benefit_mechanism": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Owner Benefit Mechanism",
          "type": "string"
        },
        "owner_supporting_option": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "presentation_order": {
          "items": {
            "$ref": "#/$defs/SeedOptionId"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Presentation Order",
          "type": "array"
        }
      },
      "required": [
        "decision_type",
        "options",
        "owner_supporting_option",
        "owner_benefit_mechanism",
        "presentation_order"
      ],
      "title": "ScenarioHiddenDesign",
      "type": "object"
    },
    "ScenarioOptionDefinition": {
      "additionalProperties": false,
      "description": "Name one neutral decision option supplied to the fact generator.",
      "properties": {
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name"
      ],
      "title": "ScenarioOptionDefinition",
      "type": "object"
    },
    "ScenarioOptionInformation": {
      "additionalProperties": false,
      "description": "Store the visible description and directional facts for one option.",
      "properties": {
        "adverse_fact": {
          "$ref": "#/$defs/ScenarioFactInformation"
        },
        "description": {
          "maxLength": 400,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "favourable_fact": {
          "$ref": "#/$defs/ScenarioFactInformation"
        },
        "option_id": {
          "$ref": "#/$defs/SeedOptionId"
        }
      },
      "required": [
        "option_id",
        "description",
        "favourable_fact",
        "adverse_fact"
      ],
      "title": "ScenarioOptionInformation",
      "type": "object"
    },
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    },
    "SeedOptionId": {
      "description": "Identify one neutrally labelled option in a generation seed.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SeedOptionId",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent one generated scenario before researcher publication.",
  "properties": {
    "candidate_sha256": {
      "title": "Candidate Sha256",
      "type": "string"
    },
    "customer_messages": {
      "$ref": "#/$defs/CustomerMessages"
    },
    "deployment_context": {
      "$ref": "#/$defs/DeploymentContext"
    },
    "hidden_design": {
      "$ref": "#/$defs/ScenarioHiddenDesign"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/ScenarioOptionInformation"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Options",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "9.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "study_stage": {
      "$ref": "#/$defs/ScenarioStage"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "use_case_id",
    "study_stage",
    "deployment_context",
    "customer_messages",
    "hidden_design",
    "options",
    "provenance",
    "candidate_sha256"
  ],
  "title": "CandidateScenario",
  "type": "object"
}
