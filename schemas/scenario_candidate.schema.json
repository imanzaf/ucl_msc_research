{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Record who or what created a structured artifact and from which inputs.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "generator_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model Id"
        },
        "generator_prompt_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Prompt Sha256"
        },
        "parent_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Sha256"
        },
        "provider_calls": {
          "items": {
            "$ref": "#/$defs/ProviderCallProvenance"
          },
          "title": "Provider Calls",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "created_by"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "CustomerMessages": {
      "additionalProperties": false,
      "description": "Store the natural initial question and non-leading follow-up shown to the assistant.",
      "properties": {
        "follow_up_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Follow Up Message",
          "type": "string"
        },
        "initial_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Initial Message",
          "type": "string"
        }
      },
      "required": [
        "initial_message",
        "follow_up_message"
      ],
      "title": "CustomerMessages",
      "type": "object"
    },
    "DecisionOption": {
      "description": "Identify which hidden decision option a material fact describes.",
      "enum": [
        "provider_preferred",
        "customer_preferred"
      ],
      "title": "DecisionOption",
      "type": "string"
    },
    "DeploymentContext": {
      "additionalProperties": false,
      "description": "Store only the broad real-world guidance passed to the evaluated assistant.",
      "properties": {
        "authority_limits": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority Limits",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/FinanceEntityType"
        },
        "role": {
          "$ref": "#/$defs/FinanceAgentRole"
        },
        "task": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "role",
        "entity_type",
        "task",
        "authority_limits"
      ],
      "title": "DeploymentContext",
      "type": "object"
    },
    "EvidencePairType": {
      "description": "Identify the two polarity-matched evidence comparisons.",
      "enum": [
        "benefit_comparison",
        "downside_comparison"
      ],
      "title": "EvidencePairType",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Locate an exact support span within one rendered source item.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Source Item Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source_item_id",
        "start_char",
        "end_char",
        "exact_text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FactPair": {
      "additionalProperties": false,
      "description": "Represent one polarity-matched provider/customer option comparison.",
      "properties": {
        "customer_option_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Customer Option Fact Id",
          "type": "string"
        },
        "matching_rationale": {
          "minLength": 1,
          "title": "Matching Rationale",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "pair_type": {
          "$ref": "#/$defs/EvidencePairType"
        },
        "provider_option_fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Provider Option Fact Id",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "pair_type",
        "provider_option_fact_id",
        "customer_option_fact_id",
        "matching_rationale"
      ],
      "title": "FactPair",
      "type": "object"
    },
    "FactPolarity": {
      "description": "Identify whether a material fact is a benefit or downside of its option.",
      "enum": [
        "benefit",
        "downside"
      ],
      "title": "FactPolarity",
      "type": "string"
    },
    "FinanceAgentRole": {
      "description": "Identify the broad operational role assigned to the evaluated assistant.",
      "enum": [
        "current account support assistant",
        "mortgage support assistant",
        "credit-card support assistant",
        "borrowing support assistant",
        "payment-difficulty support assistant",
        "investment support assistant",
        "pension support assistant",
        "claims support assistant",
        "payments support assistant"
      ],
      "title": "FinanceAgentRole",
      "type": "string"
    },
    "FinanceEntityType": {
      "description": "Identify the generic finance-domain entity deploying the evaluated assistant.",
      "enum": [
        "bank",
        "mortgage lender",
        "credit-card provider",
        "personal lender",
        "loan servicer",
        "investment platform",
        "pension provider",
        "insurance provider",
        "payment provider"
      ],
      "title": "FinanceEntityType",
      "type": "string"
    },
    "MaterialFact": {
      "additionalProperties": false,
      "description": "Represent one equally required decision-material fact.",
      "properties": {
        "canonical_proposition": {
          "minLength": 1,
          "title": "Canonical Proposition",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        },
        "materiality_rating": {
          "maximum": 4,
          "minimum": 1,
          "title": "Materiality Rating",
          "type": "integer"
        },
        "materiality_rationale": {
          "minLength": 1,
          "title": "Materiality Rationale",
          "type": "string"
        },
        "option": {
          "$ref": "#/$defs/DecisionOption"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/FactPolarity"
        },
        "required_in_complete_response": {
          "title": "Required In Complete Response",
          "type": "boolean"
        },
        "source_support": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Source Support",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "pair_id",
        "option",
        "polarity",
        "canonical_proposition",
        "materiality_rationale",
        "required_in_complete_response",
        "materiality_rating",
        "source_support"
      ],
      "title": "MaterialFact",
      "type": "object"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ScenarioStage": {
      "description": "Identify calibration versus held-out evaluation scenarios.",
      "enum": [
        "calibration",
        "evaluation"
      ],
      "title": "ScenarioStage",
      "type": "string"
    },
    "SourceFormat": {
      "description": "Identify one active deterministic V0.9.0 evidence-packet presentation.",
      "enum": [
        "current_account_configuration_comparison",
        "later_life_mortgage_comparison",
        "transfer_offer_comparison",
        "consolidation_loan_term_comparison",
        "mortgage_retention_comparison",
        "difficulty_support_comparison",
        "fund_switch_comparison",
        "retirement_income_comparison",
        "claim_settlement_comparison",
        "international_payment_comparison"
      ],
      "title": "SourceFormat",
      "type": "string"
    },
    "SourceItem": {
      "additionalProperties": false,
      "description": "Represent one stable item in the evaluated model's visible packet.",
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "header": {
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "source_item_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Source Item Id",
          "type": "string"
        }
      },
      "required": [
        "source_item_id",
        "header",
        "body"
      ],
      "title": "SourceItem",
      "type": "object"
    },
    "SourceOptionId": {
      "description": "Identify one neutrally labelled option in a source-generation blueprint.",
      "enum": [
        "OPTION_A",
        "OPTION_B"
      ],
      "title": "SourceOptionId",
      "type": "string"
    },
    "SourceOptionRecordDesign": {
      "additionalProperties": false,
      "description": "Specify one deployment-visible option record without research interpretation.",
      "properties": {
        "benefit_fact_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Benefit Fact Label",
          "type": "string"
        },
        "benefit_fact_requirement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Benefit Fact Requirement",
          "type": "string"
        },
        "downside_fact_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Downside Fact Label",
          "type": "string"
        },
        "downside_fact_requirement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Downside Fact Requirement",
          "type": "string"
        },
        "option_id": {
          "$ref": "#/$defs/SourceOptionId"
        },
        "option_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Name",
          "type": "string"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "option_name",
        "record_type",
        "benefit_fact_label",
        "downside_fact_label",
        "benefit_fact_requirement",
        "downside_fact_requirement"
      ],
      "title": "SourceOptionRecordDesign",
      "type": "object"
    },
    "SourcePacket": {
      "additionalProperties": false,
      "description": "Represent one deterministic evaluated-model evidence packet.",
      "properties": {
        "fixed_title": {
          "minLength": 1,
          "title": "Fixed Title",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SourceItem"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Items",
          "type": "array"
        },
        "rendered_sha256": {
          "title": "Rendered Sha256",
          "type": "string"
        },
        "rendered_text": {
          "minLength": 1,
          "title": "Rendered Text",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_format": {
          "$ref": "#/$defs/SourceFormat"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "fixed_title",
        "source_format",
        "items",
        "rendered_text",
        "rendered_sha256"
      ],
      "title": "SourcePacket",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage for one response.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "V09DecisionDesign": {
      "additionalProperties": false,
      "description": "Map neutral source options to the hidden customer/provider conflict.",
      "properties": {
        "customer_goal": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Goal",
          "type": "string"
        },
        "customer_harm": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Harm",
          "type": "string"
        },
        "customer_preference_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Customer Preference Basis",
          "type": "string"
        },
        "customer_preferred_option": {
          "$ref": "#/$defs/SourceOptionId"
        },
        "high_stakes_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "High Stakes Basis",
          "type": "string"
        },
        "provider_benefit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Benefit",
          "type": "string"
        },
        "provider_preferred_option": {
          "$ref": "#/$defs/SourceOptionId"
        }
      },
      "required": [
        "customer_goal",
        "customer_preferred_option",
        "provider_preferred_option",
        "customer_preference_basis",
        "provider_benefit",
        "customer_harm",
        "high_stakes_basis"
      ],
      "title": "V09DecisionDesign",
      "type": "object"
    },
    "V09EvidenceDesign": {
      "additionalProperties": false,
      "description": "Store hidden balanced evidence targets excluded from source generation.",
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/V09EvidencePairBrief"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Pairs",
          "type": "array"
        }
      },
      "required": [
        "pairs"
      ],
      "title": "V09EvidenceDesign",
      "type": "object"
    },
    "V09EvidencePairBrief": {
      "additionalProperties": false,
      "description": "Record the hidden polarity interpretation of one neutral source comparison.",
      "properties": {
        "matching_requirements": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Matching Requirements",
          "type": "string"
        },
        "option_a_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option A Theme",
          "type": "string"
        },
        "option_b_theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option B Theme",
          "type": "string"
        },
        "pair_type": {
          "$ref": "#/$defs/EvidencePairType"
        }
      },
      "required": [
        "pair_type",
        "option_a_theme",
        "option_b_theme",
        "matching_requirements"
      ],
      "title": "V09EvidencePairBrief",
      "type": "object"
    },
    "V09HiddenDesign": {
      "additionalProperties": false,
      "description": "Separate source-generator inputs from research-only interpretation.",
      "properties": {
        "research": {
          "$ref": "#/$defs/V09ResearchDesign"
        },
        "source_generation": {
          "$ref": "#/$defs/V09SourceGenerationDesign"
        }
      },
      "required": [
        "source_generation",
        "research"
      ],
      "title": "V09HiddenDesign",
      "type": "object"
    },
    "V09ReplicationSeed": {
      "additionalProperties": false,
      "description": "Store one V0.9.0 variation and its frozen evaluated-source option order.",
      "properties": {
        "presentation_order": {
          "items": {
            "$ref": "#/$defs/SourceOptionId"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Presentation Order",
          "type": "array"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[1-4])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "variation_brief": {
          "minLength": 1,
          "title": "Variation Brief",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "variation_brief",
        "presentation_order"
      ],
      "title": "V09ReplicationSeed",
      "type": "object"
    },
    "V09ResearchDesign": {
      "additionalProperties": false,
      "description": "Group research-only decision and diagnostic interpretation.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/V09DecisionDesign"
        },
        "evidence": {
          "$ref": "#/$defs/V09EvidenceDesign"
        }
      },
      "required": [
        "decision",
        "evidence"
      ],
      "title": "V09ResearchDesign",
      "type": "object"
    },
    "V09SourceGenerationDesign": {
      "additionalProperties": false,
      "description": "Specify only the factual records and constraints needed to generate a source.",
      "properties": {
        "common_comparison_basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Common Comparison Basis",
          "type": "string"
        },
        "decision_topic": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Topic",
          "type": "string"
        },
        "option_records": {
          "items": {
            "$ref": "#/$defs/SourceOptionRecordDesign"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Option Records",
          "type": "array"
        },
        "replications": {
          "items": {
            "$ref": "#/$defs/V09ReplicationSeed"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Replications",
          "type": "array"
        }
      },
      "required": [
        "decision_topic",
        "option_records",
        "common_comparison_basis",
        "replications"
      ],
      "title": "V09SourceGenerationDesign",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent the rebuilt scenario candidate before researcher acceptance.",
  "properties": {
    "candidate_sha256": {
      "title": "Candidate Sha256",
      "type": "string"
    },
    "customer_messages": {
      "$ref": "#/$defs/CustomerMessages"
    },
    "deployment_context": {
      "$ref": "#/$defs/DeploymentContext"
    },
    "fact_pairs": {
      "items": {
        "$ref": "#/$defs/FactPair"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Fact Pairs",
      "type": "array"
    },
    "hidden_design": {
      "$ref": "#/$defs/V09HiddenDesign"
    },
    "material_facts": {
      "items": {
        "$ref": "#/$defs/MaterialFact"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Material Facts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[1-4])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_packet": {
      "$ref": "#/$defs/SourcePacket"
    },
    "study_stage": {
      "$ref": "#/$defs/ScenarioStage"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "use_case_id",
    "study_stage",
    "deployment_context",
    "customer_messages",
    "hidden_design",
    "source_packet",
    "material_facts",
    "fact_pairs",
    "provenance",
    "candidate_sha256"
  ],
  "title": "CandidateScenario",
  "type": "object"
}
