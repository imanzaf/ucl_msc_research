{
  "$defs": {
    "AutomatedReviewKind": {
      "description": "Identify the independent semantic scenario-review contract.",
      "enum": [
        "scenario_quality"
      ],
      "title": "AutomatedReviewKind",
      "type": "string"
    },
    "AutomatedScenarioReview": {
      "additionalProperties": false,
      "description": "Store one condition-independent typed automated review.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReviewFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_kind": {
          "$ref": "#/$defs/AutomatedReviewKind"
        },
        "reviewed_artifact_sha256": {
          "title": "Reviewed Artifact Sha256",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_model_id": {
          "minLength": 1,
          "title": "Reviewer Model Id",
          "type": "string"
        },
        "reviewer_prompt_sha256": {
          "title": "Reviewer Prompt Sha256",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "review_kind",
        "decision",
        "findings",
        "reviewed_artifact_sha256",
        "reviewer_model_id",
        "reviewer_prompt_sha256",
        "reviewed_at"
      ],
      "title": "AutomatedScenarioReview",
      "type": "object"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ControlledFieldChange": {
      "additionalProperties": false,
      "description": "Record one field-level revision without permitting whole-object replacement.",
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "previous_value_sha256": {
          "title": "Previous Value Sha256",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "revised_value_sha256": {
          "title": "Revised Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "previous_value_sha256",
        "revised_value_sha256",
        "reason",
        "finding_ids"
      ],
      "title": "ControlledFieldChange",
      "type": "object"
    },
    "FindingSeverity": {
      "description": "Classify review findings by protocol impact.",
      "enum": [
        "blocker",
        "major",
        "minor"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "PairDiagnostics": {
      "additionalProperties": false,
      "description": "Expose blinded descriptive pair-matching diagnostics without thresholds.",
      "properties": {
        "arithmetic_dependency": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Arithmetic Dependency",
          "type": "object"
        },
        "conditional_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Conditional Burden",
          "type": "object"
        },
        "hedging_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hedging Burden",
          "type": "object"
        },
        "numeric_burden": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Numeric Burden",
          "type": "object"
        },
        "pair_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_P[12]$",
          "title": "Pair Id",
          "type": "string"
        },
        "proposition_word_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Proposition Word Counts",
          "type": "object"
        },
        "readability": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Readability",
          "type": "object"
        },
        "shared_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Shared Quantities",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "proposition_word_counts",
        "numeric_burden",
        "conditional_burden",
        "hedging_burden",
        "readability",
        "arithmetic_dependency",
        "shared_quantities"
      ],
      "title": "PairDiagnostics",
      "type": "object"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResearcherFactReview": {
      "additionalProperties": false,
      "description": "Store the editable text, quantitative markers, and notes for one fact.",
      "properties": {
        "fact_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])_F[1-4]$",
          "title": "Fact Id",
          "type": "string"
        },
        "fact_text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Text",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_text",
        "specificity_markers"
      ],
      "title": "ResearcherFactReview",
      "type": "object"
    },
    "ResearcherScenarioReview": {
      "additionalProperties": false,
      "description": "Store one researcher decision and the complete editable per-fact review.",
      "properties": {
        "anonymised_item_id": {
          "minLength": 1,
          "title": "Anonymised Item Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "fact_reviews": {
          "items": {
            "$ref": "#/$defs/ResearcherFactReview"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Fact Reviews",
          "type": "array"
        },
        "pair_diagnostics": {
          "items": {
            "$ref": "#/$defs/PairDiagnostics"
          },
          "maxItems": 2,
          "title": "Pair Diagnostics",
          "type": "array"
        },
        "researcher_id": {
          "minLength": 1,
          "title": "Researcher Id",
          "type": "string"
        },
        "review_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_artifact_sha256": {
          "title": "Reviewed Artifact Sha256",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "3.3.0",
            "3.4.0"
          ],
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "review_id",
        "anonymised_item_id",
        "scenario_id",
        "decision",
        "fact_reviews",
        "reviewed_artifact_sha256",
        "reviewed_at",
        "researcher_id"
      ],
      "title": "ResearcherScenarioReview",
      "type": "object"
    },
    "ReviewDecision": {
      "description": "Identify an automated or researcher scenario decision.",
      "enum": [
        "accept",
        "revise",
        "manual_restructure",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "description": "Represent one concise generated-text revision instruction.",
      "properties": {
        "fact_text": {
          "minLength": 1,
          "title": "Fact Text",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        },
        "suggested_action": {
          "minLength": 1,
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "fact_text",
        "suggested_action"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "RevisionCycleRecord": {
      "additionalProperties": false,
      "description": "Store one bounded automated revision and full dependency rebuild.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ControlledFieldChange"
          },
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "cycle_number": {
          "maximum": 1,
          "minimum": 1,
          "title": "Cycle Number",
          "type": "integer"
        },
        "input_artifact_sha256": {
          "title": "Input Artifact Sha256",
          "type": "string"
        },
        "output_artifact_sha256": {
          "title": "Output Artifact Sha256",
          "type": "string"
        },
        "rebuilt_dependency_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rebuilt Dependency Sha256",
          "type": "object"
        },
        "rerun_review_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/AutomatedReviewKind"
          },
          "title": "Rerun Review Sha256",
          "type": "object"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "cycle_number",
        "changes",
        "input_artifact_sha256",
        "output_artifact_sha256",
        "rebuilt_dependency_sha256",
        "rerun_review_sha256",
        "completed_at"
      ],
      "title": "RevisionCycleRecord",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Collect complete automated, revision, and researcher review provenance.",
  "properties": {
    "automated_reviews": {
      "items": {
        "$ref": "#/$defs/AutomatedScenarioReview"
      },
      "minItems": 1,
      "title": "Automated Reviews",
      "type": "array"
    },
    "researcher_reviews": {
      "items": {
        "$ref": "#/$defs/ResearcherScenarioReview"
      },
      "minItems": 1,
      "title": "Researcher Reviews",
      "type": "array"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/RevisionCycleRecord"
      },
      "maxItems": 1,
      "title": "Revisions",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "3.3.0",
        "3.4.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "automated_reviews",
    "revisions",
    "researcher_reviews"
  ],
  "title": "ScenarioReviewHistory",
  "type": "object"
}
