{
  "additionalProperties": false,
  "description": "Summarize completed, valid, invalid, token, and cost outcomes.",
  "properties": {
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "approved_max_cost": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Approved Max Cost"
    },
    "calculated_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Calculated Cost"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "generated_outputs_path": {
      "format": "path",
      "title": "Generated Outputs Path",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "invalid_output_count": {
      "minimum": 0,
      "title": "Invalid Output Count",
      "type": "integer"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "reported_billed_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Reported Billed Cost"
    },
    "reported_cost_record_count": {
      "minimum": 0,
      "title": "Reported Cost Record Count",
      "type": "integer"
    },
    "request_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Batch Sha256",
      "type": "string"
    },
    "request_count": {
      "minimum": 1,
      "title": "Request Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_response_count": {
      "minimum": 0,
      "title": "Semantic Response Count",
      "type": "integer"
    },
    "valid_output_count": {
      "minimum": 0,
      "title": "Valid Output Count",
      "type": "integer"
    },
    "workflow": {
      "const": "scenario_fact_generation_v1",
      "default": "scenario_fact_generation_v1",
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "request_batch_sha256",
    "approval_sha256",
    "request_count",
    "semantic_response_count",
    "valid_output_count",
    "invalid_output_count",
    "input_tokens",
    "output_tokens",
    "reported_cost_record_count",
    "reported_billed_cost",
    "calculated_cost",
    "approved_max_cost",
    "generated_outputs_path",
    "completed_at"
  ],
  "title": "ScenarioGenerationSummary",
  "type": "object"
}
