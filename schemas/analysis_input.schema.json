{
  "$defs": {
    "ConversationMetrics": {
      "additionalProperties": false,
      "description": "Store separate outcomes without any composite score.",
      "properties": {
        "adverse_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Adverse Coverage"
        },
        "adverse_salience_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adverse Salience Share"
        },
        "assigned_word_limit": {
          "exclusiveMinimum": 0,
          "title": "Assigned Word Limit",
          "type": "integer"
        },
        "budget_compliant": {
          "title": "Budget Compliant",
          "type": "boolean"
        },
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "conditional_framing_minimisation_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Framing Minimisation Rate"
        },
        "conditional_specificity_retention": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Specificity Retention"
        },
        "cue_occurrence_count": {
          "minimum": 0,
          "title": "Cue Occurrence Count",
          "type": "integer"
        },
        "false_claim_count": {
          "minimum": 0,
          "title": "False Claim Count",
          "type": "integer"
        },
        "favourable_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Favourable Coverage"
        },
        "material_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Material Coverage"
        },
        "overcertain_claim_count": {
          "minimum": 0,
          "title": "Overcertain Claim Count",
          "type": "integer"
        },
        "pairwise_disclosure_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Pairwise Disclosure Gap"
        },
        "priority_violation_count": {
          "minimum": 0,
          "title": "Priority Violation Count",
          "type": "integer"
        },
        "prompt_factor_isolation_valid": {
          "title": "Prompt Factor Isolation Valid",
          "type": "boolean"
        },
        "refusal": {
          "title": "Refusal",
          "type": "boolean"
        },
        "repaired_fact_count": {
          "minimum": 0,
          "title": "Repaired Fact Count",
          "type": "integer"
        },
        "response_word_count": {
          "minimum": 0,
          "title": "Response Word Count",
          "type": "integer"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "signposting": {
          "title": "Signposting",
          "type": "boolean"
        },
        "supportive_acknowledgement": {
          "title": "Supportive Acknowledgement",
          "type": "boolean"
        },
        "unsupported_claim_count": {
          "minimum": 0,
          "title": "Unsupported Claim Count",
          "type": "integer"
        },
        "unsupported_reassurance": {
          "title": "Unsupported Reassurance",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "checkpoint",
        "pairwise_disclosure_gap",
        "adverse_coverage",
        "favourable_coverage",
        "material_coverage",
        "priority_violation_count",
        "supportive_acknowledgement",
        "unsupported_reassurance",
        "refusal",
        "signposting",
        "false_claim_count",
        "unsupported_claim_count",
        "overcertain_claim_count",
        "repaired_fact_count",
        "response_word_count",
        "assigned_word_limit",
        "budget_compliant",
        "cue_occurrence_count",
        "prompt_factor_isolation_valid"
      ],
      "title": "ConversationMetrics",
      "type": "object"
    },
    "EmotionalCueCondition": {
      "description": "Identify the single visible opening-cue condition.",
      "enum": [
        "neutral",
        "worried"
      ],
      "title": "EmotionalCueCondition",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify initial-only versus cumulative communication checkpoints.",
      "enum": [
        "initial",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "IntegrityCondition": {
      "description": "Identify whether the targeted mitigation is present.",
      "enum": [
        "absent",
        "targeted"
      ],
      "title": "IntegrityCondition",
      "type": "string"
    },
    "SourceOrderVariant": {
      "description": "Identify deterministic information-equivalent source order.",
      "enum": [
        "A",
        "B"
      ],
      "title": "SourceOrderVariant",
      "type": "string"
    },
    "WordBudgetCondition": {
      "description": "Identify the assigned response-length condition.",
      "enum": [
        "ample",
        "tight"
      ],
      "title": "WordBudgetCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Join immutable conditions to scored outcomes only after blind scoring finishes.",
  "properties": {
    "emotional_cue": {
      "$ref": "#/$defs/EmotionalCueCondition"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityCondition"
    },
    "metrics": {
      "$ref": "#/$defs/ConversationMetrics"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_R[1-4]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_result_sha256": {
      "title": "Scoring Result Sha256",
      "type": "string"
    },
    "source_order": {
      "$ref": "#/$defs/SourceOrderVariant"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    },
    "word_budget": {
      "$ref": "#/$defs/WordBudgetCondition"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "scenario_id",
    "use_case_id",
    "model_id",
    "source_order",
    "word_budget",
    "emotional_cue",
    "integrity",
    "metrics",
    "transcript_sha256",
    "scoring_result_sha256"
  ],
  "title": "AnalysisInputRow",
  "type": "object"
}
