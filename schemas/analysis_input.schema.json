{
  "$defs": {
    "ConcisionCondition": {
      "description": "Identify whether the evaluated system prompt requests concise answers.",
      "enum": [
        "baseline",
        "concise",
        "user_concise"
      ],
      "title": "ConcisionCondition",
      "type": "string"
    },
    "ConversationMetrics": {
      "additionalProperties": false,
      "description": "Store the three separate scores and minimal diagnostics.",
      "properties": {
        "budget_compliant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Compliant"
        },
        "checkpoint": {
          "$ref": "#/$defs/EvaluationCheckpoint"
        },
        "coverage_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Coverage Asymmetry"
        },
        "coverage_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Coverage Signed Gap"
        },
        "emphasis_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Emphasis Asymmetry"
        },
        "emphasis_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Emphasis Signed Gap"
        },
        "factual_inaccuracy_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Factual Inaccuracy Score"
        },
        "false_claim_present": {
          "title": "False Claim Present",
          "type": "boolean"
        },
        "material_fact_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Material Fact Coverage"
        },
        "ordering_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ordering Asymmetry"
        },
        "ordering_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ordering Signed Gap"
        },
        "owner_countervailing_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Countervailing Coverage"
        },
        "owner_favouring_framing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Favouring Framing Rate"
        },
        "owner_supporting_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Owner Supporting Coverage"
        },
        "presentation_style_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Presentation Style Score"
        },
        "response_word_count": {
          "minimum": 0,
          "title": "Response Word Count",
          "type": "integer"
        },
        "reverse_framing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Reverse Framing Rate"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^4\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "selective_communication_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Selective Communication Score"
        },
        "specificity_asymmetry": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Specificity Asymmetry"
        },
        "specificity_signed_gap": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Specificity Signed Gap"
        },
        "unsupported_claim_present": {
          "title": "Unsupported Claim Present",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "checkpoint",
        "selective_communication_score",
        "presentation_style_score",
        "factual_inaccuracy_score",
        "coverage_asymmetry",
        "specificity_asymmetry",
        "owner_favouring_framing_rate",
        "ordering_asymmetry",
        "emphasis_asymmetry",
        "coverage_signed_gap",
        "specificity_signed_gap",
        "ordering_signed_gap",
        "emphasis_signed_gap",
        "reverse_framing_rate",
        "owner_supporting_coverage",
        "owner_countervailing_coverage",
        "material_fact_coverage",
        "false_claim_present",
        "unsupported_claim_present",
        "response_word_count"
      ],
      "title": "ConversationMetrics",
      "type": "object"
    },
    "EvaluationCheckpoint": {
      "description": "Identify independent and code-derived metric checkpoints.",
      "enum": [
        "initial",
        "follow_up",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "ExpressedConcernCondition": {
      "description": "Identify which seed-authored user query is shown.",
      "enum": [
        "neutral",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Join immutable conditions to scored outcomes only after blind scoring finishes.",
  "properties": {
    "expressed_concern": {
      "$ref": "#/$defs/ExpressedConcernCondition"
    },
    "metrics": {
      "$ref": "#/$defs/ConversationMetrics"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_R[12]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_result_sha256": {
      "title": "Scoring Result Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    },
    "word_budget": {
      "$ref": "#/$defs/ConcisionCondition"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "scenario_id",
    "use_case_id",
    "model_id",
    "word_budget",
    "expressed_concern",
    "metrics",
    "transcript_sha256",
    "scoring_result_sha256"
  ],
  "title": "AnalysisInputRow",
  "type": "object"
}
