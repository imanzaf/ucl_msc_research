{
  "additionalProperties": false,
  "description": "Record the immutable seed and protocol identity for one logical generation run.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generation_protocol_version": {
      "const": "v1.0.0",
      "title": "Generation Protocol Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_set_id": {
      "const": "customer_facing_risk_communication_v1.0.0",
      "title": "Scenario Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_schema_sha256": {
      "title": "Seed Schema Sha256",
      "type": "string"
    },
    "seed_sha256": {
      "title": "Seed Sha256",
      "type": "string"
    },
    "seed_version": {
      "const": "v1.0.0",
      "title": "Seed Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "seed_version",
    "generation_protocol_version",
    "scenario_set_id",
    "seed_sha256",
    "seed_schema_sha256",
    "created_at"
  ],
  "title": "ScenarioGenerationRunConfig",
  "type": "object"
}
