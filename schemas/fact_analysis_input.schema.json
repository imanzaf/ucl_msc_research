{
  "$defs": {
    "DecisionAlignment": {
      "description": "Identify whose preferred decision a fact supports.",
      "enum": [
        "provider_supporting",
        "customer_supporting"
      ],
      "title": "DecisionAlignment",
      "type": "string"
    },
    "DecisionOption": {
      "description": "Identify which hidden decision option a material fact describes.",
      "enum": [
        "owner_option",
        "customer_option"
      ],
      "title": "DecisionOption",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify initial-only versus cumulative communication checkpoints.",
      "enum": [
        "initial",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "ExpressedConcernCondition": {
      "description": "Identify whether the user expresses concern in the opening cue.",
      "enum": [
        "neutral",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    },
    "FactPolarity": {
      "description": "Identify whether a material fact is a benefit or downside of its option.",
      "enum": [
        "benefit",
        "downside"
      ],
      "title": "FactPolarity",
      "type": "string"
    },
    "IntegrityCondition": {
      "description": "Retain the legacy field boundary without an active integrity treatment.",
      "enum": [
        "absent",
        "targeted"
      ],
      "title": "IntegrityCondition",
      "type": "string"
    },
    "WordBudgetCondition": {
      "description": "Identify the assigned response-length condition.",
      "enum": [
        "ample",
        "tight",
        "none"
      ],
      "title": "WordBudgetCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Expose one material-fact disclosure state for ordinal robustness analysis.",
  "properties": {
    "checkpoint": {
      "$ref": "#/$defs/EvaluationCheckpoint"
    },
    "cue_template_id": {
      "maximum": 4,
      "minimum": 1,
      "title": "Cue Template Id",
      "type": "integer"
    },
    "decision_alignment": {
      "$ref": "#/$defs/DecisionAlignment"
    },
    "disclosure_ordinal": {
      "maximum": 2,
      "minimum": 0,
      "title": "Disclosure Ordinal",
      "type": "integer"
    },
    "expressed_concern": {
      "$ref": "#/$defs/ExpressedConcernCondition"
    },
    "fact_id": {
      "minLength": 1,
      "title": "Fact Id",
      "type": "string"
    },
    "fact_option": {
      "$ref": "#/$defs/DecisionOption"
    },
    "fact_polarity": {
      "$ref": "#/$defs/FactPolarity"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityCondition"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "pair_id": {
      "pattern": "^CF\\d{3}_R[12]_P[12]$",
      "title": "Pair Id",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_R[12]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_result_sha256": {
      "title": "Scoring Result Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    },
    "word_budget": {
      "$ref": "#/$defs/WordBudgetCondition"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "scenario_id",
    "use_case_id",
    "fact_id",
    "pair_id",
    "fact_option",
    "fact_polarity",
    "decision_alignment",
    "checkpoint",
    "disclosure_ordinal",
    "model_id",
    "cue_template_id",
    "word_budget",
    "expressed_concern",
    "integrity",
    "transcript_sha256",
    "scoring_result_sha256"
  ],
  "title": "FactAnalysisInputRow",
  "type": "object"
}
