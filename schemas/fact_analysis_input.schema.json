{
  "$defs": {
    "ConcisionCondition": {
      "description": "Identify whether the evaluated system prompt requests concise answers.",
      "enum": [
        "baseline",
        "concise",
        "user_concise"
      ],
      "title": "ConcisionCondition",
      "type": "string"
    },
    "DecisionAlignment": {
      "description": "Identify whether a fact supports or counters the model owner's preferred option.",
      "enum": [
        "owner_supporting",
        "owner_countervailing"
      ],
      "title": "DecisionAlignment",
      "type": "string"
    },
    "DecisionOption": {
      "description": "Identify which hidden decision option a material fact describes.",
      "enum": [
        "owner_option",
        "alternative_option"
      ],
      "title": "DecisionOption",
      "type": "string"
    },
    "EvaluationCheckpoint": {
      "description": "Identify independent and code-derived metric checkpoints.",
      "enum": [
        "initial",
        "follow_up",
        "cumulative"
      ],
      "title": "EvaluationCheckpoint",
      "type": "string"
    },
    "ExpressedConcernCondition": {
      "description": "Identify which seed-authored user query is shown.",
      "enum": [
        "neutral",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    },
    "FactPolarity": {
      "description": "Identify whether a material fact is a benefit or downside of its option.",
      "enum": [
        "benefit",
        "downside"
      ],
      "title": "FactPolarity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Expose one material fact's binary communication state.",
  "properties": {
    "checkpoint": {
      "$ref": "#/$defs/EvaluationCheckpoint"
    },
    "decision_alignment": {
      "$ref": "#/$defs/DecisionAlignment"
    },
    "expressed_concern": {
      "$ref": "#/$defs/ExpressedConcernCondition"
    },
    "fact_id": {
      "minLength": 1,
      "title": "Fact Id",
      "type": "string"
    },
    "fact_option": {
      "$ref": "#/$defs/DecisionOption"
    },
    "fact_polarity": {
      "$ref": "#/$defs/FactPolarity"
    },
    "fact_present": {
      "title": "Fact Present",
      "type": "boolean"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "pair_id": {
      "pattern": "^CF\\d{3}_R[12]_P[12]$",
      "title": "Pair Id",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_R[12]$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_result_sha256": {
      "title": "Scoring Result Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    },
    "word_budget": {
      "$ref": "#/$defs/ConcisionCondition"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "scenario_id",
    "use_case_id",
    "fact_id",
    "pair_id",
    "fact_option",
    "fact_polarity",
    "decision_alignment",
    "checkpoint",
    "fact_present",
    "model_id",
    "word_budget",
    "expressed_concern",
    "transcript_sha256",
    "scoring_result_sha256"
  ],
  "title": "FactAnalysisInputRow",
  "type": "object"
}
