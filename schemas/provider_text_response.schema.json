{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Return provider text and audit metadata without mutating the request.",
  "properties": {
    "cost_credits": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Credits"
    },
    "finish_reason": {
      "$ref": "#/$defs/CompletionFinishReason"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider_request_id": {
      "minLength": 1,
      "title": "Provider Request Id",
      "type": "string"
    },
    "returned_model_version": {
      "minLength": 1,
      "title": "Returned Model Version",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "upstream_inference_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Inference Cost"
    }
  },
  "required": [
    "text",
    "provider_request_id",
    "returned_model_version",
    "input_tokens",
    "output_tokens",
    "finish_reason"
  ],
  "title": "ProviderTextResponse",
  "type": "object"
}
