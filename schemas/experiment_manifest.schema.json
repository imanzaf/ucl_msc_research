{
  "$defs": {
    "EvaluatedModelSnapshot": {
      "additionalProperties": false,
      "description": "Freeze one evaluated model and its provider-returned identity.",
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "metadata_sha256": {
          "title": "Metadata Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "weight_type": {
          "$ref": "#/$defs/ModelWeightType"
        }
      },
      "required": [
        "name",
        "model_id",
        "returned_model_version",
        "family",
        "provider",
        "weight_type",
        "metadata_sha256",
        "frozen_at"
      ],
      "title": "EvaluatedModelSnapshot",
      "type": "object"
    },
    "ExperimentName": {
      "description": "Identify one independently manifested conversation experiment.",
      "enum": [
        "risk_comm_v1",
        "material_priority_v1",
        "brevity_locus_v1"
      ],
      "title": "ExperimentName",
      "type": "string"
    },
    "FreezeStatus": {
      "description": "Identify whether a manifest remains draft or is immutable for downstream use.",
      "enum": [
        "draft",
        "frozen"
      ],
      "title": "FreezeStatus",
      "type": "string"
    },
    "ModelWeightType": {
      "description": "Identify open- versus closed-weight evaluated model families.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "ModelWeightType",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Freeze retry count and backoff while prohibiting prompt mutation.",
      "properties": {
        "backoff_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Backoff Seconds",
          "type": "array"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "reuse_identical_prompt_bytes": {
          "default": true,
          "title": "Reuse Identical Prompt Bytes",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_seconds"
      ],
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze evaluated models, prompts, scenarios, decoding, and retry policy.",
  "properties": {
    "accepted_scenario_manifest_sha256": {
      "title": "Accepted Scenario Manifest Sha256",
      "type": "string"
    },
    "decoding_temperature": {
      "default": 0.0,
      "maximum": 0.0,
      "minimum": 0.0,
      "title": "Decoding Temperature",
      "type": "number"
    },
    "evaluated_model_manifest_sha256": {
      "title": "Evaluated Model Manifest Sha256",
      "type": "string"
    },
    "evaluated_models": {
      "items": {
        "$ref": "#/$defs/EvaluatedModelSnapshot"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Evaluated Models",
      "type": "array"
    },
    "expected_conversation_count": {
      "minimum": 1,
      "title": "Expected Conversation Count",
      "type": "integer"
    },
    "experiment_name": {
      "$ref": "#/$defs/ExperimentName"
    },
    "freeze_status": {
      "$ref": "#/$defs/FreezeStatus"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "prompt_package_sha256": {
      "title": "Prompt Package Sha256",
      "type": "string"
    },
    "prompt_review_manifest_sha256": {
      "title": "Prompt Review Manifest Sha256",
      "type": "string"
    },
    "randomisation_seed": {
      "title": "Randomisation Seed",
      "type": "integer"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_contract_sha256": {
      "title": "Scoring Contract Sha256",
      "type": "string"
    },
    "scoring_execution_manifest_sha256": {
      "title": "Scoring Execution Manifest Sha256",
      "type": "string"
    },
    "scoring_judge_model_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scoring Judge Model Ids",
      "type": "array"
    },
    "word_budget_manifest_sha256": {
      "title": "Word Budget Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "experiment_name",
    "expected_conversation_count",
    "freeze_status",
    "evaluated_models",
    "scoring_judge_model_ids",
    "evaluated_model_manifest_sha256",
    "accepted_scenario_manifest_sha256",
    "word_budget_manifest_sha256",
    "prompt_review_manifest_sha256",
    "prompt_package_sha256",
    "scoring_execution_manifest_sha256",
    "scoring_contract_sha256",
    "randomisation_seed",
    "retry_policy",
    "manifest_sha256"
  ],
  "title": "ExperimentManifest",
  "type": "object"
}
