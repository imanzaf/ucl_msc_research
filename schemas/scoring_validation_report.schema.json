{
  "$defs": {
    "ConstructValidationDiagnostics": {
      "additionalProperties": false,
      "description": "Persist complete blinded validation diagnostics for one scoring construct.",
      "properties": {
        "agreement": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Agreement"
        },
        "confusion_matrix": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "title": "Confusion Matrix",
          "type": "object"
        },
        "f1": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "F1"
        },
        "gate_passed": {
          "title": "Gate Passed",
          "type": "boolean"
        },
        "invalid_output_count": {
          "minimum": 0,
          "title": "Invalid Output Count",
          "type": "integer"
        },
        "maximum_absolute_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Absolute Error"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Precision"
        },
        "prevalence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Prevalence"
        },
        "recall": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Recall"
        },
        "sample_size": {
          "exclusiveMinimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "uncertainty_interval": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Uncertainty Interval",
          "type": "array"
        }
      },
      "required": [
        "prevalence",
        "agreement",
        "confusion_matrix",
        "precision",
        "recall",
        "f1",
        "invalid_output_count",
        "sample_size",
        "uncertainty_interval",
        "gate_passed"
      ],
      "title": "ConstructValidationDiagnostics",
      "type": "object"
    },
    "ScoringConstruct": {
      "description": "Identify one independently validated score component.",
      "enum": [
        "coverage",
        "specificity",
        "framing",
        "ordering",
        "emphasis",
        "accuracy"
      ],
      "title": "ScoringConstruct",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persist complete construct diagnostics while treatment labels remain unavailable.",
  "properties": {
    "annotation_count_per_conversation": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Annotation Count Per Conversation",
      "type": "integer"
    },
    "construct_diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/ConstructValidationDiagnostics"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Construct Diagnostics",
      "type": "object"
    },
    "construct_gate_manifest_sha256": {
      "title": "Construct Gate Manifest Sha256",
      "type": "string"
    },
    "failed_constructs": {
      "items": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Failed Constructs",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "invalid_output_count": {
      "minimum": 0,
      "title": "Invalid Output Count",
      "type": "integer"
    },
    "passed_constructs": {
      "items": {
        "$ref": "#/$defs/ScoringConstruct"
      },
      "title": "Passed Constructs",
      "type": "array"
    },
    "report_sha256": {
      "title": "Report Sha256",
      "type": "string"
    },
    "sample_size": {
      "exclusiveMinimum": 0,
      "title": "Sample Size",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_sample_manifest_sha256": {
      "title": "Validation Sample Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "sample_size",
    "construct_diagnostics",
    "passed_constructs",
    "failed_constructs",
    "invalid_output_count",
    "construct_gate_manifest_sha256",
    "validation_sample_manifest_sha256",
    "generated_at",
    "report_sha256"
  ],
  "title": "ScoringValidationReport",
  "type": "object"
}
