{
  "$defs": {
    "CompleteRenderedRequestReview": {
      "additionalProperties": false,
      "description": "Store one holistic review of a complete scenario-specific rendered request.",
      "properties": {
        "assigned_phrase": {
          "minLength": 1,
          "title": "Assigned Phrase",
          "type": "string"
        },
        "cue_template_id": {
          "maximum": 4,
          "minimum": 1,
          "title": "Cue Template Id",
          "type": "integer"
        },
        "decision_preference_confounded": {
          "title": "Decision Preference Confounded",
          "type": "boolean"
        },
        "desired_detail_confounded": {
          "title": "Desired Detail Confounded",
          "type": "boolean"
        },
        "expressed_concern": {
          "$ref": "#/$defs/ExpressedConcernCondition"
        },
        "natural": {
          "title": "Natural",
          "type": "boolean"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "rendered_request_sha256": {
          "title": "Rendered Request Sha256",
          "type": "string"
        },
        "rendered_request_text": {
          "minLength": 1,
          "title": "Rendered Request Text",
          "type": "string"
        },
        "risk_appetite_confounded": {
          "title": "Risk Appetite Confounded",
          "type": "boolean"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_R[1-4]$",
          "title": "Scenario Id",
          "type": "string"
        },
        "semantically_equivalent": {
          "title": "Semantically Equivalent",
          "type": "boolean"
        },
        "urgency_confounded": {
          "title": "Urgency Confounded",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "expressed_concern",
        "cue_template_id",
        "assigned_phrase",
        "rendered_request_text",
        "rendered_request_sha256",
        "natural",
        "semantically_equivalent",
        "urgency_confounded",
        "desired_detail_confounded",
        "decision_preference_confounded",
        "risk_appetite_confounded",
        "notes"
      ],
      "title": "CompleteRenderedRequestReview",
      "type": "object"
    },
    "CueReviewDecision": {
      "description": "Identify the outcome of the researcher cue self-review.",
      "enum": [
        "approve",
        "revise"
      ],
      "title": "CueReviewDecision",
      "type": "string"
    },
    "ExpressedConcernCondition": {
      "description": "Identify whether the user expresses concern in the opening cue.",
      "enum": [
        "neutral",
        "concerned",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Freeze holistic researcher review of all 80 rendered evaluation requests.",
  "properties": {
    "accepted_scenario_manifest_sha256": {
      "title": "Accepted Scenario Manifest Sha256",
      "type": "string"
    },
    "cue_pairs": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Cue Pairs",
      "type": "object"
    },
    "decision": {
      "$ref": "#/$defs/CueReviewDecision"
    },
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "prompt_version": {
      "pattern": "^v[1-9][0-9]*$",
      "title": "Prompt Version",
      "type": "string"
    },
    "request_reviews": {
      "items": {
        "$ref": "#/$defs/CompleteRenderedRequestReview"
      },
      "maxItems": 80,
      "minItems": 80,
      "title": "Request Reviews",
      "type": "array"
    },
    "researcher_notes": {
      "minLength": 1,
      "title": "Researcher Notes",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewed_by": {
      "minLength": 1,
      "title": "Reviewed By",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "prompt_version",
    "accepted_scenario_manifest_sha256",
    "cue_pairs",
    "request_reviews",
    "researcher_notes",
    "decision",
    "reviewed_by",
    "reviewed_at",
    "manifest_sha256"
  ],
  "title": "PromptReviewManifest",
  "type": "object"
}
