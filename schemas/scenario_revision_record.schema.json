{
  "additionalProperties": false,
  "description": "Record one freely edited candidate version without imposing review gates.",
  "properties": {
    "candidate_sha256": {
      "title": "Candidate Sha256",
      "type": "string"
    },
    "changed_fields": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Changed Fields",
      "type": "array"
    },
    "edited_by": {
      "minLength": 1,
      "title": "Edited By",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 2000,
      "title": "Notes",
      "type": "string"
    },
    "parent_candidate_sha256": {
      "title": "Parent Candidate Sha256",
      "type": "string"
    },
    "record_sha256": {
      "title": "Record Sha256",
      "type": "string"
    },
    "revision_number": {
      "minimum": 1,
      "title": "Revision Number",
      "type": "integer"
    },
    "saved_at": {
      "format": "date-time",
      "title": "Saved At",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[12])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "revision_number",
    "parent_candidate_sha256",
    "candidate_sha256",
    "changed_fields",
    "edited_by",
    "saved_at",
    "record_sha256"
  ],
  "title": "ScenarioRevisionRecord",
  "type": "object"
}
