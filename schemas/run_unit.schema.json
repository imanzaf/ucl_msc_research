{
  "$defs": {
    "ExperimentCell": {
      "additionalProperties": false,
      "description": "Represent one immutable treatment cell and its deterministic identifier.",
      "properties": {
        "cell_id": {
          "pattern": "^(primary|material_priority|brevity_locus)__(ample|tight|none)__(neutral|concerned)$",
          "title": "Cell Id",
          "type": "string"
        },
        "expressed_concern": {
          "$ref": "#/$defs/ExpressedConcernCondition"
        },
        "integrity": {
          "$ref": "#/$defs/IntegrityCondition",
          "default": "absent"
        },
        "stage": {
          "$ref": "#/$defs/StudyStage",
          "default": "primary"
        },
        "word_budget": {
          "$ref": "#/$defs/WordBudgetCondition"
        }
      },
      "required": [
        "word_budget",
        "expressed_concern",
        "cell_id"
      ],
      "title": "ExperimentCell",
      "type": "object"
    },
    "ExpressedConcernCondition": {
      "description": "Identify whether the user expresses concern in the opening cue.",
      "enum": [
        "neutral",
        "concerned",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    },
    "IntegrityCondition": {
      "description": "Retain the legacy field boundary without an active integrity treatment.",
      "enum": [
        "absent",
        "targeted"
      ],
      "title": "IntegrityCondition",
      "type": "string"
    },
    "MessageRole": {
      "description": "Identify a persisted transcript message role.",
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "PromptMessage": {
      "additionalProperties": false,
      "description": "Store one exact message in a provider request.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "PromptMessage",
      "type": "object"
    },
    "SourceOrderVariant": {
      "description": "Identify the frozen canonical source order.",
      "enum": [
        "A",
        "B"
      ],
      "title": "SourceOrderVariant",
      "type": "string"
    },
    "StudyStage": {
      "description": "Identify primary and separately reported exploratory studies.",
      "enum": [
        "primary",
        "material_priority",
        "brevity_locus"
      ],
      "title": "StudyStage",
      "type": "string"
    },
    "WordBudgetCondition": {
      "description": "Identify the assigned response-length condition.",
      "enum": [
        "ample",
        "tight",
        "none"
      ],
      "title": "WordBudgetCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Represent one randomised immutable scenario–model–order–cell assignment.",
  "properties": {
    "assigned_word_limit": {
      "anyOf": [
        {
          "maximum": 240,
          "minimum": 80,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned Word Limit"
    },
    "block_id": {
      "pattern": "^BLOCK_[A-F0-9]{16}$",
      "title": "Block Id",
      "type": "string"
    },
    "block_randomisation_seed": {
      "title": "Block Randomisation Seed",
      "type": "integer"
    },
    "cell": {
      "$ref": "#/$defs/ExperimentCell"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_model_version": {
      "minLength": 1,
      "title": "Expected Model Version",
      "type": "string"
    },
    "follow_up_message": {
      "$ref": "#/$defs/PromptMessage"
    },
    "follow_up_sha256": {
      "title": "Follow Up Sha256",
      "type": "string"
    },
    "global_randomisation_seed": {
      "title": "Global Randomisation Seed",
      "type": "integer"
    },
    "initial_request_messages": {
      "items": {
        "$ref": "#/$defs/PromptMessage"
      },
      "minItems": 2,
      "title": "Initial Request Messages",
      "type": "array"
    },
    "initial_request_sha256": {
      "title": "Initial Request Sha256",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_snapshot_sha256": {
      "title": "Model Snapshot Sha256",
      "type": "string"
    },
    "randomised_position": {
      "maximum": 3,
      "minimum": 0,
      "title": "Randomised Position",
      "type": "integer"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^CF\\d{3}_(C1|R[1-4])$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_order": {
      "$ref": "#/$defs/SourceOrderVariant"
    },
    "source_packet_sha256": {
      "title": "Source Packet Sha256",
      "type": "string"
    },
    "use_case_id": {
      "pattern": "^CF\\d{3}$",
      "title": "Use Case Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "block_id",
    "scenario_id",
    "use_case_id",
    "model_id",
    "expected_model_version",
    "model_snapshot_sha256",
    "source_order",
    "cell",
    "global_randomisation_seed",
    "block_randomisation_seed",
    "randomised_position",
    "source_packet_sha256",
    "initial_request_messages",
    "initial_request_sha256",
    "follow_up_message",
    "follow_up_sha256",
    "created_at"
  ],
  "title": "RunUnit",
  "type": "object"
}
