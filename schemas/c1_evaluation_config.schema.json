{
  "$defs": {
    "C1EvaluationPurpose": {
      "description": "Identify the non-canonical purpose of a single-model C1 run.",
      "enum": [
        "diagnostic"
      ],
      "title": "C1EvaluationPurpose",
      "type": "string"
    },
    "EvaluatedModelSnapshot": {
      "additionalProperties": false,
      "description": "Freeze one evaluated model and its provider-returned identity.",
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "metadata_sha256": {
          "title": "Metadata Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "weight_type": {
          "$ref": "#/$defs/ModelWeightType"
        }
      },
      "required": [
        "name",
        "model_id",
        "returned_model_version",
        "family",
        "provider",
        "weight_type",
        "metadata_sha256",
        "frozen_at"
      ],
      "title": "EvaluatedModelSnapshot",
      "type": "object"
    },
    "ModelWeightType": {
      "description": "Identify open- versus closed-weight evaluated model families.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "ModelWeightType",
      "type": "string"
    },
    "ProviderRouting": {
      "additionalProperties": false,
      "description": "Freeze an ordered OpenRouter provider allowlist for evaluated-model calls.",
      "properties": {
        "allow_fallbacks": {
          "default": false,
          "title": "Allow Fallbacks",
          "type": "boolean"
        },
        "only": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Only",
          "type": "array"
        }
      },
      "required": [
        "only"
      ],
      "title": "ProviderRouting",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Freeze retry count and backoff while prohibiting prompt mutation.",
      "properties": {
        "backoff_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Backoff Seconds",
          "type": "array"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "reuse_identical_prompt_bytes": {
          "default": true,
          "title": "Reuse Identical Prompt Bytes",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_seconds"
      ],
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Snapshot a resumable one-model C1 2×2 diagnostic and its scoring contract.",
  "properties": {
    "accepted_scenario_manifest_sha256": {
      "title": "Accepted Scenario Manifest Sha256",
      "type": "string"
    },
    "cell_count": {
      "default": 4,
      "maximum": 4,
      "minimum": 4,
      "title": "Cell Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluated_model": {
      "$ref": "#/$defs/EvaluatedModelSnapshot"
    },
    "evaluated_model_count": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Evaluated Model Count",
      "type": "integer"
    },
    "expected_agent_response_count": {
      "default": 80,
      "maximum": 80,
      "minimum": 80,
      "title": "Expected Agent Response Count",
      "type": "integer"
    },
    "expected_conversation_count": {
      "default": 40,
      "maximum": 40,
      "minimum": 40,
      "title": "Expected Conversation Count",
      "type": "integer"
    },
    "experiment_name": {
      "pattern": "^c1_[a-z0-9_]+_v[1-9][0-9]*$",
      "title": "Experiment Name",
      "type": "string"
    },
    "log_filename": {
      "pattern": "^\\d{8}T\\d{6}_run\\.log$",
      "title": "Log Filename",
      "type": "string"
    },
    "prompt_package_sha256": {
      "title": "Prompt Package Sha256",
      "type": "string"
    },
    "provider_routing": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderRouting"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "purpose": {
      "$ref": "#/$defs/C1EvaluationPurpose",
      "default": "diagnostic"
    },
    "randomisation_seed": {
      "title": "Randomisation Seed",
      "type": "integer"
    },
    "results_filename": {
      "pattern": "^\\d{8}T\\d{6}_results\\.jsonl$",
      "title": "Results Filename",
      "type": "string"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "scenario_count": {
      "default": 10,
      "maximum": 10,
      "minimum": 10,
      "title": "Scenario Count",
      "type": "integer"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_execution_manifest_sha256": {
      "title": "Scoring Execution Manifest Sha256",
      "type": "string"
    },
    "temperature": {
      "default": 0.0,
      "maximum": 0.0,
      "minimum": 0.0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "experiment_name",
    "accepted_scenario_manifest_sha256",
    "evaluated_model",
    "prompt_package_sha256",
    "scoring_execution_manifest_sha256",
    "randomisation_seed",
    "retry_policy",
    "results_filename",
    "log_filename",
    "created_at"
  ],
  "title": "C1EvaluationConfig",
  "type": "object"
}
