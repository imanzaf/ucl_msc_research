{
  "additionalProperties": false,
  "description": "Bind bounded paid authorization to one scenario request batch and route.",
  "properties": {
    "approval_note": {
      "minLength": 2,
      "title": "Approval Note",
      "type": "string"
    },
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approved_by": {
      "minLength": 2,
      "title": "Approved By",
      "type": "string"
    },
    "approved_max_cost": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Approved Max Cost"
    },
    "currency": {
      "default": "USD",
      "pattern": "^USD$",
      "title": "Currency",
      "type": "string"
    },
    "estimated_max_cost": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Max Cost"
    },
    "generation_request_batch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation Request Batch Sha256",
      "type": "string"
    },
    "input_token_estimate": {
      "minimum": 1,
      "title": "Input Token Estimate",
      "type": "integer"
    },
    "model_slug": {
      "minLength": 3,
      "title": "Model Slug",
      "type": "string"
    },
    "output_token_ceiling": {
      "minimum": 1,
      "title": "Output Token Ceiling",
      "type": "integer"
    },
    "provider_name": {
      "minLength": 1,
      "title": "Provider Name",
      "type": "string"
    },
    "request_count": {
      "default": 30,
      "minimum": 1,
      "title": "Request Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generation_request_batch_sha256",
    "model_slug",
    "provider_name",
    "input_token_estimate",
    "output_token_ceiling",
    "estimated_max_cost",
    "approved_max_cost",
    "approved_by",
    "approved_at",
    "approval_note",
    "approval_sha256"
  ],
  "title": "ScenarioGenerationApproval",
  "type": "object"
}
