{
  "additionalProperties": false,
  "description": "Bind a scoring-only C1 version to immutable evaluated-model outputs.",
  "properties": {
    "manifest_sha256": {
      "title": "Manifest Sha256",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "prepared_by": {
      "minLength": 1,
      "title": "Prepared By",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_config_sha256": {
      "title": "Source Config Sha256",
      "type": "string"
    },
    "source_experiment_name": {
      "pattern": "^c1_llama_2x2_v[1-9][0-9]*$",
      "title": "Source Experiment Name",
      "type": "string"
    },
    "source_run_plan_sha256": {
      "title": "Source Run Plan Sha256",
      "type": "string"
    },
    "source_transcripts_sha256": {
      "title": "Source Transcripts Sha256",
      "type": "string"
    },
    "target_experiment_name": {
      "pattern": "^c1_llama_2x2_v[1-9][0-9]*$",
      "title": "Target Experiment Name",
      "type": "string"
    },
    "target_scoring_execution_manifest_sha256": {
      "title": "Target Scoring Execution Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_experiment_name",
    "target_experiment_name",
    "source_config_sha256",
    "source_run_plan_sha256",
    "source_transcripts_sha256",
    "target_scoring_execution_manifest_sha256",
    "prepared_by",
    "prepared_at",
    "manifest_sha256"
  ],
  "title": "C1ScoringRerunSourceManifest",
  "type": "object"
}
