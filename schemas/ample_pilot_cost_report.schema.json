{
  "additionalProperties": false,
  "description": "Bind the exact 60-response ample pilot to an offline cost estimate.",
  "properties": {
    "accepted_scenario_manifest_sha256": {
      "title": "Accepted Scenario Manifest Sha256",
      "type": "string"
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Cost Usd"
    },
    "estimated_input_tokens": {
      "minimum": 0,
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "estimated_output_tokens": {
      "minimum": 0,
      "title": "Estimated Output Tokens",
      "type": "integer"
    },
    "evaluated_model_manifest_sha256": {
      "title": "Evaluated Model Manifest Sha256",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "maximum_attempts_including_retries": {
      "exclusiveMinimum": 0,
      "title": "Maximum Attempts Including Retries",
      "type": "integer"
    },
    "pilot_responses": {
      "exclusiveMinimum": 0,
      "title": "Pilot Responses",
      "type": "integer"
    },
    "pricing_assumptions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Pricing Assumptions",
      "type": "object"
    },
    "pricing_file_sha256": {
      "title": "Pricing File Sha256",
      "type": "string"
    },
    "prompt_package_sha256": {
      "title": "Prompt Package Sha256",
      "type": "string"
    },
    "prompt_review_manifest_sha256": {
      "title": "Prompt Review Manifest Sha256",
      "type": "string"
    },
    "provider_request_sha256s": {
      "items": {
        "type": "string"
      },
      "maxItems": 60,
      "minItems": 60,
      "title": "Provider Request Sha256S",
      "type": "array"
    },
    "randomisation_seed": {
      "title": "Randomisation Seed",
      "type": "integer"
    },
    "report_sha256": {
      "title": "Report Sha256",
      "type": "string"
    },
    "retry_policy_sha256": {
      "title": "Retry Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "worst_case_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Worst Case Cost Usd"
    },
    "worst_case_input_tokens": {
      "minimum": 0,
      "title": "Worst Case Input Tokens",
      "type": "integer"
    },
    "worst_case_output_tokens": {
      "minimum": 0,
      "title": "Worst Case Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "accepted_scenario_manifest_sha256",
    "evaluated_model_manifest_sha256",
    "prompt_review_manifest_sha256",
    "prompt_package_sha256",
    "retry_policy_sha256",
    "pricing_file_sha256",
    "randomisation_seed",
    "provider_request_sha256s",
    "pilot_responses",
    "maximum_attempts_including_retries",
    "estimated_input_tokens",
    "estimated_output_tokens",
    "estimated_cost_usd",
    "worst_case_input_tokens",
    "worst_case_output_tokens",
    "worst_case_cost_usd",
    "pricing_assumptions",
    "generated_at",
    "report_sha256"
  ],
  "title": "AmplePilotCostReport",
  "type": "object"
}
