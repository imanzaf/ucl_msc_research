{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ExperimentCell": {
      "additionalProperties": false,
      "description": "Represent one immutable treatment cell and its deterministic identifier.",
      "properties": {
        "cell_id": {
          "pattern": "^(primary|material_priority|brevity_locus)__(ample|tight|none)__(neutral|concerned)$",
          "title": "Cell Id",
          "type": "string"
        },
        "expressed_concern": {
          "$ref": "#/$defs/ExpressedConcernCondition"
        },
        "stage": {
          "$ref": "#/$defs/StudyStage",
          "default": "primary"
        },
        "word_budget": {
          "$ref": "#/$defs/WordBudgetCondition"
        }
      },
      "required": [
        "word_budget",
        "expressed_concern",
        "cell_id"
      ],
      "title": "ExperimentCell",
      "type": "object"
    },
    "ExpressedConcernCondition": {
      "description": "Identify whether the user expresses concern in the opening cue.",
      "enum": [
        "neutral",
        "concerned"
      ],
      "title": "ExpressedConcernCondition",
      "type": "string"
    },
    "FailureReason": {
      "description": "Classify run failures without deleting their assigned unit.",
      "enum": [
        "provider_error",
        "timeout",
        "invalid_response",
        "retries_exhausted"
      ],
      "title": "FailureReason",
      "type": "string"
    },
    "MessageRole": {
      "description": "Identify a persisted transcript message role.",
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "PromptMessage": {
      "additionalProperties": false,
      "description": "Store one exact message in a provider request.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "PromptMessage",
      "type": "object"
    },
    "ProviderAttempt": {
      "additionalProperties": false,
      "description": "Record one provider attempt while proving prompt-byte immutability.",
      "properties": {
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "finish_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionFinishReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Text"
        },
        "returned_model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model Version"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "attempt_number",
        "request_sha256",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "ProviderAttempt",
      "type": "object"
    },
    "RunOutcomeStatus": {
      "description": "Identify the terminal state of one immutable run unit.",
      "enum": [
        "completed",
        "failed",
        "missing"
      ],
      "title": "RunOutcomeStatus",
      "type": "string"
    },
    "RunUnit": {
      "additionalProperties": false,
      "description": "Represent one randomised immutable scenario–model–cell assignment.",
      "properties": {
        "assigned_word_limit": {
          "anyOf": [
            {
              "maximum": 240,
              "minimum": 80,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Word Limit"
        },
        "block_id": {
          "pattern": "^BLOCK_[A-F0-9]{16}$",
          "title": "Block Id",
          "type": "string"
        },
        "block_randomisation_seed": {
          "title": "Block Randomisation Seed",
          "type": "integer"
        },
        "cell": {
          "$ref": "#/$defs/ExperimentCell"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expected_model_version": {
          "minLength": 1,
          "title": "Expected Model Version",
          "type": "string"
        },
        "follow_up_message": {
          "$ref": "#/$defs/PromptMessage"
        },
        "follow_up_sha256": {
          "title": "Follow Up Sha256",
          "type": "string"
        },
        "global_randomisation_seed": {
          "title": "Global Randomisation Seed",
          "type": "integer"
        },
        "initial_request_messages": {
          "items": {
            "$ref": "#/$defs/PromptMessage"
          },
          "minItems": 2,
          "title": "Initial Request Messages",
          "type": "array"
        },
        "initial_request_sha256": {
          "title": "Initial Request Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_snapshot_sha256": {
          "title": "Model Snapshot Sha256",
          "type": "string"
        },
        "randomised_position": {
          "maximum": 3,
          "minimum": 0,
          "title": "Randomised Position",
          "type": "integer"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^CF\\d{3}_(C1|R[12])$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "use_case_id": {
          "pattern": "^CF\\d{3}$",
          "title": "Use Case Id",
          "type": "string"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "block_id",
        "scenario_id",
        "use_case_id",
        "model_id",
        "expected_model_version",
        "model_snapshot_sha256",
        "cell",
        "global_randomisation_seed",
        "block_randomisation_seed",
        "randomised_position",
        "visible_facts_sha256",
        "initial_request_messages",
        "initial_request_sha256",
        "follow_up_message",
        "follow_up_sha256",
        "created_at"
      ],
      "title": "RunUnit",
      "type": "object"
    },
    "StudyStage": {
      "description": "Identify primary and separately reported exploratory studies.",
      "enum": [
        "primary",
        "material_priority",
        "brevity_locus"
      ],
      "title": "StudyStage",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "TranscriptTurn": {
      "additionalProperties": false,
      "description": "Store one exact ordered message in a completed conversation.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Turn Index",
          "type": "integer"
        },
        "word_count": {
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "role",
        "content",
        "content_sha256",
        "word_count"
      ],
      "title": "TranscriptTurn",
      "type": "object"
    },
    "WordBudgetCondition": {
      "description": "Identify the assigned response-length condition.",
      "enum": [
        "ample",
        "tight",
        "none"
      ],
      "title": "WordBudgetCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persist a terminal conversation result immediately after its run unit.",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "failure_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "follow_up_attempts": {
      "items": {
        "$ref": "#/$defs/ProviderAttempt"
      },
      "title": "Follow Up Attempts",
      "type": "array"
    },
    "initial_attempts": {
      "items": {
        "$ref": "#/$defs/ProviderAttempt"
      },
      "title": "Initial Attempts",
      "type": "array"
    },
    "outcome_status": {
      "$ref": "#/$defs/RunOutcomeStatus"
    },
    "run_unit": {
      "$ref": "#/$defs/RunUnit"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/TranscriptTurn"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run_unit",
    "outcome_status",
    "turns",
    "initial_attempts",
    "follow_up_attempts",
    "completed_at",
    "transcript_sha256"
  ],
  "title": "ConversationTranscript",
  "type": "object"
}
