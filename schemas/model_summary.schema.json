{
  "additionalProperties": false,
  "description": "Summarise completed, missing, and usage counts for one evaluated model.",
  "properties": {
    "completed_conversations": {
      "minimum": 0,
      "title": "Completed Conversations",
      "type": "integer"
    },
    "expected_conversations": {
      "exclusiveMinimum": 0,
      "title": "Expected Conversations",
      "type": "integer"
    },
    "failed_conversations": {
      "minimum": 0,
      "title": "Failed Conversations",
      "type": "integer"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "missing_conversations": {
      "minimum": 0,
      "title": "Missing Conversations",
      "type": "integer"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "returned_model_versions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Returned Model Versions",
      "type": "object"
    },
    "schema_version": {
      "pattern": "^2\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "summary_sha256": {
      "title": "Summary Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "expected_conversations",
    "completed_conversations",
    "failed_conversations",
    "missing_conversations",
    "input_tokens",
    "output_tokens",
    "returned_model_versions",
    "summary_sha256"
  ],
  "title": "ModelSummary",
  "type": "object"
}
