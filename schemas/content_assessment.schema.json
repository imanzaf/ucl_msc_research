{
  "$defs": {
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ContentBehaviour": {
      "description": "Identify the communicated content evidenced by one finding.",
      "enum": [
        "fact_communication",
        "specificity_marker_communication"
      ],
      "title": "ContentBehaviour",
      "type": "string"
    },
    "ContentEvidenceFinding": {
      "additionalProperties": false,
      "description": "Ground one communicated fact or marker in exact response text.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/ContentBehaviour"
        },
        "element_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "response_span": {
          "$ref": "#/$defs/ResponseSpan"
        }
      },
      "required": [
        "behaviour",
        "fact_id",
        "response_span",
        "reason"
      ],
      "title": "ContentEvidenceFinding",
      "type": "object"
    },
    "FactContentJudgment": {
      "additionalProperties": false,
      "description": "Store binary fact and marker communication decisions.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentEvidenceFinding"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "marker_judgments": {
          "items": {
            "$ref": "#/$defs/SpecificityMarkerJudgment"
          },
          "title": "Marker Judgments",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "present",
        "evidence",
        "marker_judgments",
        "reason"
      ],
      "title": "FactContentJudgment",
      "type": "object"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "SpecificityMarkerJudgment": {
      "additionalProperties": false,
      "description": "Make one binary decision for a predefined specificity marker.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentEvidenceFinding"
          },
          "title": "Evidence",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "present",
        "evidence",
        "reason"
      ],
      "title": "SpecificityMarkerJudgment",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store one response's binary fact and specificity decisions.",
  "properties": {
    "blind_conversation_id": {
      "minLength": 1,
      "title": "Blind Conversation Id",
      "type": "string"
    },
    "judge_model_id": {
      "minLength": 1,
      "title": "Judge Model Id",
      "type": "string"
    },
    "judgments": {
      "items": {
        "$ref": "#/$defs/FactContentJudgment"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Judgments",
      "type": "array"
    },
    "provider_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderCallProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scored_response": {
      "$ref": "#/$defs/ScoredResponse"
    },
    "scoring_prompt_sha256": {
      "title": "Scoring Prompt Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "blind_conversation_id",
    "scored_response",
    "judgments",
    "judge_model_id",
    "scoring_prompt_sha256",
    "scored_at"
  ],
  "title": "ContentAssessmentResult",
  "type": "object"
}
