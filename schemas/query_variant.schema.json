{
  "$defs": {
    "Affect": {
      "description": "Represent the allowed customer affect manipulation.",
      "enum": [
        "neutral",
        "anxious",
        "frustrated"
      ],
      "title": "Affect",
      "type": "string"
    },
    "QueryLength": {
      "description": "Represent semantically equivalent short and long query forms.",
      "enum": [
        "short",
        "long"
      ],
      "title": "QueryLength",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Store one controlled customer query and its manipulation coordinates.",
  "properties": {
    "affect": {
      "$ref": "#/$defs/Affect"
    },
    "query_length": {
      "$ref": "#/$defs/QueryLength"
    },
    "query_variant_id": {
      "title": "Query Variant Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "4.0.0",
      "pattern": "^4\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "query_variant_id",
    "scenario_id",
    "affect",
    "query_length",
    "text"
  ],
  "title": "QueryVariant",
  "type": "object"
}
