{
  "$defs": {
    "AccuracyAssessmentResult": {
      "additionalProperties": false,
      "description": "Store one response's visible-facts-only false-claim result.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "false_claim_present": {
          "title": "False Claim Present",
          "type": "boolean"
        },
        "false_claims": {
          "items": {
            "$ref": "#/$defs/FalseClaim"
          },
          "title": "False Claims",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCallProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "false_claim_present",
        "false_claims",
        "visible_facts_sha256",
        "judge_model_id",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "AccuracyAssessmentResult",
      "type": "object"
    },
    "BlindFactReference": {
      "additionalProperties": false,
      "description": "Provide a scoring judge one visible fact and its predefined markers.",
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "fact_text": {
          "minLength": 1,
          "title": "Fact Text",
          "type": "string"
        },
        "specificity_markers": {
          "items": {
            "$ref": "#/$defs/BlindSpecificityMarker"
          },
          "title": "Specificity Markers",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_text",
        "specificity_markers"
      ],
      "title": "BlindFactReference",
      "type": "object"
    },
    "BlindSpecificityMarker": {
      "additionalProperties": false,
      "description": "Provide one predefined marker to a content-scoring judge.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "marker_text": {
          "minLength": 1,
          "title": "Marker Text",
          "type": "string"
        }
      },
      "required": [
        "element_id",
        "marker_text"
      ],
      "title": "BlindSpecificityMarker",
      "type": "object"
    },
    "CompletionFinishReason": {
      "description": "Normalise provider completion termination without discarding unknown values.",
      "enum": [
        "stop",
        "length",
        "content_filter",
        "tool_calls",
        "unknown"
      ],
      "title": "CompletionFinishReason",
      "type": "string"
    },
    "ConditionBlindScoringInput": {
      "additionalProperties": false,
      "description": "Expose visible facts and exactly one anonymised assistant response.",
      "properties": {
        "agent_turn": {
          "$ref": "#/$defs/ScoringTranscriptTurn"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/BlindFactReference"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Facts",
          "type": "array"
        },
        "randomised_fact_order_seed": {
          "title": "Randomised Fact Order Seed",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "visible_facts_sha256": {
          "title": "Visible Facts Sha256",
          "type": "string"
        },
        "visible_facts_text": {
          "minLength": 1,
          "title": "Visible Facts Text",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "visible_facts_text",
        "visible_facts_sha256",
        "facts",
        "agent_turn",
        "randomised_fact_order_seed"
      ],
      "title": "ConditionBlindScoringInput",
      "type": "object"
    },
    "FactContentAssessmentResult": {
      "additionalProperties": false,
      "description": "Store one fact-level content assessment for one response.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "judgment": {
          "$ref": "#/$defs/FactContentJudgment"
        },
        "provider_call": {
          "$ref": "#/$defs/ProviderCallProvenance"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "fact_id",
        "judgment",
        "judge_model_id",
        "provider_call",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "FactContentAssessmentResult",
      "type": "object"
    },
    "FactContentJudgment": {
      "additionalProperties": false,
      "description": "Store binary fact and marker communication decisions.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ResponseSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "marker_judgments": {
          "items": {
            "$ref": "#/$defs/MarkerPresence"
          },
          "title": "Marker Judgments",
          "type": "array"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "present",
        "evidence",
        "marker_judgments",
        "reasoning"
      ],
      "title": "FactContentJudgment",
      "type": "object"
    },
    "FactPresentationAssessmentResult": {
      "additionalProperties": false,
      "description": "Store zero or more presentation shifts for one fact in one response.",
      "properties": {
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PresentationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "judge_model_id": {
          "minLength": 1,
          "title": "Judge Model Id",
          "type": "string"
        },
        "provider_call": {
          "$ref": "#/$defs/ProviderCallProvenance"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_prompt_sha256": {
          "title": "Scoring Prompt Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "blind_conversation_id",
        "scored_response",
        "fact_id",
        "findings",
        "judge_model_id",
        "provider_call",
        "scoring_prompt_sha256",
        "scored_at"
      ],
      "title": "FactPresentationAssessmentResult",
      "type": "object"
    },
    "FalseClaim": {
      "additionalProperties": false,
      "description": "Store one materially false factual claim from the response.",
      "properties": {
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "reasoning"
      ],
      "title": "FalseClaim",
      "type": "object"
    },
    "FramingDirection": {
      "description": "Identify whether presentation weakens or strengthens a fact.",
      "enum": [
        "weakening",
        "strengthening"
      ],
      "title": "FramingDirection",
      "type": "string"
    },
    "MarkerPresence": {
      "additionalProperties": false,
      "description": "Record whether one supplied specificity marker is present.",
      "properties": {
        "element_id": {
          "pattern": "^[A-Z0-9_]+$",
          "title": "Element Id",
          "type": "string"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        }
      },
      "required": [
        "element_id",
        "present"
      ],
      "title": "MarkerPresence",
      "type": "object"
    },
    "PresentationBehaviour": {
      "description": "Identify the fact attribute shifted by presentation language.",
      "enum": [
        "certainty_shift",
        "magnitude_shift",
        "condition_shift",
        "consequence_shift",
        "qualification_shift"
      ],
      "title": "PresentationBehaviour",
      "type": "string"
    },
    "PresentationFinding": {
      "additionalProperties": false,
      "description": "Attach the requested fact identifier to one presentation shift.",
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/PresentationBehaviour"
        },
        "direction": {
          "$ref": "#/$defs/FramingDirection"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "behaviour",
        "direction",
        "evidence",
        "reasoning",
        "fact_id"
      ],
      "title": "PresentationFinding",
      "type": "object"
    },
    "ProviderCallProvenance": {
      "additionalProperties": false,
      "description": "Bind a structured model artifact to its exact provider request and returned snapshot.",
      "properties": {
        "finish_reason": {
          "$ref": "#/$defs/CompletionFinishReason"
        },
        "provider_request_id": {
          "minLength": 1,
          "title": "Provider Request Id",
          "type": "string"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_model_id": {
          "minLength": 1,
          "title": "Requested Model Id",
          "type": "string"
        },
        "response_repaired": {
          "default": false,
          "title": "Response Repaired",
          "type": "boolean"
        },
        "response_sha256": {
          "title": "Response Sha256",
          "type": "string"
        },
        "returned_model_version": {
          "minLength": 1,
          "title": "Returned Model Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "requested_model_id",
        "returned_model_version",
        "provider_request_id",
        "finish_reason",
        "usage",
        "request_sha256",
        "response_sha256"
      ],
      "title": "ProviderCallProvenance",
      "type": "object"
    },
    "ResponseSpan": {
      "additionalProperties": false,
      "description": "Locate an exact quote in one evaluated agent turn.",
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "maximum": 3,
          "minimum": 1,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "start_char",
        "end_char",
        "exact_quote"
      ],
      "title": "ResponseSpan",
      "type": "object"
    },
    "ScoredResponse": {
      "description": "Identify the independently judged assistant response.",
      "enum": [
        "initial",
        "follow_up"
      ],
      "title": "ScoredResponse",
      "type": "string"
    },
    "ScoringAttemptStatus": {
      "description": "Identify whether one identical scoring-package attempt succeeded or failed.",
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "ScoringAttemptStatus",
      "type": "string"
    },
    "ScoringCallArtifact": {
      "additionalProperties": false,
      "description": "Persist one successful response-contract-fact call for resumable scoring.",
      "properties": {
        "accuracy_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccuracyAssessmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/ScoringExecutionAttempt"
          },
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "content_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactContentAssessmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contract": {
          "$ref": "#/$defs/ScoringContract"
        },
        "fact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Id"
        },
        "presentation_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactPresentationAssessmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_execution_manifest_sha256": {
          "title": "Scoring Execution Manifest Sha256",
          "type": "string"
        },
        "scoring_input_sha256": {
          "title": "Scoring Input Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_unit_id",
        "blind_conversation_id",
        "scored_response",
        "contract",
        "scoring_input_sha256",
        "scoring_execution_manifest_sha256",
        "attempts",
        "completed_at",
        "artifact_sha256"
      ],
      "title": "ScoringCallArtifact",
      "type": "object"
    },
    "ScoringContract": {
      "description": "Identify one independent scoring contract.",
      "enum": [
        "content",
        "presentation",
        "accuracy"
      ],
      "title": "ScoringContract",
      "type": "string"
    },
    "ScoringExecutionAttempt": {
      "additionalProperties": false,
      "description": "Record one independently retryable scoring-contract call.",
      "properties": {
        "attempt_id": {
          "pattern": "^SCOREATTEMPT_[A-F0-9]{16}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "blind_conversation_id": {
          "minLength": 1,
          "title": "Blind Conversation Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/ScoringContract"
        },
        "error_message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "fact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Id"
        },
        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "run_unit_id": {
          "pattern": "^RUN_[A-F0-9]{16}$",
          "title": "Run Unit Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^3\\.0\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "scored_response": {
          "$ref": "#/$defs/ScoredResponse"
        },
        "scoring_output_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring Output Sha256"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScoringAttemptStatus"
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "run_unit_id",
        "blind_conversation_id",
        "scored_response",
        "contract",
        "attempt_number",
        "request_sha256",
        "status",
        "started_at",
        "completed_at"
      ],
      "title": "ScoringExecutionAttempt",
      "type": "object"
    },
    "ScoringTranscriptTurn": {
      "additionalProperties": false,
      "description": "Provide one agent response to a condition-blind scorer.",
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "turn_index": {
          "enum": [
            1,
            3
          ],
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "turn_index",
        "content"
      ],
      "title": "ScoringTranscriptTurn",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Store provider-reported token usage and billed cost for one response.",
      "properties": {
        "cost_credits": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Credits"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "upstream_inference_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Inference Cost"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persist a terminal scoring failure for blinded manual resolution.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/ScoringExecutionAttempt"
      },
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "completed_calls": {
      "items": {
        "$ref": "#/$defs/ScoringCallArtifact"
      },
      "title": "Completed Calls",
      "type": "array"
    },
    "queued_at": {
      "format": "date-time",
      "title": "Queued At",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "record_sha256": {
      "title": "Record Sha256",
      "type": "string"
    },
    "run_unit_id": {
      "pattern": "^RUN_[A-F0-9]{16}$",
      "title": "Run Unit Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^3\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_contract_sha256": {
      "title": "Scoring Contract Sha256",
      "type": "string"
    },
    "scoring_execution_manifest_sha256": {
      "title": "Scoring Execution Manifest Sha256",
      "type": "string"
    },
    "scoring_inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/ConditionBlindScoringInput"
      },
      "propertyNames": {
        "$ref": "#/$defs/ScoredResponse"
      },
      "title": "Scoring Inputs",
      "type": "object"
    },
    "transcript_sha256": {
      "title": "Transcript Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_unit_id",
    "transcript_sha256",
    "scoring_execution_manifest_sha256",
    "scoring_contract_sha256",
    "scoring_inputs",
